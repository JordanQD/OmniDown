<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OmniDown.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="OmniDown">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        Loaded="RootGrid_Loaded"
        RowDefinitions="Auto,*">
        <TitleBar
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="48"
            MinHeight="48"
            VerticalAlignment="Stretch"
            FontSize="13"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="AppTitleBar_PaneToggleRequested"
            Title="OmniDown">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/OmniDown.ico" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <AutoSuggestBox
                    x:Name="TitleSearchBox"
                    Width="320"
                    VerticalAlignment="Center"
                    KeyUp="TitleSearchBox_KeyUp"
                    PlaceholderText="Search downloads and settings..."
                    QueryIcon="Find"
                    QuerySubmitted="TitleSearchBox_QuerySubmitted"
                    TextChanged="TitleSearchBox_TextChanged"
                    x:Uid="TitleSearchBox" />
            </TitleBar.Content>
        </TitleBar>

        <NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            SelectionChanged="RootNavigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="TasksNavItem"
                    Content="Home"
                    IsSelected="True"
                    x:Uid="TasksNavItem"
                    Tag="Home">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="Transfers"
                    x:Uid="ActiveNavItem"
                    Tag="Downloading">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Play" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="Complete"
                    x:Uid="CompletedNavItem"
                    Tag="Completed">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Accept" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="Issues"
                    x:Uid="IssuesNavItem"
                    Tag="Issues">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Important" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    Content="Settings"
                    x:Uid="SettingsNavItem"
                    Tag="Settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid RowDefinitions="*,Auto">
                <Grid Padding="28,20,28,24">
                    <Grid
                        x:Name="TasksPage"
                        RowDefinitions="Auto,Auto,Auto,*">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="4">
                            <TextBlock
                                x:Name="DownloadsTitleText"
                                FontSize="28"
                                FontWeight="SemiBold"
                                x:Uid="DownloadsTitleText"
                                Text="Downloads" />
                            <TextBlock
                                x:Name="DownloadsSubtitleText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="DownloadsSubtitleText"
                                Text="Local aria2 sidecar control with JSON-RPC task sync." />
                        </StackPanel>

                        <CommandBar
                            Grid.Column="1"
                            DefaultLabelPosition="Right"
                            IsOpen="False">
                            <AppBarButton
                                Click="NewDownloadButton_Click"
                                Icon="Add"
                                x:Uid="NewDownloadButton"
                                Label="New" />
                            <AppBarSeparator />
                            <AppBarElementContainer VerticalAlignment="Center">
                                <DropDownButton
                                    x:Name="SortTasksButton"
                                    MinWidth="74"
                                    Height="40"
                                    Padding="12,0"
                                    VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0">
                                    <DropDownButton.Content>
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                            <FontIcon
                                                FontSize="16"
                                                Glyph="&#xE8CB;" />
                                            <TextBlock
                                                x:Uid="SortTasksButtonLabel"
                                                Text="Sort" />
                                        </StackPanel>
                                    </DropDownButton.Content>
                                    <DropDownButton.Flyout>
                                        <MenuFlyout
                                            Opening="SortMenuFlyout_Opening"
                                            Placement="BottomEdgeAlignedLeft">
                                            <ToggleMenuFlyoutItem
                                                x:Name="SortByCreatedAtMenuItem"
                                                Click="SortColumnMenuItem_Click"
                                                x:Uid="SortByCreatedAtMenuItem"
                                                Tag="CreatedAt"
                                                Text="Added time" />
                                            <ToggleMenuFlyoutItem
                                                x:Name="SortByNameMenuItem"
                                                Click="SortColumnMenuItem_Click"
                                                x:Uid="SortByNameMenuItem"
                                                Tag="Name"
                                                Text="Name" />
                                            <ToggleMenuFlyoutItem
                                                x:Name="SortBySizeMenuItem"
                                                Click="SortColumnMenuItem_Click"
                                                x:Uid="SortBySizeMenuItem"
                                                Tag="Size"
                                                Text="Size" />
                                            <MenuFlyoutSeparator />
                                            <ToggleMenuFlyoutItem
                                                x:Name="SortAscendingMenuItem"
                                                Click="SortDirectionMenuItem_Click"
                                                x:Uid="SortAscendingMenuItem"
                                                Tag="Ascending"
                                                Text="Ascending" />
                                            <ToggleMenuFlyoutItem
                                                x:Name="SortDescendingMenuItem"
                                                Click="SortDirectionMenuItem_Click"
                                                x:Uid="SortDescendingMenuItem"
                                                Tag="Descending"
                                                Text="Descending" />
                                        </MenuFlyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                            </AppBarElementContainer>
                            <AppBarSeparator />
                            <AppBarButton
                                x:Name="ResumeTasksButton"
                                Click="ResumeTasksButton_Click"
                                Icon="Play"
                                IsEnabled="False"
                                x:Uid="ResumeTasksButton"
                                Label="Resume" />
                            <AppBarButton
                                x:Name="PauseTasksButton"
                                Click="PauseTasksButton_Click"
                                Icon="Pause"
                                IsEnabled="False"
                                x:Uid="PauseTasksButton"
                                Label="Pause" />
                            <AppBarButton
                                x:Name="RecoverTasksButton"
                                Click="RecoverTasksButton_Click"
                                Icon="Refresh"
                                IsEnabled="False"
                                x:Uid="RecoverTasksButton"
                                Label="Recover" />
                            <AppBarButton
                                x:Name="DeleteTasksButton"
                                Click="DeleteTasksButton_Click"
                                Icon="Delete"
                                IsEnabled="False"
                                x:Uid="DeleteTasksButton"
                                Label="Delete" />
                            <AppBarButton
                                x:Name="ClearCompletedTasksButton"
                                Click="ClearCompletedTasksButton_Click"
                                Icon="Clear"
                                x:Uid="ClearCompletedTasksButton"
                                Label="Clear completed records" />
                        </CommandBar>
                    </Grid>

                    <Grid
                        x:Name="StatsPanel"
                        Grid.Row="1"
                        Margin="0,20,0,14"
                        ColumnDefinitions="*,*,*,*,Auto">
                        <StackPanel Spacing="4">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="TotalMetricLabel"
                                Text="Total" />
                            <TextBlock
                                x:Name="TotalTasksText"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Text="0" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            Spacing="4">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="ActiveMetricLabel"
                                Text="Downloading" />
                            <TextBlock
                                x:Name="ActiveTasksText"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Text="0" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="2"
                            Spacing="4">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="DownloadSpeedMetricLabel"
                                Text="Completed" />
                            <TextBlock
                                x:Name="CompletedTasksText"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Text="0" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="3"
                            Spacing="4">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="Aria2MetricLabel"
                                Text="Issues" />
                            <TextBlock
                                x:Name="IssueTasksText"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Text="0" />
                        </StackPanel>
                        <DropDownButton
                            x:Name="SpeedLimitButton"
                            Grid.Column="4"
                            MinWidth="292"
                            Margin="-14,0,0,0"
                            Padding="14,0,14,6"
                            HorizontalAlignment="Right"
                            HorizontalContentAlignment="Left"
                            VerticalAlignment="Top"
                            AutomationProperties.Name="Realtime speed and speed limit"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            x:Uid="SpeedLimitButton">
                            <DropDownButton.Content>
                                <Grid
                                    Width="264"
                                    RowDefinitions="Auto,Auto,16"
                                    RowSpacing="4">
                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        x:Uid="RealtimeSpeedLabel"
                                        Text="Realtime speed" />
                                    <StackPanel
                                        Grid.Row="1"
                                        HorizontalAlignment="Left"
                                        Orientation="Horizontal"
                                        Spacing="18">
                                        <Grid
                                            ColumnDefinitions="22,96">
                                            <Grid
                                                Width="22"
                                                HorizontalAlignment="Center">
                                                <FontIcon
                                                    HorizontalAlignment="Center"
                                                    FontSize="16"
                                                    Glyph="&#xE898;" />
                                            </Grid>
                                            <TextBlock
                                                x:Name="GlobalUploadSpeedText"
                                                Grid.Column="1"
                                                Width="96"
                                                FontSize="18"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis"
                                                Text="0 B/s" />
                                        </Grid>
                                        <Grid
                                            ColumnDefinitions="22,96">
                                            <Grid
                                                Width="22"
                                                HorizontalAlignment="Center">
                                                <FontIcon
                                                    HorizontalAlignment="Center"
                                                    FontSize="16"
                                                    Glyph="&#xE896;" />
                                            </Grid>
                                            <TextBlock
                                                x:Name="GlobalDownloadSpeedText"
                                                Grid.Column="1"
                                                Width="96"
                                                FontSize="18"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis"
                                                Text="0 B/s" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Row="2"
                                        HorizontalAlignment="Left"
                                        Orientation="Horizontal"
                                        Spacing="18">
                                        <Grid
                                            ColumnDefinitions="22,96">
                                            <Grid
                                                x:Name="GlobalUploadLimitIconPanel"
                                                Width="22"
                                                HorizontalAlignment="Center"
                                                Opacity="0">
                                                <Grid
                                                    Width="22"
                                                    HorizontalAlignment="Center">
                                                    <FontIcon
                                                        HorizontalAlignment="Center"
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Glyph="&#xE72E;" />
                                                </Grid>
                                            </Grid>
                                            <TextBlock
                                                x:Name="GlobalUploadLimitText"
                                                Grid.Column="1"
                                                Width="96"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Opacity="0"
                                                Text="0 B/s"
                                                TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                        <Grid
                                            ColumnDefinitions="22,96">
                                            <Grid
                                                x:Name="GlobalDownloadLimitIconPanel"
                                                Width="22"
                                                HorizontalAlignment="Center"
                                                Opacity="0">
                                                <Grid
                                                    Width="22"
                                                    HorizontalAlignment="Center">
                                                    <FontIcon
                                                        HorizontalAlignment="Center"
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Glyph="&#xE72E;" />
                                                </Grid>
                                            </Grid>
                                            <TextBlock
                                                x:Name="GlobalDownloadLimitText"
                                                Grid.Column="1"
                                                Width="96"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Opacity="0"
                                                Text="0 B/s"
                                                TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </DropDownButton.Content>
                            <DropDownButton.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <StackPanel
                                        Width="260"
                                        Spacing="12">
                                        <StackPanel Spacing="8">
                                            <Grid
                                                Width="260"
                                                ColumnDefinitions="*,92"
                                                ColumnSpacing="8">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    x:Uid="UploadLimitLabel"
                                                    Text="Upload limit" />
                                                <ToggleSwitch
                                                    x:Name="UploadLimitToggleSwitch"
                                                    Grid.Column="1"
                                                    Width="48"
                                                    MinWidth="0"
                                                    Padding="0"
                                                    HorizontalAlignment="Right"
                                                    OffContent=""
                                                    OnContent=""
                                                    Toggled="UploadLimitToggleSwitch_Toggled" />
                                            </Grid>
                                            <Grid ColumnDefinitions="*,92" ColumnSpacing="8">
                                                <NumberBox
                                                    x:Name="UploadLimitNumberBox"
                                                    IsEnabled="False"
                                                    Minimum="1"
                                                    SmallChange="128"
                                                    LargeChange="1024"
                                                    SpinButtonPlacementMode="Compact"
                                                    Value="1024" />
                                                <ComboBox
                                                    x:Name="UploadLimitUnitComboBox"
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Right"
                                                    IsEnabled="False"
                                                    SelectedIndex="0">
                                                    <ComboBoxItem Content="KB/s" />
                                                    <ComboBoxItem Content="MB/s" />
                                                </ComboBox>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Spacing="8">
                                            <Grid
                                                Width="260"
                                                ColumnDefinitions="*,92"
                                                ColumnSpacing="8">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    x:Uid="DownloadLimitLabel"
                                                    Text="Download limit" />
                                                <ToggleSwitch
                                                    x:Name="DownloadLimitToggleSwitch"
                                                    Grid.Column="1"
                                                    Width="48"
                                                    MinWidth="0"
                                                    Padding="0"
                                                    HorizontalAlignment="Right"
                                                    OffContent=""
                                                    OnContent=""
                                                    Toggled="DownloadLimitToggleSwitch_Toggled" />
                                            </Grid>
                                            <Grid ColumnDefinitions="*,92" ColumnSpacing="8">
                                                <NumberBox
                                                    x:Name="DownloadLimitNumberBox"
                                                    IsEnabled="False"
                                                    Minimum="1"
                                                    SmallChange="128"
                                                    LargeChange="1024"
                                                    SpinButtonPlacementMode="Compact"
                                                    Value="1024" />
                                                <ComboBox
                                                    x:Name="DownloadLimitUnitComboBox"
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Right"
                                                    IsEnabled="False"
                                                    SelectedIndex="0">
                                                    <ComboBoxItem Content="KB/s" />
                                                    <ComboBoxItem Content="MB/s" />
                                                </ComboBox>
                                            </Grid>
                                        </StackPanel>
                                        <Button
                                            HorizontalAlignment="Right"
                                            Click="ApplySpeedLimitButton_Click"
                                            Content="Apply"
                                            x:Uid="ApplySpeedLimitButton" />
                                    </StackPanel>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </Grid>

                    <Border
                        Grid.Row="2"
                        Margin="0,0,0,4"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        CornerRadius="4">
                        <Grid
                            MinHeight="38"
                            Padding="0,0,20,0"
                            ColumnDefinitions="48,*,120,80,110,220,224"
                            ColumnSpacing="16">
                            <CheckBox
                                x:Name="SelectAllTasksCheckBox"
                                Width="20"
                                Height="20"
                                MinWidth="0"
                                Padding="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Checked="SelectAllTasksCheckBox_Checked"
                                Indeterminate="SelectAllTasksCheckBox_Indeterminate"
                                IsThreeState="True"
                                Unchecked="SelectAllTasksCheckBox_Unchecked" />
                            <TextBlock
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="NameColumnHeader"
                                Text="Name" />
                            <TextBlock
                                Grid.Column="2"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="StatusColumnHeader"
                                Text="Status" />
                            <TextBlock
                                Grid.Column="3"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="ProgressColumnHeader"
                                Text="Progress" />
                            <TextBlock
                                Grid.Column="4"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="RemainingTimeColumnHeader"
                                Text="Remaining" />
                            <TextBlock
                                Grid.Column="5"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="SpeedColumnHeader"
                                Text="Speed" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="3">
                        <ListView
                            x:Name="TasksListView"
                            IsMultiSelectCheckBoxEnabled="False"
                            SelectionChanged="TasksListView_SelectionChanged"
                            SelectionMode="Multiple">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="MinHeight" Value="52" />
                                    <Setter Property="Margin" Value="0,0,0,4" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection />
                            </ListView.ItemContainerTransitions>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <UserControl Loaded="TaskItem_Loaded">
                                    <Grid
                                        MinHeight="52"
                                        RowDefinitions="*,3">
                                        <Grid
                                            Padding="0,0,20,0"
                                            ColumnDefinitions="48,*,120,80,110,220,224"
                                            ColumnSpacing="16">
                                            <Grid
                                                Width="40"
                                                Height="40"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                PointerCanceled="TaskIconSelectionBox_PointerExited"
                                                PointerEntered="TaskIconSelectionBox_PointerEntered"
                                                PointerExited="TaskIconSelectionBox_PointerExited">
                                                <FontIcon
                                                    x:Name="TaskIcon"
                                                    Width="18"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="16"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Glyph="&#xE7C3;" />
                                                <CheckBox
                                                    x:Name="SelectionCheckbox"
                                                    Width="20"
                                                    Height="20"
                                                    MinWidth="0"
                                                    Padding="0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Checked="TaskCheckBox_Changed"
                                                    Content=""
                                                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                    Opacity="0"
                                                    Unchecked="TaskCheckBox_Changed" />
                                            </Grid>
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Foreground="{Binding NameBrush}"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Foreground="{Binding StatusBrush}"
                                                Text="{Binding StatusText}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="3"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding ProgressText}"
                                                TextAlignment="Left" />
                                            <TextBlock
                                                Grid.Column="4"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding RemainingTimeText}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="5"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding DownloadSpeedText}"
                                                TextTrimming="CharacterEllipsis"
                                                Visibility="{Binding NormalSpeedVisibility}" />
                                            <StackPanel
                                                Grid.Column="5"
                                                VerticalAlignment="Center"
                                                Spacing="2"
                                                Visibility="{Binding PeerSpeedVisibility}">
                                                <StackPanel
                                                    Orientation="Horizontal"
                                                    Spacing="6">
                                                    <FontIcon
                                                        Width="14"
                                                        FontSize="12"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Glyph="&#xE898;" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{Binding UploadSpeedText}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel
                                                    Orientation="Horizontal"
                                                    Spacing="6">
                                                    <FontIcon
                                                        Width="14"
                                                        FontSize="12"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Glyph="&#xE896;" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{Binding DownloadSpeedText}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="6"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                Spacing="6">
                                                <Button
                                                    Width="34"
                                                    Height="34"
                                                    MinWidth="0"
                                                    Padding="0"
                                                    Click="TaskTogglePauseResumeButton_Click"
                                                    ToolTipService.ToolTip="{Binding ToggleActionText}">
                                                    <FontIcon
                                                        FontSize="15"
                                                        Glyph="{Binding ToggleActionGlyph}" />
                                                </Button>
                                                <Button
                                                    Width="34"
                                                    Height="34"
                                                    MinWidth="0"
                                                    Padding="0"
                                                    Click="TaskOpenFileButton_Click"
                                                    ToolTipService.ToolTip="{Binding OpenFileActionText}">
                                                    <FontIcon
                                                        FontSize="15"
                                                        Glyph="&#xE8A7;" />
                                                </Button>
                                                <Button
                                                    Width="34"
                                                    Height="34"
                                                    MinWidth="0"
                                                    Padding="0"
                                                    Click="TaskOpenFolderButton_Click"
                                                    ToolTipService.ToolTip="{Binding OpenFolderActionText}">
                                                    <FontIcon
                                                        FontSize="15"
                                                        Glyph="&#xE8B7;" />
                                                </Button>
                                                <Button
                                                    Width="34"
                                                    Height="34"
                                                    MinWidth="0"
                                                    Padding="0"
                                                    Click="TaskCopyLinkButton_Click"
                                                    ToolTipService.ToolTip="{Binding CopyLinkActionText}">
                                                    <FontIcon
                                                        FontSize="15"
                                                        Glyph="&#xE71B;" />
                                                </Button>
                                                <Button
                                                    Width="34"
                                                    Height="34"
                                                    MinWidth="0"
                                                    Padding="0"
                                                    Click="TaskDeleteEntryButton_Click"
                                                    ToolTipService.ToolTip="{Binding DeleteEntryActionText}">
                                                    <FontIcon
                                                        FontSize="15"
                                                        Glyph="&#xE711;" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <ProgressBar
                                            Grid.Row="1"
                                            Height="3"
                                            Margin="0"
                                            VerticalAlignment="Bottom"
                                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                                            Foreground="{Binding ProgressBrush}"
                                            Maximum="100"
                                            Value="{Binding Progress}" />

                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CheckboxVisibilityStates">
                                                <VisualState x:Name="HideCheckbox" />
                                                <VisualState x:Name="ShowCheckbox">
                                                    <VisualState.Setters>
                                                        <Setter Target="SelectionCheckbox.Opacity" Value="1" />
                                                        <Setter Target="TaskIcon.Opacity" Value="0" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                    </Grid>
                                    </UserControl>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Grid
                            x:Name="TasksLoadingPanel"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            Visibility="Visible">
                            <ProgressRing
                                x:Name="TasksLoadingRing"
                                Width="36"
                                Height="36"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Loading downloads"
                                IsActive="True"
                                x:Uid="TasksLoadingRing" />
                        </Grid>
                    </Grid>
                </Grid>

                    <Grid
                        x:Name="SettingsPage"
                        Visibility="Collapsed"
                        RowDefinitions="Auto,*"
                        RowSpacing="20">
                        <StackPanel Spacing="4">
                            <TextBlock
                                FontSize="28"
                                FontWeight="SemiBold"
                                x:Uid="SettingsTitleText"
                                Text="Settings" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="SettingsSubtitleText"
                                Text="Manage the local aria2 process and default download behavior." />
                        </StackPanel>

                        <Grid
                            Grid.Row="1"
                            ColumnDefinitions="220,*"
                            ColumnSpacing="24">
                            <ListView
                                x:Name="SettingsSectionListView"
                                Padding="0"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                SelectionChanged="SettingsSectionListView_SelectionChanged"
                                SelectionMode="Single">
                                <ListViewItem Tag="General">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <SymbolIcon Symbol="Setting" />
                                        <TextBlock Text="通用" />
                                    </StackPanel>
                                </ListViewItem>
                                <ListViewItem Tag="Download">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <SymbolIcon Symbol="Download" />
                                        <TextBlock Text="下载" />
                                    </StackPanel>
                                </ListViewItem>
                                <ListViewItem Tag="BitTorrent">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <FontIcon Glyph="&#xE968;" />
                                        <TextBlock Text="BitTorrent" />
                                    </StackPanel>
                                </ListViewItem>
                                <ListViewItem Tag="Network">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <FontIcon Glyph="&#xE774;" />
                                        <TextBlock Text="网络" />
                                    </StackPanel>
                                </ListViewItem>
                                <ListViewItem Tag="Advanced">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <FontIcon Glyph="&#xE713;" />
                                        <TextBlock Text="高级" />
                                    </StackPanel>
                                </ListViewItem>
                            </ListView>

                            <ScrollViewer
                                Grid.Column="1"
                                Padding="0,0,8,0"
                                HorizontalContentAlignment="Center"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <Grid
                                    Width="820"
                                    HorizontalAlignment="Center">
                                    <StackPanel
                                        x:Name="GeneralSettingsContent"
                                        Spacing="0">
                                        <TextBlock
                                            Margin="4,0,4,8"
                                            FontWeight="SemiBold"
                                            Text="应用" />
                                        <Border
                                            x:Name="StartupSettingCard"
                                            Padding="16"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                            <Grid ColumnDefinitions="Auto,*,220" ColumnSpacing="14">
                                                <FontIcon
                                                    Width="24"
                                                    VerticalAlignment="Center"
                                                    Glyph="&#xE768;" />
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Spacing="3">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Text="启动 OmniDown 时准备下载引擎" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="打开应用后自动启动本地 aria2，恢复上一次的下载会话。"
                                                        TextWrapping="WrapWholeWords" />
                                                </StackPanel>
                                                <StackPanel
                                                    Grid.Column="2"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="8">
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        Text="开" />
                                                    <ToggleSwitch
                                                        Width="48"
                                                        MinWidth="0"
                                                        Padding="0"
                                                        OffContent=""
                                                        OnContent=""
                                                        IsOn="True"
                                                        Toggled="SettingToggleSwitch_Toggled" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border
                                            x:Name="ThemeSettingCard"
                                            Margin="0,-1,0,0"
                                            Padding="16"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="0,0,8,8">
                                            <Grid ColumnDefinitions="Auto,*,220" ColumnSpacing="14">
                                                <FontIcon
                                                    Width="24"
                                                    VerticalAlignment="Center"
                                                    Glyph="&#xE771;" />
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Spacing="3">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Text="外观主题" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="跟随 Windows 主题，也可以在以后扩展为浅色或深色固定模式。"
                                                        TextWrapping="WrapWholeWords" />
                                                </StackPanel>
                                                <ComboBox
                                                    Grid.Column="2"
                                                    Width="160"
                                                    HorizontalAlignment="Right"
                                                    SelectedIndex="0">
                                                    <ComboBoxItem Content="跟随系统" />
                                                    <ComboBoxItem Content="浅色" />
                                                    <ComboBoxItem Content="深色" />
                                                </ComboBox>
                                            </Grid>
                                        </Border>

                                        <TextBlock
                                            Margin="4,32,4,8"
                                            FontWeight="SemiBold"
                                            Text="通知" />
                                        <Border
                                            x:Name="NotificationsSettingCard"
                                            Padding="16"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                            <Grid ColumnDefinitions="Auto,*,220" ColumnSpacing="14">
                                                <FontIcon
                                                    Width="24"
                                                    VerticalAlignment="Center"
                                                    Glyph="&#xE7F4;" />
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Spacing="3">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Text="下载事件通知" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="任务添加、完成和失败时显示系统通知。"
                                                        TextWrapping="WrapWholeWords" />
                                                </StackPanel>
                                                <StackPanel
                                                    Grid.Column="2"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="8">
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        Text="开" />
                                                    <ToggleSwitch
                                                        Width="48"
                                                        MinWidth="0"
                                                        Padding="0"
                                                        OffContent=""
                                                        OnContent=""
                                                        IsOn="True"
                                                        Toggled="SettingToggleSwitch_Toggled" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel
                                        x:Name="DownloadSettingsContent"
                                        Spacing="0"
                                        Visibility="Collapsed">
                                        <TextBlock
                                            Margin="4,0,4,8"
                                            FontWeight="SemiBold"
                                            Text="下载位置" />
                                        <Border
                                            x:Name="DefaultDirectorySettingCard"
                                            Padding="16"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8,8,0,0">
                                            <Grid ColumnDefinitions="Auto,*,220" ColumnSpacing="14">
                                                <FontIcon
                                                    Width="24"
                                                    VerticalAlignment="Center"
                                                    Glyph="&#xE8B7;" />
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Spacing="3">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        x:Uid="DefaultDirectoryLabel"
                                                        Text="Default directory" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="新建任务默认保存到这个文件夹。"
                                                        TextWrapping="WrapWholeWords" />
                                                </StackPanel>
                                                <TextBox
                                                    x:Name="DownloadDirectoryTextBox"
                                                    Grid.Column="2"
                                                    Width="220"
                                                    HorizontalAlignment="Right" />
                                            </Grid>
                                        </Border>

                                        <Border
                                            x:Name="SplitCountSettingCard"
                                            Margin="0,-1,0,0"
                                            Padding="16"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="0,0,8,8">
                                            <Grid ColumnDefinitions="Auto,*,220" ColumnSpacing="14">
                                                <FontIcon
                                                    Width="24"
                                                    VerticalAlignment="Center"
                                                    Glyph="&#xE8FD;" />
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Spacing="3">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Text="默认连接数" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="添加普通链接时使用的建议分片数量。"
                                                        TextWrapping="WrapWholeWords" />
                                                </StackPanel>
                                                <NumberBox
                                                    Grid.Column="2"
                                                    Width="120"
                                                    HorizontalAlignment="Right"
                                                    Minimum="1"
                                                    Maximum="128"
                                                    SmallChange="1"
                                                    SpinButtonPlacementMode="Compact"
                                                    Value="16" />
                                            </Grid>
                                        </Border>

                                        <TextBlock
                                            Margin="4,32,4,8"
                                            FontWeight="SemiBold"
                                            Text="速度限制" />
                                        <Border
                                            x:Name="SpeedLimitSettingCard"
                                            Padding="16"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                            <Grid ColumnDefinitions="Auto,*,220" ColumnSpacing="14">
                                                <FontIcon
                                                    Width="24"
                                                    VerticalAlignment="Center"
                                                    Glyph="&#xE9D9;" />
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Spacing="3">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Text="全局速度限制" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="当前可在主界面实时调整，这里保留为默认策略入口。"
                                                        TextWrapping="WrapWholeWords" />
                                                </StackPanel>
                                                <Button
                                                    Grid.Column="2"
                                                    HorizontalAlignment="Right"
                                                    Content="管理" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel
                                        x:Name="BitTorrentSettingsContent"
                                        Spacing="0"
                                        Visibility="Collapsed">
                                        <TextBlock
                                            Margin="4,0,4,8"
                                            FontWeight="SemiBold"
                                            Text="BitTorrent" />
                                        <Border
                                            x:Name="BtEnableSettingCard"
                                            Padding="16"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8,8,0,0">
                                            <Grid ColumnDefinitions="Auto,*,220" ColumnSpacing="14">
                                                <FontIcon
                                                    Width="24"
                                                    VerticalAlignment="Center"
                                                    Glyph="&#xE968;" />
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Spacing="3">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Text="启用种子和磁力链接" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="允许 aria2 处理 .torrent 文件和 magnet 链接。"
                                                        TextWrapping="WrapWholeWords" />
                                                </StackPanel>
                                                <StackPanel
                                                    Grid.Column="2"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="8">
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        Text="开" />
                                                    <ToggleSwitch
                                                        Width="48"
                                                        MinWidth="0"
                                                        Padding="0"
                                                        OffContent=""
                                                        OnContent=""
                                                        IsOn="True"
                                                        Toggled="SettingToggleSwitch_Toggled" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border
                                            x:Name="BtPortSettingCard"
                                            Margin="0,-1,0,0"
                                            Padding="16"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                            <Grid ColumnDefinitions="Auto,*,220" ColumnSpacing="14">
                                                <FontIcon
                                                    Width="24"
                                                    VerticalAlignment="Center"
                                                    Glyph="&#xE839;" />
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Spacing="3">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Text="监听端口" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="用于 BT 传入连接的端口范围。"
                                                        TextWrapping="WrapWholeWords" />
                                                </StackPanel>
                                                <TextBox
                                                    Grid.Column="2"
                                                    Width="160"
                                                    HorizontalAlignment="Right"
                                                    Text="6881-6999" />
                                            </Grid>
                                        </Border>

                                        <Border
                                            x:Name="BtSeedRatioSettingCard"
                                            Margin="0,-1,0,0"
                                            Padding="16"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="0,0,8,8">
                                            <Grid ColumnDefinitions="Auto,*,220" ColumnSpacing="14">
                                                <FontIcon
                                                    Width="24"
                                                    VerticalAlignment="Center"
                                                    Glyph="&#xE9F5;" />
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Spacing="3">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Text="做种分享率" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="任务完成后达到该分享率时自动停止做种。"
                                                        TextWrapping="WrapWholeWords" />
                                                </StackPanel>
                                                <NumberBox
                                                    Grid.Column="2"
                                                    Width="120"
                                                    HorizontalAlignment="Right"
                                                    Minimum="0"
                                                    Maximum="10"
                                                    SmallChange="0.1"
                                                    Value="1.0" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel
                                        x:Name="NetworkSettingsContent"
                                        Spacing="0"
                                        Visibility="Collapsed">
                                        <TextBlock
                                            Margin="4,0,4,8"
                                            FontWeight="SemiBold"
                                            Text="代理" />
                                        <Border
                                            x:Name="UseSystemProxySettingCard"
                                            Padding="16"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8,8,0,0">
                                            <Grid ColumnDefinitions="Auto,*,220" ColumnSpacing="14">
                                                <FontIcon
                                                    Width="24"
                                                    VerticalAlignment="Center"
                                                    Glyph="&#xE774;" />
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Spacing="3">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        x:Uid="ProxyLabel"
                                                        Text="Proxy" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="启动 aria2 时读取 Windows 当前系统代理。"
                                                        TextWrapping="WrapWholeWords" />
                                                </StackPanel>
                                                <StackPanel
                                                    Grid.Column="2"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="8">
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        Text="开" />
                                                    <ToggleSwitch
                                                        x:Name="UseSystemProxyCheckBox"
                                                        Width="48"
                                                        MinWidth="0"
                                                        Padding="0"
                                                        OffContent=""
                                                        OnContent=""
                                                        IsOn="True"
                                                        Toggled="SettingToggleSwitch_Toggled" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border
                                            x:Name="CustomProxySettingCard"
                                            Margin="0,-1,0,0"
                                            Padding="16"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="0,0,8,8">
                                            <Grid ColumnDefinitions="Auto,*,220" ColumnSpacing="14">
                                                <FontIcon
                                                    Width="24"
                                                    VerticalAlignment="Center"
                                                    Glyph="&#xE8A7;" />
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Spacing="3">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Text="自定义代理地址" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="预留给 HTTP、HTTPS、SOCKS 代理的独立配置。"
                                                        TextWrapping="WrapWholeWords" />
                                                </StackPanel>
                                                <TextBox
                                                    Grid.Column="2"
                                                    Width="220"
                                                    HorizontalAlignment="Right"
                                                    PlaceholderText="http://127.0.0.1:7890" />
                                            </Grid>
                                        </Border>

                                        <TextBlock
                                            Margin="4,32,4,8"
                                            FontWeight="SemiBold"
                                            Text="连接" />
                                        <Border
                                            x:Name="RetrySettingCard"
                                            Padding="16"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                            <Grid ColumnDefinitions="Auto,*,220" ColumnSpacing="14">
                                                <FontIcon
                                                    Width="24"
                                                    VerticalAlignment="Center"
                                                    Glyph="&#xE8BB;" />
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Spacing="3">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Text="网络错误重试" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="临时网络失败时让下载任务自动重试。"
                                                        TextWrapping="WrapWholeWords" />
                                                </StackPanel>
                                                <StackPanel
                                                    Grid.Column="2"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="8">
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        Text="开" />
                                                    <ToggleSwitch
                                                        Width="48"
                                                        MinWidth="0"
                                                        Padding="0"
                                                        OffContent=""
                                                        OnContent=""
                                                        IsOn="True"
                                                        Toggled="SettingToggleSwitch_Toggled" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel
                                        x:Name="AdvancedSettingsContent"
                                        Spacing="0"
                                        Visibility="Collapsed">
                                        <TextBlock
                                            Margin="4,0,4,8"
                                            FontWeight="SemiBold"
                                            Text="aria2 引擎" />
                                        <Border
                                            x:Name="AriaPathSettingCard"
                                            Padding="16"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8,8,0,0">
                                            <Grid ColumnDefinitions="Auto,*,220" ColumnSpacing="14">
                                                <FontIcon
                                                    Width="24"
                                                    VerticalAlignment="Center"
                                                    Glyph="&#xE756;" />
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Spacing="3">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        x:Uid="AriaPathLabel"
                                                        Text="aria2c path" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="留空时从应用内置引擎或 PATH 解析 aria2c.exe。"
                                                        TextWrapping="WrapWholeWords" />
                                                </StackPanel>
                                                <TextBox
                                                    x:Name="AriaPathTextBox"
                                                    Grid.Column="2"
                                                    Width="220"
                                                    HorizontalAlignment="Right"
                                                    x:Uid="AriaPathTextBox"
                                                    PlaceholderText="Leave empty to resolve aria2c.exe from PATH" />
                                            </Grid>
                                        </Border>

                                        <Border
                                            x:Name="RpcPortSettingCard"
                                            Margin="0,-1,0,0"
                                            Padding="16"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                            <Grid ColumnDefinitions="Auto,*,220" ColumnSpacing="14">
                                                <FontIcon
                                                    Width="24"
                                                    VerticalAlignment="Center"
                                                    Glyph="&#xE8A7;" />
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Spacing="3">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        x:Uid="RpcPortLabel"
                                                        Text="RPC port" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="OmniDown 与本地 aria2 通讯使用的 JSON-RPC 端口。"
                                                        TextWrapping="WrapWholeWords" />
                                                </StackPanel>
                                                <NumberBox
                                                    x:Name="RpcPortNumberBox"
                                                    Grid.Column="2"
                                                    Width="120"
                                                    HorizontalAlignment="Right"
                                                    Minimum="1"
                                                    Maximum="65535"
                                                    Value="6800" />
                                            </Grid>
                                        </Border>

                                        <Border
                                            x:Name="ProcessStatusSettingCard"
                                            Margin="0,-1,0,0"
                                            Padding="16"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="0,0,8,8">
                                            <Grid ColumnDefinitions="Auto,*,220" ColumnSpacing="14">
                                                <FontIcon
                                                    Width="24"
                                                    VerticalAlignment="Center"
                                                    Glyph="&#xE7C1;" />
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Spacing="3">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        x:Uid="ProcessStatusLabel"
                                                        Text="Process status" />
                                                    <TextBlock
                                                        x:Name="SettingsAriaStatusText"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        x:Uid="SettingsAriaStatusText"
                                                        Text="Stopped" />
                                                </StackPanel>
                                                <StackPanel
                                                    x:Name="ProcessStatusSettingControl"
                                                    Grid.Column="2"
                                                    HorizontalAlignment="Right"
                                                    Orientation="Horizontal"
                                                    Spacing="8">
                                                    <Button
                                                        Click="StartAriaButton_Click"
                                                        x:Uid="SettingsStartButton"
                                                        Content="Start" />
                                                    <Button
                                                        Click="StopAriaButton_Click"
                                                        x:Uid="SettingsStopButton"
                                                        Content="Stop" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <TextBlock
                                            Margin="4,32,4,8"
                                            FontWeight="SemiBold"
                                            Text="开发者选项" />
                                        <Border
                                            x:Name="TerminalSettingCard"
                                            Padding="16"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                            <Grid ColumnDefinitions="Auto,*,220" ColumnSpacing="14">
                                                <FontIcon
                                                    Width="24"
                                                    VerticalAlignment="Center"
                                                    Glyph="&#xE756;" />
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Spacing="3">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Text="显示 aria2 终端输出" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="用于排查引擎启动、RPC 和下载异常。"
                                                        TextWrapping="WrapWholeWords" />
                                                </StackPanel>
                                                <StackPanel
                                                    Grid.Column="2"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="8">
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        Text="关" />
                                                    <ToggleSwitch
                                                        Width="48"
                                                        MinWidth="0"
                                                        Padding="0"
                                                        OffContent=""
                                                        OnContent=""
                                                        Toggled="SettingToggleSwitch_Toggled" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>

                <Grid
                    Grid.Row="1"
                    RowDefinitions="*,Auto">
                    <Border
                        Grid.Row="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0">
                        <Grid RowDefinitions="Auto,Auto">
                            <Grid
                            Padding="12,6"
                            ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                            ColumnSpacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="12" Glyph="&#xE756;" />
                                <TextBlock
                                    x:Name="DebugEngineText"
                                    VerticalAlignment="Center"
                                    x:Uid="DebugEngineText"
                                    Text="aria2 stopped" />
                            </StackPanel>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="TerminalSummaryText"
                                Text="aria2 terminal output"
                                TextTrimming="CharacterEllipsis" />
                            <Button
                                x:Name="ClearTerminalButton"
                                Grid.Column="2"
                                Click="ClearTerminalButton_Click"
                                Padding="10,4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="14" Glyph="&#xE75C;" />
                                    <TextBlock
                                        x:Uid="ClearTerminalButtonLabel"
                                        Text="Clear" />
                                </StackPanel>
                            </Button>
                            <ToggleButton
                                x:Name="TerminalToggleButton"
                                Grid.Column="3"
                                Checked="TerminalToggleButton_Changed"
                                Padding="10,4"
                                Unchecked="TerminalToggleButton_Changed">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="14" Glyph="&#xE756;" />
                                    <TextBlock
                                        x:Uid="TerminalToggleButtonLabel"
                                        Text="Terminal" />
                                </StackPanel>
                            </ToggleButton>
                            <Button
                                x:Name="NotificationHistoryButton"
                                Grid.Column="4"
                                Padding="10,4"
                                HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="14" Glyph="&#xE7F4;" />
                                    <TextBlock
                                        x:Uid="NotificationHistoryButtonLabel"
                                        Text="Notifications" />
                                </StackPanel>
                                <Button.Flyout>
                                    <Flyout Placement="TopEdgeAlignedRight">
                                        <Grid
                                            Width="380"
                                            MaxHeight="420"
                                            RowDefinitions="Auto,*"
                                            RowSpacing="8">
                                            <TextBlock
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                x:Uid="NotificationHistoryTitleText"
                                                Text="Notifications" />
                                            <ListView
                                                x:Name="NotificationHistoryListView"
                                                Grid.Row="1"
                                                MaxHeight="380"
                                                SelectionMode="None">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid
                                                            Padding="0,8"
                                                            ColumnDefinitions="Auto,*"
                                                            ColumnSpacing="10">
                                                            <FontIcon
                                                                Width="20"
                                                                VerticalAlignment="Top"
                                                                FontSize="15"
                                                                Foreground="{Binding SeverityBrush}"
                                                                Glyph="{Binding SeverityGlyph}" />
                                                            <StackPanel
                                                                Grid.Column="1"
                                                                Spacing="2">
                                                                <TextBlock
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{Binding SeverityBrush}"
                                                                    Text="{Binding SeverityText}" />
                                                                <TextBlock
                                                                    Text="{Binding Message}"
                                                                    TextWrapping="WrapWholeWords" />
                                                                <TextBlock
                                                                    FontSize="12"
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Text="{Binding DetailText}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                        </Grid>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            </Grid>

                        <Border
                            x:Name="TerminalPanel"
                            Grid.Row="1"
                            Height="180"
                            Padding="12"
                            Background="#FF1E1E1E"
                            Visibility="Collapsed">
                            <ScrollViewer
                                x:Name="TerminalScrollViewer"
                                HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Auto">
                                <TextBlock
                                    x:Name="TerminalTextBlock"
                                    FontFamily="Cascadia Mono, Consolas"
                                    FontSize="12"
                                    Foreground="#FFD4D4D4"
                                    x:Uid="TerminalTextBlock"
                                    Text="aria2 terminal output will appear here."
                                    TextWrapping="NoWrap" />
                            </ScrollViewer>
                        </Border>
                        </Grid>
                    </Border>

                    <Border
                        x:Name="StatusToastPanel"
                        Width="360"
                        MinHeight="72"
                        Margin="0,0,16,54"
                        Padding="14,12"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="Collapsed">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <FontIcon
                                x:Name="StatusToastGlyph"
                                Width="22"
                                VerticalAlignment="Top"
                                FontSize="18"
                                Glyph="&#xE946;" />
                            <TextBlock
                                x:Name="StatusToastMessageText"
                                Grid.Column="1"
                                TextWrapping="WrapWholeWords" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
