<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OmniDown.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="OmniDown">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid RowDefinitions="Auto,*">
        <InfoBar
            x:Name="StatusInfoBar"
            Grid.Row="0"
            Margin="12,12,12,0"
            IsClosable="True"
            IsOpen="False" />

        <NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            PaneTitle="OmniDown"
            SelectionChanged="RootNavigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="TasksNavItem"
                    Content="Tasks"
                    IsSelected="True"
                    Tag="Tasks">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Download" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="Active"
                    Tag="Active">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Play" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="Completed"
                    Tag="Completed">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Accept" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    Content="Settings"
                    Tag="Settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid Padding="28,20,28,24">
                <Grid
                    x:Name="TasksPage"
                    RowDefinitions="Auto,Auto,*">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="4">
                            <TextBlock
                                FontSize="28"
                                FontWeight="SemiBold"
                                Text="Downloads" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Phase 1 workspace: new downloads, task list, settings, and local aria2 process control." />
                        </StackPanel>

                        <CommandBar
                            Grid.Column="1"
                            DefaultLabelPosition="Right"
                            IsOpen="False">
                            <AppBarButton
                                Click="NewDownloadButton_Click"
                                Icon="Add"
                                Label="New" />
                            <AppBarSeparator />
                            <AppBarButton
                                Click="StartAriaButton_Click"
                                Icon="Play"
                                Label="Start aria2" />
                            <AppBarButton
                                Click="StopAriaButton_Click"
                                Icon="Stop"
                                Label="Stop" />
                        </CommandBar>
                    </Grid>

                    <Grid
                        Grid.Row="1"
                        Margin="0,20,0,14"
                        ColumnDefinitions="*,*,*,*">
                        <StackPanel Spacing="4">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Total" />
                            <TextBlock
                                x:Name="TotalTasksText"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Text="0" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            Spacing="4">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Active" />
                            <TextBlock
                                x:Name="ActiveTasksText"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Text="0" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="2"
                            Spacing="4">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Download speed" />
                            <TextBlock
                                x:Name="DownloadSpeedText"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Text="0 KB/s" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="3"
                            Spacing="4">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="aria2" />
                            <TextBlock
                                x:Name="AriaStatusText"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Text="Stopped" />
                        </StackPanel>
                    </Grid>

                    <ListView
                        x:Name="TasksListView"
                        Grid.Row="2"
                        SelectionMode="Single">
                        <ListView.Header>
                            <Grid
                                Padding="12,0,12,8"
                                ColumnDefinitions="2*,Auto,*,*">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Name" />
                                <TextBlock
                                    Grid.Column="1"
                                    Width="96"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Status" />
                                <TextBlock
                                    Grid.Column="2"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Progress" />
                                <TextBlock
                                    Grid.Column="3"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Directory" />
                            </Grid>
                        </ListView.Header>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid
                                    Padding="12"
                                    ColumnDefinitions="2*,Auto,*,*"
                                    ColumnSpacing="16">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{Binding Name}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding SourceUri}" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="1"
                                        Width="96"
                                        VerticalAlignment="Center"
                                        Text="{Binding Status}" />
                                    <ProgressBar
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Maximum="100"
                                        Value="{Binding Progress}" />
                                    <TextBlock
                                        Grid.Column="3"
                                        VerticalAlignment="Center"
                                        Text="{Binding SaveDirectory}"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Grid
                    x:Name="SettingsPage"
                    Visibility="Collapsed"
                    RowDefinitions="Auto,Auto,*"
                    RowSpacing="20">
                    <StackPanel Spacing="4">
                        <TextBlock
                            FontSize="28"
                            FontWeight="SemiBold"
                            Text="Settings" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Manage the local aria2 process and default download behavior." />
                    </StackPanel>

                    <Grid
                        Grid.Row="1"
                        ColumnDefinitions="220,*"
                        RowDefinitions="Auto,Auto,Auto,Auto"
                        ColumnSpacing="20"
                        RowSpacing="14">
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="aria2c path" />
                        <TextBox
                            x:Name="AriaPathTextBox"
                            Grid.Column="1"
                            PlaceholderText="Leave empty to resolve aria2c.exe from PATH" />

                        <TextBlock
                            Grid.Row="1"
                            VerticalAlignment="Center"
                            Text="RPC port" />
                        <NumberBox
                            x:Name="RpcPortNumberBox"
                            Grid.Row="1"
                            Grid.Column="1"
                            Minimum="1"
                            Maximum="65535"
                            Value="6800" />

                        <TextBlock
                            Grid.Row="2"
                            VerticalAlignment="Center"
                            Text="Default directory" />
                        <TextBox
                            x:Name="DownloadDirectoryTextBox"
                            Grid.Row="2"
                            Grid.Column="1" />

                        <TextBlock
                            Grid.Row="3"
                            VerticalAlignment="Center"
                            Text="Process status" />
                        <StackPanel
                            Grid.Row="3"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="12">
                            <TextBlock
                                x:Name="SettingsAriaStatusText"
                                VerticalAlignment="Center"
                                Text="Stopped" />
                            <Button
                                Click="StartAriaButton_Click"
                                Content="Start" />
                            <Button
                                Click="StopAriaButton_Click"
                                Content="Stop" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
