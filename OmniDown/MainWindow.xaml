<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OmniDown.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="OmniDown">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid RowDefinitions="Auto,*,Auto">
        <InfoBar
            x:Name="StatusInfoBar"
            Grid.Row="0"
            Margin="12,12,12,0"
            IsClosable="True"
            IsOpen="False" />

        <NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            PaneTitle="OmniDown"
            SelectionChanged="RootNavigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="TasksNavItem"
                    Content="Tasks"
                    IsSelected="True"
                    x:Uid="TasksNavItem"
                    Tag="Tasks">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Download" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="Active"
                    x:Uid="ActiveNavItem"
                    Tag="Active">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Play" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="Completed"
                    x:Uid="CompletedNavItem"
                    Tag="Completed">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Accept" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    Content="Settings"
                    x:Uid="SettingsNavItem"
                    Tag="Settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid Padding="28,20,28,24">
                <Grid
                    x:Name="TasksPage"
                    RowDefinitions="Auto,Auto,*">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="4">
                            <TextBlock
                                FontSize="28"
                                FontWeight="SemiBold"
                                x:Uid="DownloadsTitleText"
                                Text="Downloads" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="DownloadsSubtitleText"
                                Text="Local aria2 sidecar control with JSON-RPC task sync." />
                        </StackPanel>

                        <CommandBar
                            Grid.Column="1"
                            DefaultLabelPosition="Right"
                            IsOpen="False">
                            <AppBarButton
                                Click="NewDownloadButton_Click"
                                Icon="Add"
                                x:Uid="NewDownloadButton"
                                Label="New" />
                            <AppBarSeparator />
                            <AppBarButton
                                x:Name="ResumeTasksButton"
                                Click="ResumeTasksButton_Click"
                                Icon="Play"
                                IsEnabled="False"
                                x:Uid="ResumeTasksButton"
                                Label="Resume" />
                            <AppBarButton
                                x:Name="PauseTasksButton"
                                Click="PauseTasksButton_Click"
                                Icon="Pause"
                                IsEnabled="False"
                                x:Uid="PauseTasksButton"
                                Label="Pause" />
                            <AppBarButton
                                x:Name="DeleteTasksButton"
                                Click="DeleteTasksButton_Click"
                                Icon="Delete"
                                IsEnabled="False"
                                x:Uid="DeleteTasksButton"
                                Label="Delete" />
                            <AppBarSeparator />
                            <AppBarButton
                                Click="StartAriaButton_Click"
                                Icon="Play"
                                x:Uid="StartAriaButton"
                                Label="Start aria2" />
                            <AppBarButton
                                Click="StopAriaButton_Click"
                                Icon="Stop"
                                x:Uid="StopAriaButton"
                                Label="Stop" />
                        </CommandBar>
                    </Grid>

                    <Grid
                        Grid.Row="1"
                        Margin="0,20,0,14"
                        ColumnDefinitions="*,*,*,*">
                        <StackPanel Spacing="4">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="TotalMetricLabel"
                                Text="Total" />
                            <TextBlock
                                x:Name="TotalTasksText"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Text="0" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            Spacing="4">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="ActiveMetricLabel"
                                Text="Active" />
                            <TextBlock
                                x:Name="ActiveTasksText"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Text="0" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="2"
                            Spacing="4">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="DownloadSpeedMetricLabel"
                                Text="Download speed" />
                            <TextBlock
                                x:Name="DownloadSpeedText"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Text="0 KB/s" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="3"
                            Spacing="4">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="Aria2MetricLabel"
                                Text="aria2" />
                            <TextBlock
                                x:Name="AriaStatusText"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Text="Stopped" />
                        </StackPanel>
                    </Grid>

                    <ListView
                        x:Name="TasksListView"
                        Grid.Row="2"
                        IsMultiSelectCheckBoxEnabled="True"
                        SelectionChanged="TasksListView_SelectionChanged"
                        SelectionMode="Multiple">
                        <ListView.Header>
                            <Grid
                                Padding="12,0,12,8"
                                ColumnDefinitions="2*,Auto,*,*">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    x:Uid="NameColumnHeader"
                                    Text="Name" />
                                <TextBlock
                                    Grid.Column="1"
                                    Width="96"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    x:Uid="StatusColumnHeader"
                                    Text="Status" />
                                <TextBlock
                                    Grid.Column="2"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    x:Uid="ProgressColumnHeader"
                                    Text="Progress" />
                                <TextBlock
                                    Grid.Column="3"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    x:Uid="DirectoryColumnHeader"
                                    Text="Directory" />
                            </Grid>
                        </ListView.Header>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid
                                    Padding="12"
                                    ColumnDefinitions="2*,Auto,*,*"
                                    ColumnSpacing="16">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{Binding Name}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding SourceUri}" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="1"
                                        Width="96"
                                        VerticalAlignment="Center"
                                        Text="{Binding StatusText}" />
                                    <ProgressBar
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Maximum="100"
                                        Value="{Binding Progress}" />
                                    <TextBlock
                                        Grid.Column="3"
                                        VerticalAlignment="Center"
                                        Text="{Binding SaveDirectory}"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Grid
                    x:Name="SettingsPage"
                    Visibility="Collapsed"
                    RowDefinitions="Auto,Auto,*"
                    RowSpacing="20">
                    <StackPanel Spacing="4">
                        <TextBlock
                            FontSize="28"
                            FontWeight="SemiBold"
                            x:Uid="SettingsTitleText"
                            Text="Settings" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            x:Uid="SettingsSubtitleText"
                            Text="Manage the local aria2 process and default download behavior." />
                    </StackPanel>

                    <Grid
                        Grid.Row="1"
                        ColumnDefinitions="220,*"
                        RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                        ColumnSpacing="20"
                        RowSpacing="14">
                        <TextBlock
                            VerticalAlignment="Center"
                            x:Uid="AriaPathLabel"
                            Text="aria2c path" />
                        <TextBox
                            x:Name="AriaPathTextBox"
                            Grid.Column="1"
                            x:Uid="AriaPathTextBox"
                            PlaceholderText="Leave empty to resolve aria2c.exe from PATH" />

                        <TextBlock
                            Grid.Row="1"
                            VerticalAlignment="Center"
                            x:Uid="RpcPortLabel"
                            Text="RPC port" />
                        <NumberBox
                            x:Name="RpcPortNumberBox"
                            Grid.Row="1"
                            Grid.Column="1"
                            Minimum="1"
                            Maximum="65535"
                            Value="6800" />

                        <TextBlock
                            Grid.Row="2"
                            VerticalAlignment="Center"
                            x:Uid="DefaultDirectoryLabel"
                            Text="Default directory" />
                        <TextBox
                            x:Name="DownloadDirectoryTextBox"
                            Grid.Row="2"
                            Grid.Column="1" />

                        <TextBlock
                            Grid.Row="3"
                            VerticalAlignment="Center"
                            x:Uid="ProxyLabel"
                            Text="Proxy" />
                        <CheckBox
                            x:Name="UseSystemProxyCheckBox"
                            Grid.Row="3"
                            Grid.Column="1"
                            Checked="UseSystemProxyCheckBox_Changed"
                            Content="Use Windows system proxy when aria2 starts"
                            IsChecked="True"
                            x:Uid="UseSystemProxyCheckBox"
                            Unchecked="UseSystemProxyCheckBox_Changed" />

                        <TextBlock
                            Grid.Row="4"
                            VerticalAlignment="Center"
                            x:Uid="ProcessStatusLabel"
                            Text="Process status" />
                        <StackPanel
                            Grid.Row="4"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="12">
                            <TextBlock
                                x:Name="SettingsAriaStatusText"
                                VerticalAlignment="Center"
                                x:Uid="SettingsAriaStatusText"
                                Text="Stopped" />
                            <Button
                                Click="StartAriaButton_Click"
                                x:Uid="SettingsStartButton"
                                Content="Start" />
                            <Button
                                Click="StopAriaButton_Click"
                                x:Uid="SettingsStopButton"
                                Content="Stop" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </NavigationView>

        <Border
            Grid.Row="2"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid RowDefinitions="Auto,Auto">
                <Grid
                    Padding="12,6"
                    ColumnDefinitions="Auto,*,Auto,Auto"
                    ColumnSpacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE756;" />
                        <TextBlock
                            x:Name="DebugEngineText"
                            VerticalAlignment="Center"
                            x:Uid="DebugEngineText"
                            Text="aria2 stopped" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        x:Uid="TerminalSummaryText"
                        Text="aria2 terminal output"
                        TextTrimming="CharacterEllipsis" />
                    <Button
                        x:Name="ClearTerminalButton"
                        Grid.Column="2"
                        Click="ClearTerminalButton_Click"
                        x:Uid="ClearTerminalButton"
                        Content="Clear" />
                    <ToggleButton
                        x:Name="TerminalToggleButton"
                        Grid.Column="3"
                        Checked="TerminalToggleButton_Changed"
                        Content="Terminal"
                        x:Uid="TerminalToggleButton"
                        Unchecked="TerminalToggleButton_Changed" />
                </Grid>

                <Border
                    x:Name="TerminalPanel"
                    Grid.Row="1"
                    Height="180"
                    Padding="12"
                    Background="#FF1E1E1E"
                    Visibility="Collapsed">
                    <ScrollViewer
                        x:Name="TerminalScrollViewer"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto">
                        <TextBlock
                            x:Name="TerminalTextBlock"
                            FontFamily="Cascadia Mono, Consolas"
                            FontSize="12"
                            Foreground="#FFD4D4D4"
                            x:Uid="TerminalTextBlock"
                            Text="aria2 terminal output will appear here."
                            TextWrapping="NoWrap" />
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
