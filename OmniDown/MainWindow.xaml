<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OmniDown.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OmniDown.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="OmniDown">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        KeyboardAcceleratorPlacementMode="Hidden"
        Loaded="RootGrid_Loaded"
        RowDefinitions="Auto,*">
        <Grid.Resources>
            <Style x:Key="TaskDetailsSectionTitleTextBlockStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,18,0,8" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="TaskDetailsPropertyNameTextBlockStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="TaskDetailsPropertyValueTextBlockStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
                <Setter Property="TextWrapping" Value="WrapWholeWords" />
            </Style>
            <Style x:Key="TaskDetailsPropertyRowBorderStyle" TargetType="Border">
                <Setter Property="Padding" Value="0,8" />
                <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
            </Style>
        </Grid.Resources>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator
                Key="N"
                Modifiers="Control"
                Invoked="NewDownloadKeyboardAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <TitleBar
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="48"
            MinHeight="48"
            VerticalAlignment="Stretch"
            FontSize="13"
            BackRequested="AppTitleBar_BackRequested"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="AppTitleBar_PaneToggleRequested"
            Title="OmniDown">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/OmniDown.ico" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <AutoSuggestBox
                    x:Name="TitleSearchBox"
                    Width="320"
                    VerticalAlignment="Center"
                    KeyUp="TitleSearchBox_KeyUp"
                    PlaceholderText="Search downloads and settings..."
                    QueryIcon="Find"
                    QuerySubmitted="TitleSearchBox_QuerySubmitted"
                    TextChanged="TitleSearchBox_TextChanged"
                    x:Uid="TitleSearchBox" />
            </TitleBar.Content>
        </TitleBar>

        <NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            CompactPaneLength="48"
            OpenPaneLength="220"
            PaneDisplayMode="Auto"
            DisplayModeChanged="RootNavigation_DisplayModeChanged"
            ItemInvoked="RootNavigation_ItemInvoked"
            SelectionChanged="RootNavigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="TasksNavItem"
                    Content="Home"
                    IsSelected="True"
                    x:Uid="TasksNavItem"
                    Tag="Home">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="Transfers"
                    x:Uid="ActiveNavItem"
                    Tag="Downloading">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Play" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="Complete"
                    x:Uid="CompletedNavItem"
                    Tag="Completed">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Accept" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="Issues"
                    x:Uid="IssuesNavItem"
                    Tag="Issues">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Important" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    x:Name="SettingsNavItem"
                    Content="Settings"
                    Tapped="SettingsNavItem_Tapped"
                    x:Uid="SettingsNavItem"
                    Tag="Settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
