<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OmniDown.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OmniDown.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="OmniDown">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        KeyboardAcceleratorPlacementMode="Hidden"
        Loaded="RootGrid_Loaded"
        RowDefinitions="Auto,*">
        <Grid.Resources>
            <Style x:Key="TaskDetailsSectionTitleTextBlockStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,18,0,8" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="TaskDetailsPropertyNameTextBlockStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="TaskDetailsPropertyValueTextBlockStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
                <Setter Property="TextWrapping" Value="WrapWholeWords" />
            </Style>
            <Style x:Key="TaskDetailsPropertyRowBorderStyle" TargetType="Border">
                <Setter Property="Padding" Value="0,8" />
                <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
            </Style>
        </Grid.Resources>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator
                Key="N"
                Modifiers="Control"
                Invoked="NewDownloadKeyboardAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <TitleBar
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="48"
            MinHeight="48"
            VerticalAlignment="Stretch"
            FontSize="13"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="AppTitleBar_PaneToggleRequested"
            Title="OmniDown">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/OmniDown.ico" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <AutoSuggestBox
                    x:Name="TitleSearchBox"
                    Width="320"
                    VerticalAlignment="Center"
                    KeyUp="TitleSearchBox_KeyUp"
                    PlaceholderText="Search downloads and settings..."
                    QueryIcon="Find"
                    QuerySubmitted="TitleSearchBox_QuerySubmitted"
                    TextChanged="TitleSearchBox_TextChanged"
                    x:Uid="TitleSearchBox" />
            </TitleBar.Content>
        </TitleBar>

        <NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            CompactPaneLength="48"
            OpenPaneLength="220"
            PaneDisplayMode="Auto"
            DisplayModeChanged="RootNavigation_DisplayModeChanged"
            ItemInvoked="RootNavigation_ItemInvoked"
            SelectionChanged="RootNavigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="TasksNavItem"
                    Content="Home"
                    IsSelected="True"
                    x:Uid="TasksNavItem"
                    Tag="Home">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="Transfers"
                    x:Uid="ActiveNavItem"
                    Tag="Downloading">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Play" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="Complete"
                    x:Uid="CompletedNavItem"
                    Tag="Completed">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Accept" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="Issues"
                    x:Uid="IssuesNavItem"
                    Tag="Issues">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Important" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    x:Name="SettingsNavItem"
                    Content="Settings"
                    Tapped="SettingsNavItem_Tapped"
                    x:Uid="SettingsNavItem"
                    Tag="Settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <Grid
                    Grid.Column="0"
                    Padding="16,8,0,0"
                    RowDefinitions="Auto,*,Auto">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition
                            x:Name="TaskDetailsHostColumn"
                            Width="0" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        x:Name="TasksHeaderPanel"
                        Grid.ColumnSpan="2"
                        Padding="0,0,12,0"
                        ColumnDefinitions="Auto,*,Auto">
                        <StackPanel
                            Spacing="4"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="DownloadsTitleText"
                                FontSize="28"
                                FontWeight="SemiBold"
                                x:Uid="DownloadsTitleText"
                                Text="Downloads" />
                        </StackPanel>

                        <CommandBar
                            Grid.Column="0"
                            Background="Transparent"
                            Padding="0"
                            HorizontalAlignment="Left"
                            DefaultLabelPosition="Right"
                            IsOpen="False">
                            <CommandBar.PrimaryCommands>
                                <AppBarButton
                                    x:Name="NewDownloadButton"
                                    Click="NewDownloadButton_Click"
                                    x:Uid="NewDownloadButton"
                                    Label="New">
                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE710;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarSeparator />
                                <AppBarButton
                                    x:Name="ResumeTasksButton"
                                    Click="ResumeTasksButton_Click"
                                    IsEnabled="False"
                                    x:Uid="ResumeTasksButton"
                                    Label="Resume">
                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE768;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton
                                    x:Name="PauseTasksButton"
                                    Click="PauseTasksButton_Click"
                                    IsEnabled="False"
                                    x:Uid="PauseTasksButton"
                                    Label="Pause">
                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE769;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton
                                    x:Name="RecoverTasksButton"
                                    Click="RecoverTasksButton_Click"
                                    IsEnabled="False"
                                    x:Uid="RecoverTasksButton"
                                    Label="Recover">
                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE72C;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarSeparator />
                                <AppBarButton
                                    x:Name="DeleteTasksButton"
                                    Click="DeleteTasksButton_Click"
                                    IsEnabled="False"
                                    x:Uid="DeleteTasksButton"
                                    Label="Delete">
                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE74D;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarSeparator />
                                <AppBarButton
                                    x:Name="SortTasksButton"
                                    AutomationProperties.Name="Sort"
                                    MinWidth="88"
                                    Label="Sort"
                                    LabelPosition="Collapsed"
                                    ToolTipService.ToolTip="Sort"
                                    VerticalAlignment="Center"
                                    x:Uid="SortTasksButton">
                                    <AppBarButton.Content>
                                        <StackPanel
                                            Margin="6,0"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                            <FontIcon
                                                FontSize="18"
                                                Glyph="&#xE8CB;" />
                                            <TextBlock
                                                FontSize="15"
                                                x:Uid="SortTasksButtonLabel"
                                                Text="Sort" />
                                            <FontIcon
                                                FontSize="12"
                                                Glyph="&#xE76C;" />
                                        </StackPanel>
                                    </AppBarButton.Content>
                                    <AppBarButton.Flyout>
                                        <MenuFlyout
                                            Opening="SortMenuFlyout_Opening"
                                            Placement="BottomEdgeAlignedLeft">
                                            <ToggleMenuFlyoutItem
                                                x:Name="SortByCreatedAtMenuItem"
                                                Click="SortColumnMenuItem_Click"
                                                x:Uid="SortByCreatedAtMenuItem"
                                                Tag="CreatedAt"
                                                Text="Added time" />
                                            <ToggleMenuFlyoutItem
                                                x:Name="SortByNameMenuItem"
                                                Click="SortColumnMenuItem_Click"
                                                x:Uid="SortByNameMenuItem"
                                                Tag="Name"
                                                Text="Name" />
                                            <ToggleMenuFlyoutItem
                                                x:Name="SortBySizeMenuItem"
                                                Click="SortColumnMenuItem_Click"
                                                x:Uid="SortBySizeMenuItem"
                                                Tag="Size"
                                                Text="Size" />
                                            <MenuFlyoutSeparator />
                                            <ToggleMenuFlyoutItem
                                                x:Name="SortAscendingMenuItem"
                                                Click="SortDirectionMenuItem_Click"
                                                x:Uid="SortAscendingMenuItem"
                                                Tag="Ascending"
                                                Text="Ascending" />
                                            <ToggleMenuFlyoutItem
                                                x:Name="SortDescendingMenuItem"
                                                Click="SortDirectionMenuItem_Click"
                                                x:Uid="SortDescendingMenuItem"
                                                Tag="Descending"
                                                Text="Descending" />
                                        </MenuFlyout>
                                    </AppBarButton.Flyout>
                                </AppBarButton>
                            </CommandBar.PrimaryCommands>
                            <CommandBar.SecondaryCommands>
                                <AppBarButton
                                    x:Name="OpenSelectedTaskFileButton"
                                    Click="OpenSelectedTaskFileButton_Click"
                                    IsEnabled="False"
                                    x:Uid="OpenSelectedTaskFileButton"
                                    Label="Open file">
                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE8A7;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton
                                    x:Name="OpenSelectedTaskFolderButton"
                                    Click="OpenSelectedTaskFolderButton_Click"
                                    IsEnabled="False"
                                    x:Uid="OpenSelectedTaskFolderButton"
                                    Label="Open folder">
                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE8B7;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton
                                    x:Name="CopySelectedTaskLinksButton"
                                    Click="CopySelectedTaskLinksButton_Click"
                                    IsEnabled="False"
                                    x:Uid="CopySelectedTaskLinksButton"
                                    Label="Copy link">
                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE71B;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarSeparator />
                                <AppBarButton
                                    x:Name="ClearCompletedTasksButton"
                                    Click="ClearCompletedTasksButton_Click"
                                    x:Uid="ClearCompletedTasksButton"
                                    Label="Clear completed records">
                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE894;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                            </CommandBar.SecondaryCommands>
                        </CommandBar>

                        <CommandBar
                            Grid.Column="2"
                            Background="Transparent"
                            Padding="0"
                            DefaultLabelPosition="Right"
                            IsOpen="False">
                            <CommandBar.PrimaryCommands>
                                <AppBarButton
                                    x:Name="TaskDetailsButton"
                                    Click="TaskDetailsButton_Click"
                                    x:Uid="TaskDetailsButton"
                                    Label="Details">
                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE946;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                            </CommandBar.PrimaryCommands>
                        </CommandBar>
                    </Grid>
                    <Grid
                        x:Name="TasksPage"
                        Grid.Column="0"
                        Grid.Row="1"
                        Padding="0,0,24,0"
                        RowDefinitions="Auto,Auto,*">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="0" />
                        </Grid.ColumnDefinitions>

                    <Grid
                        x:Name="StatsPanel"
                        Grid.Row="0"
                        Margin="0,20,0,14"
                        ColumnDefinitions="*,*,*,*,*,Auto"
                        Visibility="Collapsed">
                        <StackPanel
                            x:Name="TotalMetricPanel"
                            Margin="0,8,0,0"
                            Spacing="4">
                            <TextBlock
                                x:Name="TotalMetricLabelText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="TotalMetricLabel"
                                Text="Total" />
                            <TextBlock
                                x:Name="TotalTasksText"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Text="0" />
                        </StackPanel>
                        <StackPanel
                            x:Name="ActiveMetricPanel"
                            Grid.Column="1"
                            Margin="0,8,0,0"
                            Spacing="4">
                            <TextBlock
                                x:Name="ActiveMetricLabelText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="ActiveMetricLabel"
                                Text="Downloading" />
                            <TextBlock
                                x:Name="ActiveTasksText"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Text="0" />
                        </StackPanel>
                        <StackPanel
                            x:Name="PausedMetricPanel"
                            Grid.Column="2"
                            Margin="0,8,0,0"
                            Spacing="4">
                            <TextBlock
                                x:Name="PausedMetricLabelText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Paused" />
                            <TextBlock
                                x:Name="PausedTasksText"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Text="0" />
                        </StackPanel>
                        <StackPanel
                            x:Name="CompletedMetricPanel"
                            Grid.Column="3"
                            Margin="0,8,0,0"
                            Spacing="4">
                            <TextBlock
                                x:Name="CompletedMetricLabelText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="DownloadSpeedMetricLabel"
                                Text="Completed" />
                            <TextBlock
                                x:Name="CompletedTasksText"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Text="0" />
                        </StackPanel>
                        <StackPanel
                            x:Name="IssueMetricPanel"
                            Grid.Column="4"
                            Margin="0,8,0,0"
                            Spacing="4">
                            <TextBlock
                                x:Name="IssueMetricLabelText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="Aria2MetricLabel"
                                Text="Issues" />
                            <TextBlock
                                x:Name="IssueTasksText"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Text="0" />
                        </StackPanel>
                        <DropDownButton
                            x:Name="SpeedLimitButton"
                            Grid.Column="5"
                            MinWidth="292"
                            Margin="-14,0,0,0"
                            Padding="14,8,14,6"
                            HorizontalAlignment="Right"
                            HorizontalContentAlignment="Left"
                            VerticalAlignment="Top"
                            AutomationProperties.Name="Realtime speed and speed limit"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            x:Uid="SpeedLimitButton">
                            <DropDownButton.Content>
                                <Grid
                                    Width="264"
                                    RowDefinitions="Auto,Auto,16"
                                    RowSpacing="4">
                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        x:Uid="RealtimeSpeedLabel"
                                        Text="Realtime speed" />
                                    <StackPanel
                                        Grid.Row="1"
                                        HorizontalAlignment="Left"
                                        Orientation="Horizontal"
                                        Spacing="18">
                                        <Grid
                                            ColumnDefinitions="22,96">
                                            <Grid
                                                Width="22"
                                                HorizontalAlignment="Center">
                                                <FontIcon
                                                    HorizontalAlignment="Center"
                                                    FontSize="16"
                                                    Glyph="&#xE74A;" />
                                            </Grid>
                                            <TextBlock
                                                x:Name="GlobalUploadSpeedText"
                                                Grid.Column="1"
                                                Width="96"
                                                FontSize="18"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis"
                                                Text="0 B/s" />
                                        </Grid>
                                        <Grid
                                            ColumnDefinitions="22,96">
                                            <Grid
                                                Width="22"
                                                HorizontalAlignment="Center">
                                                <FontIcon
                                                    HorizontalAlignment="Center"
                                                    FontSize="16"
                                                    Glyph="&#xE74B;" />
                                            </Grid>
                                            <TextBlock
                                                x:Name="GlobalDownloadSpeedText"
                                                Grid.Column="1"
                                                Width="96"
                                                FontSize="18"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis"
                                                Text="0 B/s" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Row="2"
                                        HorizontalAlignment="Left"
                                        Orientation="Horizontal"
                                        Spacing="18">
                                        <Grid
                                            ColumnDefinitions="22,96">
                                            <Grid
                                                x:Name="GlobalUploadLimitIconPanel"
                                                Width="22"
                                                HorizontalAlignment="Center"
                                                Opacity="0">
                                                <Grid
                                                    Width="22"
                                                    HorizontalAlignment="Center">
                                                    <FontIcon
                                                        HorizontalAlignment="Center"
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Glyph="&#xE72E;" />
                                                </Grid>
                                            </Grid>
                                            <TextBlock
                                                x:Name="GlobalUploadLimitText"
                                                Grid.Column="1"
                                                Width="96"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Opacity="0"
                                                Text="0 B/s"
                                                TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                        <Grid
                                            ColumnDefinitions="22,96">
                                            <Grid
                                                x:Name="GlobalDownloadLimitIconPanel"
                                                Width="22"
                                                HorizontalAlignment="Center"
                                                Opacity="0">
                                                <Grid
                                                    Width="22"
                                                    HorizontalAlignment="Center">
                                                    <FontIcon
                                                        HorizontalAlignment="Center"
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Glyph="&#xE72E;" />
                                                </Grid>
                                            </Grid>
                                            <TextBlock
                                                x:Name="GlobalDownloadLimitText"
                                                Grid.Column="1"
                                                Width="96"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Opacity="0"
                                                Text="0 B/s"
                                                TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </DropDownButton.Content>
                            <DropDownButton.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <StackPanel
                                        Width="280"
                                        Spacing="12">
                                        <StackPanel Spacing="8">
                                            <Grid
                                                Width="280"
                                                ColumnDefinitions="*,92"
                                                ColumnSpacing="8">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    x:Uid="UploadLimitLabel"
                                                    Text="Upload limit" />
                                                <ToggleSwitch
                                                    x:Name="UploadLimitToggleSwitch"
                                                    Grid.Column="1"
                                                    Width="48"
                                                    MinWidth="0"
                                                    Padding="0"
                                                    HorizontalAlignment="Right"
                                                    OffContent=""
                                                    OnContent=""
                                                    Toggled="UploadLimitToggleSwitch_Toggled" />
                                            </Grid>
                                            <Grid ColumnDefinitions="168,*" ColumnSpacing="8">
                                                <NumberBox
                                                    x:Name="UploadLimitNumberBox"
                                                    IsEnabled="False"
                                                    Height="32"
                                                    Minimum="1"
                                                    SmallChange="128"
                                                    LargeChange="1024"
                                                    SpinButtonPlacementMode="Inline"
                                                    Value="1024" />
                                                <ComboBox
                                                    x:Name="UploadLimitUnitComboBox"
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Right"
                                                    IsEnabled="False"
                                                    SelectedIndex="0">
                                                    <ComboBoxItem Content="KB/s" />
                                                    <ComboBoxItem Content="MB/s" />
                                                </ComboBox>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Spacing="8">
                                            <Grid
                                                Width="280"
                                                ColumnDefinitions="*,92"
                                                ColumnSpacing="8">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    x:Uid="DownloadLimitLabel"
                                                    Text="Download limit" />
                                                <ToggleSwitch
                                                    x:Name="DownloadLimitToggleSwitch"
                                                    Grid.Column="1"
                                                    Width="48"
                                                    MinWidth="0"
                                                    Padding="0"
                                                    HorizontalAlignment="Right"
                                                    OffContent=""
                                                    OnContent=""
                                                    Toggled="DownloadLimitToggleSwitch_Toggled" />
                                            </Grid>
                                            <Grid ColumnDefinitions="168,*" ColumnSpacing="8">
                                                <NumberBox
                                                    x:Name="DownloadLimitNumberBox"
                                                    IsEnabled="False"
                                                    Height="32"
                                                    Minimum="1"
                                                    SmallChange="128"
                                                    LargeChange="1024"
                                                    SpinButtonPlacementMode="Inline"
                                                    Value="1024" />
                                                <ComboBox
                                                    x:Name="DownloadLimitUnitComboBox"
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Right"
                                                    IsEnabled="False"
                                                    SelectedIndex="0">
                                                    <ComboBoxItem Content="KB/s" />
                                                    <ComboBoxItem Content="MB/s" />
                                                </ComboBox>
                                            </Grid>
                                        </StackPanel>
                                        <Button
                                            HorizontalAlignment="Right"
                                            Click="ApplySpeedLimitButton_Click"
                                            Content="Apply"
                                            x:Uid="ApplySpeedLimitButton" />
                                    </StackPanel>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </Grid>

                    <Border
                        x:Name="TasksListHeaderPanel"
                        Grid.Row="1"
                        Margin="0,8,0,4"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        CornerRadius="4">
                        <Grid
                            MinHeight="38"
                            Padding="0,0,20,0"
                            ColumnDefinitions="48,*,120,150,110,180"
                            ColumnSpacing="16">
                            <CheckBox
                                x:Name="SelectAllTasksCheckBox"
                                Width="20"
                                Height="20"
                                MinWidth="0"
                                Padding="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Checked="SelectAllTasksCheckBox_Checked"
                                Indeterminate="SelectAllTasksCheckBox_Indeterminate"
                                IsThreeState="True"
                                Unchecked="SelectAllTasksCheckBox_Unchecked" />
                            <TextBlock
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="NameColumnHeader"
                                Text="Name" />
                            <TextBlock
                                Grid.Column="2"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="StatusColumnHeader"
                                Text="Status" />
                            <TextBlock
                                Grid.Column="3"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="ProgressColumnHeader"
                                Text="Progress" />
                            <TextBlock
                                Grid.Column="4"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="RemainingTimeColumnHeader"
                                Text="Remaining" />
                            <TextBlock
                                Grid.Column="5"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="SpeedColumnHeader"
                                Text="Speed" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <ListView
                            x:Name="TasksListView"
                            Background="Transparent"
                            IsMultiSelectCheckBoxEnabled="False"
                            PointerPressed="TasksListView_PointerPressed"
                            RightTapped="TasksListView_RightTapped"
                            SelectionChanged="TasksListView_SelectionChanged"
                            SelectionMode="Extended">
                            <ListView.Resources>
                                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemBorderBrushSelected" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemBorderBrushSelectedPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemBorderBrushSelectedPressed" Color="Transparent" />
                            </ListView.Resources>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="MinHeight" Value="52" />
                                    <Setter Property="Margin" Value="0,0,0,4" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection />
                            </ListView.ItemContainerTransitions>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <UserControl Loaded="TaskItem_Loaded">
                                        <Border
                                            MinHeight="52"
                                            Background="{Binding TaskItemBackground}"
                                            BorderBrush="{Binding TaskItemBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                            <Grid RowDefinitions="49,3">
                                                <Border
                                                    x:Name="SelectionAccent"
                                                    Grid.Row="0"
                                                    Width="4"
                                                    Height="24"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    CornerRadius="2"
                                                    Opacity="{Binding SelectionIndicatorOpacity}" />
                                                <Grid
                                                    Grid.Row="0"
                                                    Padding="0,0,20,0"
                                                    ColumnDefinitions="48,*,120,150,110,180"
                                                    ColumnSpacing="16">
                                                    <Grid
                                                        Width="40"
                                                        Height="40"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        PointerCanceled="TaskIconSelectionBox_PointerExited"
                                                        PointerEntered="TaskIconSelectionBox_PointerEntered"
                                                        PointerExited="TaskIconSelectionBox_PointerExited">
                                                        <FontIcon
                                                            x:Name="TaskIcon"
                                                            Width="18"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="16"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Glyph="&#xE7C3;"
                                                            Opacity="{Binding TaskIconOpacity}" />
                                                        <CheckBox
                                                            x:Name="SelectionCheckbox"
                                                            Width="20"
                                                            Height="20"
                                                            MinWidth="0"
                                                            Padding="0"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Checked="TaskCheckBox_Changed"
                                                            Content=""
                                                            IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                            Opacity="{Binding SelectionCheckboxOpacity}"
                                                            Unchecked="TaskCheckBox_Changed" />
                                                    </Grid>
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        FontWeight="SemiBold"
                                                        Foreground="{Binding NameBrush}"
                                                        Text="{Binding Name}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        Foreground="{Binding StatusBrush}"
                                                        Text="{Binding StatusText}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <StackPanel
                                                        Grid.Column="3"
                                                        VerticalAlignment="Center"
                                                        Spacing="1">
                                                        <TextBlock
                                                            FontWeight="SemiBold"
                                                            Foreground="{Binding ProgressBrush}"
                                                            Text="{Binding ProgressText}"
                                                            TextAlignment="Left" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                            Text="{Binding TransferredSizeText}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        Grid.Column="4"
                                                        VerticalAlignment="Center"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{Binding RemainingTimeText}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Grid.Column="5"
                                                        VerticalAlignment="Center"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{Binding DownloadSpeedText}"
                                                        TextTrimming="CharacterEllipsis"
                                                        Visibility="{Binding NormalSpeedVisibility}" />
                                                    <StackPanel
                                                        Grid.Column="5"
                                                        VerticalAlignment="Center"
                                                        Spacing="2"
                                                        Visibility="{Binding PeerSpeedVisibility}">
                                                        <StackPanel
                                                            Orientation="Horizontal"
                                                            Spacing="6">
                                                            <FontIcon
                                                                Width="14"
                                                                FontSize="12"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Glyph="&#xE74A;" />
                                                            <TextBlock
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Text="{Binding UploadSpeedText}"
                                                                TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <StackPanel
                                                            Orientation="Horizontal"
                                                            Spacing="6">
                                                            <FontIcon
                                                                Width="14"
                                                                FontSize="12"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Glyph="&#xE74B;" />
                                                            <TextBlock
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Text="{Binding DownloadSpeedText}"
                                                                TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                                <ProgressBar
                                                    Grid.Row="1"
                                                    Height="3"
                                                    Margin="0"
                                                    VerticalAlignment="Bottom"
                                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                    Foreground="{Binding ProgressBrush}"
                                                    Maximum="100"
                                                    Value="{Binding Progress}" />

                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup x:Name="CheckboxVisibilityStates">
                                                        <VisualState x:Name="HideCheckbox" />
                                                        <VisualState x:Name="ShowCheckbox">
                                                            <VisualState.Setters>
                                                                <Setter Target="SelectionAccent.Opacity" Value="1" />
                                                                <Setter Target="SelectionCheckbox.Opacity" Value="1" />
                                                                <Setter Target="TaskIcon.Opacity" Value="0" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                            </Grid>
                                        </Border>
                                    </UserControl>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Grid
                            x:Name="TasksLoadingPanel"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            Visibility="Visible">
                            <ProgressRing
                                x:Name="TasksLoadingRing"
                                Width="36"
                                Height="36"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Loading downloads"
                                IsActive="True"
                                x:Uid="TasksLoadingRing" />
                        </Grid>

                    </Grid>

                    </Grid>

                    <controls:SettingsPageControl
                        x:Name="SettingsPage"
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        Visibility="Collapsed" />

                <controls:TaskDetailsPaneControl
                    x:Name="TaskDetailsPane"
                    Grid.Column="1"
                    Grid.Row="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Visibility="Collapsed" />
                <Grid
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    Margin="-16,0,0,0"
                    RowDefinitions="*,Auto">
                    <Border
                        x:Name="StatusBarPanel"
                        Grid.Row="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0">
                        <Grid RowDefinitions="Auto,Auto">
                            <Grid
                            MinHeight="40"
                            Padding="16,0,8,0"
                            ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto"
                            ColumnSpacing="12">
                            <StackPanel
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="12">
                                <TextBlock
                                    x:Name="StatusBarItemCountText"
                                    VerticalAlignment="Center"
                                    Text="0 个项目" />
                                <Rectangle
                                    x:Name="StatusBarSelectedCountDivider"
                                    Width="1"
                                    Height="18"
                                    VerticalAlignment="Center"
                                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    Visibility="Collapsed" />
                                <TextBlock
                                    x:Name="StatusBarSelectedCountText"
                                    VerticalAlignment="Center"
                                    Text="已选择 0 个项目"
                                    Visibility="Collapsed" />
                            </StackPanel>
                            <Rectangle
                                x:Name="StatusBarTaskCountsDivider"
                                Grid.Column="1"
                                Width="1"
                                Height="18"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                                Visibility="Collapsed" />
                            <StackPanel
                                x:Name="StatusBarTaskCountsPanel"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="12"
                                Visibility="Collapsed">
                                <Grid ColumnDefinitions="16,Auto" ColumnSpacing="4">
                                    <FontIcon
                                        Width="16"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Glyph="&#xE768;" />
                                    <TextBlock
                                        x:Name="StatusBarActiveTasksText"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="0" />
                                </Grid>
                                <Grid ColumnDefinitions="16,Auto" ColumnSpacing="4">
                                    <FontIcon
                                        Width="16"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Glyph="&#xE769;" />
                                    <TextBlock
                                        x:Name="StatusBarPausedTasksText"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="0" />
                                </Grid>
                                <Grid
                                    x:Name="StatusBarIssueTasksPanel"
                                    ColumnDefinitions="16,Auto"
                                    ColumnSpacing="4"
                                    Visibility="Collapsed">
                                    <FontIcon
                                        Width="16"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Glyph="&#xE7BA;" />
                                    <TextBlock
                                        x:Name="StatusBarIssueTasksText"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="0" />
                                </Grid>
                            </StackPanel>
                            <StackPanel
                                x:Name="StatusBarSpeedPanel"
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="12"
                                Visibility="Collapsed">
                                <Rectangle
                                    Width="1"
                                    Height="18"
                                    VerticalAlignment="Center"
                                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <Button
                                    x:Name="StatusBarSpeedButton"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    Click="StatusBarSpeedButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Grid ColumnDefinitions="16,Auto,Auto" ColumnSpacing="4">
                                            <FontIcon
                                                Width="16"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                Glyph="&#xE74A;" />
                                            <TextBlock
                                                x:Name="StatusBarUploadSpeedText"
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Text="0 B/s" />
                                            <StackPanel
                                                x:Name="StatusBarUploadLimitPanel"
                                                Grid.Column="2"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                Spacing="4"
                                                Visibility="Collapsed">
                                                <FontIcon
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Glyph="&#xE72E;" />
                                                <TextBlock
                                                    x:Name="StatusBarUploadLimitText"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid ColumnDefinitions="16,Auto,Auto" ColumnSpacing="4">
                                            <FontIcon
                                                Width="16"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                Glyph="&#xE74B;" />
                                            <TextBlock
                                                x:Name="StatusBarDownloadSpeedText"
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Text="0 B/s" />
                                            <StackPanel
                                                x:Name="StatusBarDownloadLimitPanel"
                                                Grid.Column="2"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                Spacing="4"
                                                Visibility="Collapsed">
                                                <FontIcon
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Glyph="&#xE72E;" />
                                                <TextBlock
                                                    x:Name="StatusBarDownloadLimitText"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <Button
                                x:Name="NotificationHistoryButton"
                                Grid.Column="5"
                                Width="32"
                                Height="32"
                                MinWidth="32"
                                Padding="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="NotificationHistoryButton"
                                x:Uid="NotificationHistoryButton">
                                <FontIcon FontSize="14" Glyph="&#xE7F4;" />
                                <Button.Flyout>
                                    <Flyout Placement="TopEdgeAlignedRight">
                                        <Grid
                                            Width="380"
                                            MaxHeight="420"
                                            RowDefinitions="Auto,*"
                                            RowSpacing="8">
                                            <TextBlock
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                x:Uid="NotificationHistoryTitleText"
                                                Text="Notifications" />
                                            <ListView
                                                x:Name="NotificationHistoryListView"
                                                Grid.Row="1"
                                                MaxHeight="380"
                                                SelectionMode="None">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid
                                                            Padding="0,8"
                                                            ColumnDefinitions="Auto,*"
                                                            ColumnSpacing="10">
                                                            <FontIcon
                                                                Width="20"
                                                                VerticalAlignment="Top"
                                                                FontSize="15"
                                                                Foreground="{Binding SeverityBrush}"
                                                                Glyph="{Binding SeverityGlyph}" />
                                                            <StackPanel
                                                                Grid.Column="1"
                                                                Spacing="2">
                                                                <TextBlock
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{Binding SeverityBrush}"
                                                                    Text="{Binding SeverityText}" />
                                                                <TextBlock
                                                                    Text="{Binding Message}"
                                                                    TextWrapping="WrapWholeWords" />
                                                                <TextBlock
                                                                    FontSize="12"
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Text="{Binding DetailText}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                        </Grid>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            </Grid>

                            <Grid Visibility="Collapsed">
                                <TextBlock x:Name="DebugEngineText" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <InfoBar
                    x:Name="StatusToastInfoBar"
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    AutomationProperties.AutomationId="StatusToastInfoBar"
                    Width="420"
                    Margin="0,0,16,8"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Closed="StatusToastInfoBar_Closed"
                    IsOpen="False"
                    Severity="Informational"
                    Visibility="Collapsed">
                    <InfoBar.ActionButton>
                        <Button
                            x:Name="StatusToastActionButton"
                            AutomationProperties.AutomationId="StatusToastActionButton"
                            Click="StatusToastActionButton_Click"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon
                                    x:Name="StatusToastActionIcon"
                                    FontSize="14"
                                    Glyph="&#xE8C8;" />
                                <TextBlock
                                    x:Name="StatusToastActionText"
                                    x:Uid="StatusToastCopyButtonLabel"
                                    Text="Copy" />
                            </StackPanel>
                        </Button>
                    </InfoBar.ActionButton>
                </InfoBar>

                <TeachingTip
                    x:Name="SettingsSaveTeachingTip"
                    Grid.Row="1"
                    Title="保存设置？"
                    Subtitle="设置已修改。保存后才会写入配置；取消会恢复原来的值。"
                    ActionButtonContent="保存"
                    CloseButtonContent="取消"
                    ActionButtonClick="SettingsSaveTeachingTip_ActionButtonClick"
                    CloseButtonClick="SettingsSaveTeachingTip_CloseButtonClick"
                    IsLightDismissEnabled="False"
                    PlacementMargin="20"
                    PreferredPlacement="Auto" />

                <TeachingTip
                    x:Name="AriaRestartTeachingTip"
                    Grid.Row="1"
                    Title="重启 aria2？"
                    Subtitle="这些设置需要重启 aria2 后生效。取消会恢复到重启前的设置。"
                    ActionButtonContent="重启"
                    CloseButtonContent="取消"
                    ActionButtonClick="AriaRestartTeachingTip_ActionButtonClick"
                    CloseButtonClick="AriaRestartTeachingTip_CloseButtonClick"
                    IsLightDismissEnabled="False"
                    PlacementMargin="20"
                    PreferredPlacement="Auto" />
            </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
