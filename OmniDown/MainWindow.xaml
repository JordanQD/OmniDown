<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OmniDown.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="OmniDown">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <TitleBar
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="48"
            MinHeight="48"
            VerticalAlignment="Stretch"
            FontSize="13"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="AppTitleBar_PaneToggleRequested"
            Title="OmniDown">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/OmniDown.ico" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <AutoSuggestBox
                    x:Name="TitleSearchBox"
                    Width="320"
                    VerticalAlignment="Center"
                    PlaceholderText="Search downloads and settings..."
                    QueryIcon="Find"
                    TextChanged="TitleSearchBox_TextChanged"
                    x:Uid="TitleSearchBox" />
            </TitleBar.Content>
        </TitleBar>

        <InfoBar
            x:Name="StatusInfoBar"
            Grid.Row="1"
            Margin="12,12,12,0"
            IsClosable="True"
            IsOpen="False" />

        <NavigationView
            x:Name="RootNavigation"
            Grid.Row="2"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            SelectionChanged="RootNavigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="TasksNavItem"
                    Content="Home"
                    IsSelected="True"
                    x:Uid="TasksNavItem"
                    Tag="Home">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="Transfers"
                    x:Uid="ActiveNavItem"
                    Tag="Downloading">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Play" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="Complete"
                    x:Uid="CompletedNavItem"
                    Tag="Completed">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Accept" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="Issues"
                    x:Uid="IssuesNavItem"
                    Tag="Issues">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Important" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    Content="Settings"
                    x:Uid="SettingsNavItem"
                    Tag="Settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid Padding="28,20,28,24">
                <Grid
                    x:Name="TasksPage"
                    RowDefinitions="Auto,Auto,Auto,*">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="4">
                            <TextBlock
                                x:Name="DownloadsTitleText"
                                FontSize="28"
                                FontWeight="SemiBold"
                                x:Uid="DownloadsTitleText"
                                Text="Downloads" />
                            <TextBlock
                                x:Name="DownloadsSubtitleText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="DownloadsSubtitleText"
                                Text="Local aria2 sidecar control with JSON-RPC task sync." />
                        </StackPanel>

                        <CommandBar
                            Grid.Column="1"
                            DefaultLabelPosition="Right"
                            IsOpen="False">
                            <AppBarButton
                                Click="NewDownloadButton_Click"
                                Icon="Add"
                                x:Uid="NewDownloadButton"
                                Label="New" />
                            <AppBarSeparator />
                            <AppBarButton
                                x:Name="SortTasksButton"
                                x:Uid="SortTasksButton"
                                Label="Sort v">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE8CB;" />
                                </AppBarButton.Icon>
                                <AppBarButton.Flyout>
                                    <MenuFlyout Opening="SortMenuFlyout_Opening">
                                        <ToggleMenuFlyoutItem
                                            x:Name="SortByCreatedAtMenuItem"
                                            Click="SortColumnMenuItem_Click"
                                            x:Uid="SortByCreatedAtMenuItem"
                                            Tag="CreatedAt"
                                            Text="Added time" />
                                        <ToggleMenuFlyoutItem
                                            x:Name="SortByNameMenuItem"
                                            Click="SortColumnMenuItem_Click"
                                            x:Uid="SortByNameMenuItem"
                                            Tag="Name"
                                            Text="Name" />
                                        <ToggleMenuFlyoutItem
                                            x:Name="SortBySizeMenuItem"
                                            Click="SortColumnMenuItem_Click"
                                            x:Uid="SortBySizeMenuItem"
                                            Tag="Size"
                                            Text="Size" />
                                        <MenuFlyoutSeparator />
                                        <ToggleMenuFlyoutItem
                                            x:Name="SortAscendingMenuItem"
                                            Click="SortDirectionMenuItem_Click"
                                            x:Uid="SortAscendingMenuItem"
                                            Tag="Ascending"
                                            Text="Ascending" />
                                        <ToggleMenuFlyoutItem
                                            x:Name="SortDescendingMenuItem"
                                            Click="SortDirectionMenuItem_Click"
                                            x:Uid="SortDescendingMenuItem"
                                            Tag="Descending"
                                            Text="Descending" />
                                    </MenuFlyout>
                                </AppBarButton.Flyout>
                            </AppBarButton>
                            <AppBarSeparator />
                            <AppBarButton
                                x:Name="ResumeTasksButton"
                                Click="ResumeTasksButton_Click"
                                Icon="Play"
                                IsEnabled="False"
                                x:Uid="ResumeTasksButton"
                                Label="Resume" />
                            <AppBarButton
                                x:Name="PauseTasksButton"
                                Click="PauseTasksButton_Click"
                                Icon="Pause"
                                IsEnabled="False"
                                x:Uid="PauseTasksButton"
                                Label="Pause" />
                            <AppBarButton
                                x:Name="DeleteTasksButton"
                                Click="DeleteTasksButton_Click"
                                Icon="Delete"
                                IsEnabled="False"
                                x:Uid="DeleteTasksButton"
                                Label="Delete" />
                            <AppBarSeparator />
                            <AppBarButton
                                Click="StartAriaButton_Click"
                                Icon="Play"
                                x:Uid="StartAriaButton"
                                Label="Start aria2" />
                            <AppBarButton
                                Click="StopAriaButton_Click"
                                Icon="Stop"
                                x:Uid="StopAriaButton"
                                Label="Stop" />
                        </CommandBar>
                    </Grid>

                    <Grid
                        x:Name="StatsPanel"
                        Grid.Row="1"
                        Margin="0,20,0,14"
                        ColumnDefinitions="*,*,*,*">
                        <StackPanel Spacing="4">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="TotalMetricLabel"
                                Text="Total" />
                            <TextBlock
                                x:Name="TotalTasksText"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Text="0" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            Spacing="4">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="ActiveMetricLabel"
                                Text="Downloading" />
                            <TextBlock
                                x:Name="ActiveTasksText"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Text="0" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="2"
                            Spacing="4">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="DownloadSpeedMetricLabel"
                                Text="Completed" />
                            <TextBlock
                                x:Name="CompletedTasksText"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Text="0" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="3"
                            Spacing="4">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="Aria2MetricLabel"
                                Text="Issues" />
                            <TextBlock
                                x:Name="IssueTasksText"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Text="0" />
                        </StackPanel>
                    </Grid>

                    <Border
                        Grid.Row="2"
                        Margin="0,0,0,4"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        CornerRadius="4">
                        <Grid
                            MinHeight="38"
                            Padding="0,0,20,0"
                            ColumnDefinitions="48,*,120,80,110,220,224"
                            ColumnSpacing="16">
                            <CheckBox
                                x:Name="SelectAllTasksCheckBox"
                                Width="20"
                                Height="20"
                                MinWidth="0"
                                Padding="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Checked="SelectAllTasksCheckBox_Checked"
                                Indeterminate="SelectAllTasksCheckBox_Indeterminate"
                                IsThreeState="True"
                                Unchecked="SelectAllTasksCheckBox_Unchecked" />
                            <TextBlock
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="NameColumnHeader"
                                Text="Name" />
                            <TextBlock
                                Grid.Column="2"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="StatusColumnHeader"
                                Text="Status" />
                            <TextBlock
                                Grid.Column="3"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="ProgressColumnHeader"
                                Text="Progress" />
                            <TextBlock
                                Grid.Column="4"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="RemainingTimeColumnHeader"
                                Text="Remaining" />
                            <TextBlock
                                Grid.Column="5"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="SpeedColumnHeader"
                                Text="Speed" />
                        </Grid>
                    </Border>

                    <ListView
                        x:Name="TasksListView"
                        Grid.Row="3"
                        IsMultiSelectCheckBoxEnabled="False"
                        SelectionChanged="TasksListView_SelectionChanged"
                        SelectionMode="Multiple">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="52" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection />
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <UserControl Loaded="TaskItem_Loaded">
                                    <Grid
                                        MinHeight="52"
                                        Padding="0,0,20,0"
                                        RowDefinitions="*,3">
                                        <Grid
                                            ColumnDefinitions="48,*,120,80,110,220,224"
                                            ColumnSpacing="16">
                                            <Grid
                                                Width="40"
                                                Height="40"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                PointerCanceled="TaskIconSelectionBox_PointerExited"
                                                PointerEntered="TaskIconSelectionBox_PointerEntered"
                                                PointerExited="TaskIconSelectionBox_PointerExited">
                                                <FontIcon
                                                    x:Name="TaskIcon"
                                                    Width="18"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="16"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Glyph="&#xE7C3;" />
                                                <CheckBox
                                                    x:Name="SelectionCheckbox"
                                                    Width="20"
                                                    Height="20"
                                                    MinWidth="0"
                                                    Padding="0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Checked="TaskCheckBox_Changed"
                                                    Content=""
                                                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                    Opacity="0"
                                                    Unchecked="TaskCheckBox_Changed" />
                                            </Grid>
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Foreground="{Binding NameBrush}"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Foreground="{Binding StatusBrush}"
                                                Text="{Binding StatusText}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="3"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding ProgressText}"
                                                TextAlignment="Left" />
                                            <TextBlock
                                                Grid.Column="4"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding RemainingTimeText}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="5"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding DownloadSpeedText}"
                                                TextTrimming="CharacterEllipsis"
                                                Visibility="{Binding NormalSpeedVisibility}" />
                                            <StackPanel
                                                Grid.Column="5"
                                                VerticalAlignment="Center"
                                                Spacing="2"
                                                Visibility="{Binding PeerSpeedVisibility}">
                                                <StackPanel
                                                    Orientation="Horizontal"
                                                    Spacing="6">
                                                    <FontIcon
                                                        Width="14"
                                                        FontSize="12"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Glyph="&#xE896;" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{Binding DownloadSpeedText}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel
                                                    Orientation="Horizontal"
                                                    Spacing="6">
                                                    <FontIcon
                                                        Width="14"
                                                        FontSize="12"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Glyph="&#xE898;" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{Binding UploadSpeedText}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="6"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                Spacing="6">
                                                <Button
                                                    Width="34"
                                                    Height="34"
                                                    MinWidth="0"
                                                    Padding="0"
                                                    Click="TaskTogglePauseResumeButton_Click"
                                                    ToolTipService.ToolTip="{Binding ToggleActionText}">
                                                    <FontIcon
                                                        FontSize="15"
                                                        Glyph="{Binding ToggleActionGlyph}" />
                                                </Button>
                                                <Button
                                                    Width="34"
                                                    Height="34"
                                                    MinWidth="0"
                                                    Padding="0"
                                                    Click="TaskOpenFileButton_Click"
                                                    ToolTipService.ToolTip="{Binding OpenFileActionText}">
                                                    <FontIcon
                                                        FontSize="15"
                                                        Glyph="&#xE8A7;" />
                                                </Button>
                                                <Button
                                                    Width="34"
                                                    Height="34"
                                                    MinWidth="0"
                                                    Padding="0"
                                                    Click="TaskOpenFolderButton_Click"
                                                    ToolTipService.ToolTip="{Binding OpenFolderActionText}">
                                                    <FontIcon
                                                        FontSize="15"
                                                        Glyph="&#xE8B7;" />
                                                </Button>
                                                <Button
                                                    Width="34"
                                                    Height="34"
                                                    MinWidth="0"
                                                    Padding="0"
                                                    Click="TaskCopyLinkButton_Click"
                                                    ToolTipService.ToolTip="{Binding CopyLinkActionText}">
                                                    <FontIcon
                                                        FontSize="15"
                                                        Glyph="&#xE71B;" />
                                                </Button>
                                                <Button
                                                    Width="34"
                                                    Height="34"
                                                    MinWidth="0"
                                                    Padding="0"
                                                    Click="TaskDeleteEntryButton_Click"
                                                    ToolTipService.ToolTip="{Binding DeleteEntryActionText}">
                                                    <FontIcon
                                                        FontSize="15"
                                                        Glyph="&#xE711;" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <ProgressBar
                                            Grid.Row="1"
                                            Height="3"
                                            Margin="0"
                                            VerticalAlignment="Bottom"
                                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                                            Foreground="{Binding ProgressBrush}"
                                            Maximum="100"
                                            Value="{Binding Progress}" />

                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CheckboxVisibilityStates">
                                                <VisualState x:Name="HideCheckbox" />
                                                <VisualState x:Name="ShowCheckbox">
                                                    <VisualState.Setters>
                                                        <Setter Target="SelectionCheckbox.Opacity" Value="1" />
                                                        <Setter Target="TaskIcon.Opacity" Value="0" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                    </Grid>
                                </UserControl>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Grid
                    x:Name="SettingsPage"
                    Visibility="Collapsed"
                    RowDefinitions="Auto,Auto,*"
                    RowSpacing="20">
                    <StackPanel Spacing="4">
                        <TextBlock
                            FontSize="28"
                            FontWeight="SemiBold"
                            x:Uid="SettingsTitleText"
                            Text="Settings" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            x:Uid="SettingsSubtitleText"
                            Text="Manage the local aria2 process and default download behavior." />
                    </StackPanel>

                    <Grid
                        Grid.Row="1"
                        ColumnDefinitions="220,*"
                        RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                        ColumnSpacing="20"
                        RowSpacing="14">
                        <TextBlock
                            x:Name="AriaPathSettingLabel"
                            VerticalAlignment="Center"
                            x:Uid="AriaPathLabel"
                            Text="aria2c path" />
                        <TextBox
                            x:Name="AriaPathTextBox"
                            Grid.Column="1"
                            x:Uid="AriaPathTextBox"
                            PlaceholderText="Leave empty to resolve aria2c.exe from PATH" />

                        <TextBlock
                            x:Name="RpcPortSettingLabel"
                            Grid.Row="1"
                            VerticalAlignment="Center"
                            x:Uid="RpcPortLabel"
                            Text="RPC port" />
                        <NumberBox
                            x:Name="RpcPortNumberBox"
                            Grid.Row="1"
                            Grid.Column="1"
                            Minimum="1"
                            Maximum="65535"
                            Value="6800" />

                        <TextBlock
                            x:Name="DefaultDirectorySettingLabel"
                            Grid.Row="2"
                            VerticalAlignment="Center"
                            x:Uid="DefaultDirectoryLabel"
                            Text="Default directory" />
                        <TextBox
                            x:Name="DownloadDirectoryTextBox"
                            Grid.Row="2"
                            Grid.Column="1" />

                        <TextBlock
                            x:Name="ProxySettingLabel"
                            Grid.Row="3"
                            VerticalAlignment="Center"
                            x:Uid="ProxyLabel"
                            Text="Proxy" />
                        <CheckBox
                            x:Name="UseSystemProxyCheckBox"
                            Grid.Row="3"
                            Grid.Column="1"
                            Checked="UseSystemProxyCheckBox_Changed"
                            Content="Use Windows system proxy when aria2 starts"
                            IsChecked="True"
                            x:Uid="UseSystemProxyCheckBox"
                            Unchecked="UseSystemProxyCheckBox_Changed" />

                        <TextBlock
                            x:Name="ProcessStatusSettingLabel"
                            Grid.Row="4"
                            VerticalAlignment="Center"
                            x:Uid="ProcessStatusLabel"
                            Text="Process status" />
                        <StackPanel
                            x:Name="ProcessStatusSettingControl"
                            Grid.Row="4"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="12">
                            <TextBlock
                                x:Name="SettingsAriaStatusText"
                                VerticalAlignment="Center"
                                x:Uid="SettingsAriaStatusText"
                                Text="Stopped" />
                            <Button
                                Click="StartAriaButton_Click"
                                x:Uid="SettingsStartButton"
                                Content="Start" />
                            <Button
                                Click="StopAriaButton_Click"
                                x:Uid="SettingsStopButton"
                                Content="Stop" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </NavigationView>

        <Border
            Grid.Row="3"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid RowDefinitions="Auto,Auto">
                <Grid
                    Padding="12,6"
                    ColumnDefinitions="Auto,*,Auto,Auto"
                    ColumnSpacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE756;" />
                        <TextBlock
                            x:Name="DebugEngineText"
                            VerticalAlignment="Center"
                            x:Uid="DebugEngineText"
                            Text="aria2 stopped" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        x:Uid="TerminalSummaryText"
                        Text="aria2 terminal output"
                        TextTrimming="CharacterEllipsis" />
                    <Button
                        x:Name="ClearTerminalButton"
                        Grid.Column="2"
                        Click="ClearTerminalButton_Click"
                        x:Uid="ClearTerminalButton"
                        Content="Clear" />
                    <ToggleButton
                        x:Name="TerminalToggleButton"
                        Grid.Column="3"
                        Checked="TerminalToggleButton_Changed"
                        Content="Terminal"
                        x:Uid="TerminalToggleButton"
                        Unchecked="TerminalToggleButton_Changed" />
                </Grid>

                <Border
                    x:Name="TerminalPanel"
                    Grid.Row="1"
                    Height="180"
                    Padding="12"
                    Background="#FF1E1E1E"
                    Visibility="Collapsed">
                    <ScrollViewer
                        x:Name="TerminalScrollViewer"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto">
                        <TextBlock
                            x:Name="TerminalTextBlock"
                            FontFamily="Cascadia Mono, Consolas"
                            FontSize="12"
                            Foreground="#FFD4D4D4"
                            x:Uid="TerminalTextBlock"
                            Text="aria2 terminal output will appear here."
                            TextWrapping="NoWrap" />
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
