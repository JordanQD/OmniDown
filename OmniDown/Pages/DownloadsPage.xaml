<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OmniDown.Pages.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OmniDown.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:OmniDown.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.Labs.WinUI"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="TaskDetailsSectionTitleTextBlockStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,18,0,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="TaskDetailsPropertyNameTextBlockStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="TaskDetailsPropertyValueTextBlockStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>
        <Style x:Key="TaskDetailsPropertyRowBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="0,8" />
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style x:Key="CompactFilterTokenItemStyle" TargetType="toolkit:TokenItem">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Page.Resources>

    <Grid
        x:Name="_tasksContentHost"
        Grid.Column="0"
        Padding="0"
        RowDefinitions="Auto,*,Auto"
        RowSpacing="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition
                x:Name="_taskDetailsHostColumn"
                Width="0" />
        </Grid.ColumnDefinitions>
        <Border
            x:Name="_tasksHeaderPanel"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="8,8,8,0"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            BackgroundSizing="InnerBorderEdge"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid
                Padding="0"
                ColumnDefinitions="Auto,*,Auto"
                RowDefinitions="Auto,Auto,Auto"
                RowSpacing="0">
            <StackPanel
                Spacing="4"
                Visibility="Collapsed">
                <TextBlock 
                    x:Name="_downloadsTitleText"
                    FontSize="28"
                    FontWeight="SemiBold"
                    x:Uid="DownloadsTitleText"
                    Text="Downloads" />
            </StackPanel>

            <CommandBar
                Grid.Column="0"
                Background="Transparent"
                HorizontalAlignment="Left"
                DefaultLabelPosition="Right"
                IsOpen="False">
                <CommandBar.PrimaryCommands>
                    <AppBarButton
                        x:Name="_newDownloadButton"
                        Click="NewDownloadButton_Click"
                        x:Uid="NewDownloadButton"
                        Label="New">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE710;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarSeparator />
                    <AppBarButton
                        x:Name="_resumeTasksButton"
                        Click="ResumeTasksButton_Click"
                        IsEnabled="False"
                        x:Uid="ResumeTasksButton"
                        Label="Resume">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE768;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Name="_pauseTasksButton"
                        Click="PauseTasksButton_Click"
                        IsEnabled="False"
                        x:Uid="PauseTasksButton"
                        Label="Pause">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE769;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Name="_recoverTasksButton"
                        Click="RecoverTasksButton_Click"
                        IsEnabled="False"
                        x:Uid="RecoverTasksButton"
                        Label="Recover">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE72C;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarSeparator />
                    <AppBarButton
                        x:Name="_deleteTasksButton"
                        Click="DeleteTasksButton_Click"
                        IsEnabled="False"
                        x:Uid="DeleteTasksButton"
                        Label="Delete">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE74D;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarSeparator />
                    <AppBarButton
                        x:Name="_sortTasksButton"
                        AutomationProperties.Name="Sort"
                        MinWidth="88"
                        Label="Sort"
                        LabelPosition="Collapsed"
                        ToolTipService.ToolTip="Sort"
                        VerticalAlignment="Center"
                        x:Uid="SortTasksButton">
                        <AppBarButton.Content>
                            <StackPanel
                                Margin="6,0"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                                <FontIcon
                                    FontSize="18"
                                    Glyph="&#xE8CB;" />
                                <TextBlock 
                                    FontSize="15"
                                    x:Uid="SortTasksButtonLabel"
                                    Text="Sort" />
                                <FontIcon
                                    FontSize="12"
                                    Glyph="&#xE76C;" />
                            </StackPanel>
                        </AppBarButton.Content>
                        <AppBarButton.Flyout>
                            <MenuFlyout
                                Opening="SortMenuFlyout_Opening"
                                Placement="BottomEdgeAlignedLeft">
                                <ToggleMenuFlyoutItem
                                    x:Name="_sortByCreatedAtMenuItem"
                                    Click="SortColumnMenuItem_Click"
                                    x:Uid="SortByCreatedAtMenuItem"
                                    Tag="CreatedAt"
                                    Text="Added time" />
                                <ToggleMenuFlyoutItem
                                    x:Name="_sortByNameMenuItem"
                                    Click="SortColumnMenuItem_Click"
                                    x:Uid="SortByNameMenuItem"
                                    Tag="Name"
                                    Text="Name" />
                                <ToggleMenuFlyoutItem
                                    x:Name="_sortBySizeMenuItem"
                                    Click="SortColumnMenuItem_Click"
                                    x:Uid="SortBySizeMenuItem"
                                    Tag="Size"
                                    Text="Size" />
                                <MenuFlyoutSeparator />
                                <ToggleMenuFlyoutItem
                                    x:Name="_sortAscendingMenuItem"
                                    Click="SortDirectionMenuItem_Click"
                                    x:Uid="SortAscendingMenuItem"
                                    Tag="Ascending"
                                    Text="Ascending" />
                                <ToggleMenuFlyoutItem
                                    x:Name="_sortDescendingMenuItem"
                                    Click="SortDirectionMenuItem_Click"
                                    x:Uid="SortDescendingMenuItem"
                                    Tag="Descending"
                                    Text="Descending" />
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>
                    <AppBarToggleButton
                        x:Name="_taskFilterButton"
                        AutomationProperties.Name="筛选"
                        Click="TaskFilterButton_Click"
                        Label="筛选"
                        ToolTipService.ToolTip="筛选">
                        <AppBarToggleButton.Icon>
                            <FontIcon Glyph="&#xE71C;" />
                        </AppBarToggleButton.Icon>
                    </AppBarToggleButton>
                </CommandBar.PrimaryCommands>
                <CommandBar.SecondaryCommands>
                    <AppBarButton
                        x:Name="_openSelectedTaskFileButton"
                        Click="OpenSelectedTaskFileButton_Click"
                        IsEnabled="False"
                        x:Uid="OpenSelectedTaskFileButton"
                        Label="Open file">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE8A7;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Name="_openSelectedTaskFolderButton"
                        Click="OpenSelectedTaskFolderButton_Click"
                        IsEnabled="False"
                        x:Uid="OpenSelectedTaskFolderButton"
                        Label="Open folder">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE8B7;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Name="_copySelectedTaskLinksButton"
                        Click="CopySelectedTaskLinksButton_Click"
                        IsEnabled="False"
                        x:Uid="CopySelectedTaskLinksButton"
                        Label="Copy link">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE71B;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarSeparator />
                    <AppBarButton
                        x:Name="_clearCompletedTasksButton"
                        Click="ClearCompletedTasksButton_Click"
                        x:Uid="ClearCompletedTasksButton"
                        Label="Clear completed records">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE894;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar.SecondaryCommands>
            </CommandBar>

            <CommandBar
                Grid.Column="2"
                Background="Transparent"
                DefaultLabelPosition="Right"
                IsOpen="False">
                <CommandBar.PrimaryCommands>
                    <AppBarButton
                        x:Name="_taskDetailsButton"
                        Click="TaskDetailsButton_Click"
                        x:Uid="TaskDetailsButton"
                        Label="Details"
                        ToolTipService.ToolTip="Details">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE946;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar.PrimaryCommands>
            </CommandBar>

            <Grid
                x:Name="_taskFilterPanel"
                Grid.Row="1"
                Grid.ColumnSpan="3"
                Margin="12,0,0,4"
                ColumnDefinitions="44,*"
                ColumnSpacing="8"
                Visibility="Collapsed">
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="状态" />
                <toolkit:TokenView
                    x:Name="_taskStatusFilterTokenView"
                    Grid.Column="1"
                    AutomationProperties.Name="下载状态筛选"
                    CanRemoveTokens="False"
                    IsWrapped="False"
                    SelectedIndex="0"
                    SelectionChanged="TaskStatusFilterTokenView_SelectionChanged"
                    SelectionMode="Single">
                    <toolkit:TokenItem Content="全部" Style="{StaticResource CompactFilterTokenItemStyle}" Tag="Home" />
                    <toolkit:TokenItem Content="下载中" Style="{StaticResource CompactFilterTokenItemStyle}" Tag="Downloading">
                        <toolkit:TokenItem.Icon>
                            <FontIcon Glyph="&#xE896;" />
                        </toolkit:TokenItem.Icon>
                    </toolkit:TokenItem>
                    <toolkit:TokenItem Content="等待中" Style="{StaticResource CompactFilterTokenItemStyle}" Tag="Waiting">
                        <toolkit:TokenItem.Icon>
                            <FontIcon Glyph="&#xE823;" />
                        </toolkit:TokenItem.Icon>
                    </toolkit:TokenItem>
                    <toolkit:TokenItem Content="暂停中" Style="{StaticResource CompactFilterTokenItemStyle}" Tag="Paused">
                        <toolkit:TokenItem.Icon>
                            <FontIcon Glyph="&#xE769;" />
                        </toolkit:TokenItem.Icon>
                    </toolkit:TokenItem>
                    <toolkit:TokenItem Content="异常" Style="{StaticResource CompactFilterTokenItemStyle}" Tag="Issues">
                        <toolkit:TokenItem.Icon>
                            <FontIcon Glyph="&#xE7BA;" />
                        </toolkit:TokenItem.Icon>
                    </toolkit:TokenItem>
                </toolkit:TokenView>
            </Grid>

            <Grid
                x:Name="_taskCategoryFilterPanel"
                Grid.Row="2"
                Grid.ColumnSpan="3"
                Margin="12,0,0,8"
                ColumnDefinitions="44,*"
                ColumnSpacing="8"
                Visibility="Collapsed">
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="类别" />
                <toolkit:TokenView
                    x:Name="_taskCategoryFilterTokenView"
                    Grid.Column="1"
                    AutomationProperties.Name="下载类别筛选"
                    CanRemoveTokens="False"
                    IsWrapped="False"
                    SelectedIndex="0"
                    SelectionChanged="TaskCategoryFilterTokenView_SelectionChanged"
                    SelectionMode="Single">
                    <toolkit:TokenItem Content="全部" Style="{StaticResource CompactFilterTokenItemStyle}" Tag="All" />
                    <toolkit:TokenItem Content="图片" Style="{StaticResource CompactFilterTokenItemStyle}" Tag="Images">
                        <toolkit:TokenItem.Icon>
                            <FontIcon Glyph="&#xE91B;" />
                        </toolkit:TokenItem.Icon>
                    </toolkit:TokenItem>
                    <toolkit:TokenItem Content="视频" Style="{StaticResource CompactFilterTokenItemStyle}" Tag="Videos">
                        <toolkit:TokenItem.Icon>
                            <FontIcon Glyph="&#xE714;" />
                        </toolkit:TokenItem.Icon>
                    </toolkit:TokenItem>
                    <toolkit:TokenItem Content="音频" Style="{StaticResource CompactFilterTokenItemStyle}" Tag="Audio">
                        <toolkit:TokenItem.Icon>
                            <FontIcon Glyph="&#xE8D6;" />
                        </toolkit:TokenItem.Icon>
                    </toolkit:TokenItem>
                    <toolkit:TokenItem Content="文档" Style="{StaticResource CompactFilterTokenItemStyle}" Tag="Documents">
                        <toolkit:TokenItem.Icon>
                            <FontIcon Glyph="&#xE8A5;" />
                        </toolkit:TokenItem.Icon>
                    </toolkit:TokenItem>
                    <toolkit:TokenItem Content="压缩文件" Style="{StaticResource CompactFilterTokenItemStyle}" Tag="Archives">
                        <toolkit:TokenItem.Icon>
                            <FontIcon Glyph="&#xF012;" />
                        </toolkit:TokenItem.Icon>
                    </toolkit:TokenItem>
                    <toolkit:TokenItem Content="应用" Style="{StaticResource CompactFilterTokenItemStyle}" Tag="Apps">
                        <toolkit:TokenItem.Icon>
                            <FontIcon Glyph="&#xECAA;" />
                        </toolkit:TokenItem.Icon>
                    </toolkit:TokenItem>
                    <toolkit:TokenItem Content="文件夹" Style="{StaticResource CompactFilterTokenItemStyle}" Tag="Folders">
                        <toolkit:TokenItem.Icon>
                            <FontIcon Glyph="&#xE8B7;" />
                        </toolkit:TokenItem.Icon>
                    </toolkit:TokenItem>
                    <toolkit:TokenItem Content="其他" Style="{StaticResource CompactFilterTokenItemStyle}" Tag="Other">
                        <toolkit:TokenItem.Icon>
                            <FontIcon Glyph="&#xE946;" />
                        </toolkit:TokenItem.Icon>
                    </toolkit:TokenItem>
                </toolkit:TokenView>
            </Grid>
            </Grid>
        </Border>
        <Border
            x:Name="_tasksPageSurface"
            Grid.Column="0"
            Grid.Row="1"
            Margin="8,0,8,0"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            BackgroundSizing="InnerBorderEdge"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="0">
        <Grid
            x:Name="_tasksPage"
            RowDefinitions="Auto,Auto,*">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="0" />
            </Grid.ColumnDefinitions>

        <Grid
            x:Name="_statsPanel"
            Grid.Row="0"
            Margin="0,20,0,14"
            ColumnDefinitions="*,*,*,*,*,Auto"
            Visibility="{x:Bind local:DownloadsPage.BoolToVisibility(ViewModel.IsStatsPanelVisible), Mode=OneWay}">
            <StackPanel
                x:Name="_totalMetricPanel"
                Margin="0,8,0,0"
                Spacing="4">
                <TextBlock 
                    x:Name="_totalMetricLabelText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    x:Uid="TotalMetricLabel"
                    Text="Total" />
                <TextBlock 
                    x:Name="_totalTasksText"
                    FontSize="24"
                    FontWeight="SemiBold"
                    Text="{x:Bind ViewModel.TotalTasksText, Mode=OneWay}" />
            </StackPanel>
            <StackPanel
                x:Name="_activeMetricPanel"
                Grid.Column="1"
                Margin="0,8,0,0"
                Spacing="4">
                <TextBlock 
                    x:Name="_activeMetricLabelText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    x:Uid="ActiveMetricLabel"
                    Text="Downloading" />
                <TextBlock 
                    x:Name="_activeTasksText"
                    FontSize="24"
                    FontWeight="SemiBold"
                    Text="{x:Bind ViewModel.ActiveTasksText, Mode=OneWay}" />
            </StackPanel>
            <StackPanel
                x:Name="_pausedMetricPanel"
                Grid.Column="2"
                Margin="0,8,0,0"
                Spacing="4">
                <TextBlock 
                    x:Name="_pausedMetricLabelText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Paused" />
                <TextBlock 
                    x:Name="_pausedTasksText"
                    FontSize="24"
                    FontWeight="SemiBold"
                    Text="{x:Bind ViewModel.PausedTasksText, Mode=OneWay}" />
            </StackPanel>
            <StackPanel
                x:Name="_completedMetricPanel"
                Grid.Column="3"
                Margin="0,8,0,0"
                Spacing="4"
                Visibility="{x:Bind local:DownloadsPage.BoolToVisibility(ViewModel.IsCompletedMetricVisible), Mode=OneWay}">
                <TextBlock 
                    x:Name="_completedMetricLabelText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    x:Uid="DownloadSpeedMetricLabel"
                    Text="Completed" />
                <TextBlock 
                    x:Name="_completedTasksText"
                    FontSize="24"
                    FontWeight="SemiBold"
                    Text="{x:Bind ViewModel.CompletedTasksText, Mode=OneWay}" />
            </StackPanel>
            <StackPanel
                x:Name="_issueMetricPanel"
                Grid.Column="4"
                Margin="0,8,0,0"
                Spacing="4"
                Visibility="{x:Bind local:DownloadsPage.BoolToVisibility(ViewModel.IsIssueMetricVisible), Mode=OneWay}">
                <TextBlock 
                    x:Name="_issueMetricLabelText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    x:Uid="Aria2MetricLabel"
                    Text="Issues" />
                <TextBlock 
                    x:Name="_issueTasksText"
                    FontSize="24"
                    FontWeight="SemiBold"
                    Text="{x:Bind ViewModel.IssueTasksText, Mode=OneWay}" />
            </StackPanel>
            <DropDownButton
                x:Name="_speedLimitButton"
                Grid.Column="5"
                MinWidth="292"
                Margin="-14,0,0,0"
                Padding="14,8,14,6"
                HorizontalAlignment="Right"
                HorizontalContentAlignment="Left"
                VerticalAlignment="Top"
                AutomationProperties.Name="Realtime speed and speed limit"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                Click="SpeedLimitButton_Click"
                x:Uid="SpeedLimitButton">
                <DropDownButton.Content>
                    <Grid
                        Width="264"
                        RowDefinitions="Auto,Auto,16"
                        RowSpacing="4">
                        <TextBlock 
                            HorizontalAlignment="Left"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            x:Uid="RealtimeSpeedLabel"
                            Text="Realtime speed" />
                        <StackPanel
                            Grid.Row="1"
                            HorizontalAlignment="Left"
                            Orientation="Horizontal"
                            Spacing="18">
                            <Grid
                                ColumnDefinitions="22,96">
                                <Grid
                                    Width="22"
                                    HorizontalAlignment="Center">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        FontSize="16"
                                        Glyph="&#xE74A;" />
                                </Grid>
                                <TextBlock 
                                    x:Name="_globalUploadSpeedText"
                                    Grid.Column="1"
                                    Width="96"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    TextTrimming="CharacterEllipsis"
                                    Text="{x:Bind ViewModel.GlobalUploadSpeedText, Mode=OneWay}" />
                            </Grid>
                            <Grid
                                ColumnDefinitions="22,96">
                                <Grid
                                    Width="22"
                                    HorizontalAlignment="Center">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        FontSize="16"
                                        Glyph="&#xE74B;" />
                                </Grid>
                                <TextBlock 
                                    x:Name="_globalDownloadSpeedText"
                                    Grid.Column="1"
                                    Width="96"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    TextTrimming="CharacterEllipsis"
                                    Text="{x:Bind ViewModel.GlobalDownloadSpeedText, Mode=OneWay}" />
                            </Grid>
                        </StackPanel>
                        <StackPanel
                            Grid.Row="2"
                            HorizontalAlignment="Left"
                            Orientation="Horizontal"
                            Spacing="18">
                            <Grid
                                ColumnDefinitions="22,96">
                                <Grid
                                    x:Name="_globalUploadLimitIconPanel"
                                    Width="22"
                                    HorizontalAlignment="Center"
                                    Opacity="{x:Bind local:DownloadsPage.BoolToOpacity(ViewModel.IsGlobalUploadLimitIconVisible), Mode=OneWay}">
                                    <Grid
                                        Width="22"
                                        HorizontalAlignment="Center">
                                        <FontIcon
                                            HorizontalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="&#xE72E;" />
                                    </Grid>
                                </Grid>
                                <TextBlock 
                                    x:Name="_globalUploadLimitText"
                                    Grid.Column="1"
                                    Width="96"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Opacity="{x:Bind local:DownloadsPage.BoolToOpacity(ViewModel.IsGlobalUploadLimitIconVisible), Mode=OneWay}"
                                    Text="{x:Bind ViewModel.GlobalUploadLimitText, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <Grid
                                ColumnDefinitions="22,96">
                                <Grid
                                    x:Name="_globalDownloadLimitIconPanel"
                                    Width="22"
                                    HorizontalAlignment="Center"
                                    Opacity="{x:Bind local:DownloadsPage.BoolToOpacity(ViewModel.IsGlobalDownloadLimitIconVisible), Mode=OneWay}">
                                    <Grid
                                        Width="22"
                                        HorizontalAlignment="Center">
                                        <FontIcon
                                            HorizontalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="&#xE72E;" />
                                    </Grid>
                                </Grid>
                                <TextBlock 
                                    x:Name="_globalDownloadLimitText"
                                    Grid.Column="1"
                                    Width="96"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Opacity="{x:Bind local:DownloadsPage.BoolToOpacity(ViewModel.IsGlobalDownloadLimitIconVisible), Mode=OneWay}"
                                    Text="{x:Bind ViewModel.GlobalDownloadLimitText, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </DropDownButton.Content>
                <DropDownButton.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight">
                        <StackPanel
                            Width="280"
                            Spacing="12">
                            <StackPanel Spacing="8">
                                <Grid
                                    Width="280"
                                    ColumnDefinitions="*,92"
                                    ColumnSpacing="8">
                                    <TextBlock 
                                        VerticalAlignment="Center"
                                        x:Uid="UploadLimitLabel"
                                        Text="Upload limit" />
                                    <ToggleSwitch
                                        x:Name="_uploadLimitToggleSwitch"
                                        Grid.Column="1"
                                        Width="48"
                                        MinWidth="0"
                                        Padding="0"
                                        HorizontalAlignment="Right"
                                        OffContent=""
                                        OnContent=""
                                        Toggled="UploadLimitToggleSwitch_Toggled" />
                                </Grid>
                                <Grid ColumnDefinitions="168,*" ColumnSpacing="8">
                                    <NumberBox
                                        x:Name="_uploadLimitNumberBox"
                                        IsEnabled="False"
                                        Height="32"
                                        Minimum="1"
                                        SmallChange="128"
                                        LargeChange="1024"
                                        SpinButtonPlacementMode="Inline"
                                        Value="1024" />
                                    <ComboBox
                                        x:Name="_uploadLimitUnitComboBox"
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        IsEnabled="False"
                                        SelectedIndex="0">
                                        <ComboBoxItem Content="KB/s" />
                                        <ComboBoxItem Content="MB/s" />
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <Grid
                                    Width="280"
                                    ColumnDefinitions="*,92"
                                    ColumnSpacing="8">
                                    <TextBlock 
                                        VerticalAlignment="Center"
                                        x:Uid="DownloadLimitLabel"
                                        Text="Download limit" />
                                    <ToggleSwitch
                                        x:Name="_downloadLimitToggleSwitch"
                                        Grid.Column="1"
                                        Width="48"
                                        MinWidth="0"
                                        Padding="0"
                                        HorizontalAlignment="Right"
                                        OffContent=""
                                        OnContent=""
                                        Toggled="DownloadLimitToggleSwitch_Toggled" />
                                </Grid>
                                <Grid ColumnDefinitions="168,*" ColumnSpacing="8">
                                    <NumberBox
                                        x:Name="_downloadLimitNumberBox"
                                        IsEnabled="False"
                                        Height="32"
                                        Minimum="1"
                                        SmallChange="128"
                                        LargeChange="1024"
                                        SpinButtonPlacementMode="Inline"
                                        Value="1024" />
                                    <ComboBox
                                        x:Name="_downloadLimitUnitComboBox"
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        IsEnabled="False"
                                        SelectedIndex="0">
                                        <ComboBoxItem Content="KB/s" />
                                        <ComboBoxItem Content="MB/s" />
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                            <Button
                                HorizontalAlignment="Right"
                                Click="ApplySpeedLimitButton_Click"
                                Content="Apply"
                                x:Uid="ApplySpeedLimitButton" />
                        </StackPanel>
                    </Flyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>

        <Border
            x:Name="_tasksListHeaderPanel"
            Grid.Row="1"
            Margin="0"
            Background="Transparent">
            <Grid
                MinHeight="38"
                Padding="0,0,20,0"
                ColumnDefinitions="48,2*,0.75*,1*,0.8*,1.1*"
                ColumnSpacing="16">
                <CheckBox
                    x:Name="_selectAllTasksCheckBox"
                    Width="20"
                    Height="20"
                    MinWidth="0"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Checked="SelectAllTasksCheckBox_Checked"
                    Indeterminate="SelectAllTasksCheckBox_Indeterminate"
                    IsThreeState="True"
                    Unchecked="SelectAllTasksCheckBox_Unchecked" />
                <TextBlock 
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    x:Uid="NameColumnHeader"
                    Text="Name"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock 
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    x:Uid="StatusColumnHeader"
                    Text="Status"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock 
                    Grid.Column="3"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    x:Uid="ProgressColumnHeader"
                    Text="Progress"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock 
                    Grid.Column="4"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    x:Uid="RemainingTimeColumnHeader"
                    Text="Remaining"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock 
                    Grid.Column="5"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    x:Uid="SpeedColumnHeader"
                    Text="Speed"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <ListView
                x:Name="_tasksListView"
                Background="Transparent"
                IsMultiSelectCheckBoxEnabled="False"
                PointerPressed="TasksListView_PointerPressed"
                RightTapped="TasksListView_RightTapped"
                SelectionChanged="TasksListView_SelectionChanged"
                SelectionMode="Extended">
                <ListView.Resources>
                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ListViewItemBorderBrushSelected" Color="Transparent" />
                    <SolidColorBrush x:Key="ListViewItemBorderBrushSelectedPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ListViewItemBorderBrushSelectedPressed" Color="Transparent" />
                </ListView.Resources>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="MinHeight" Value="52" />
                        <Setter Property="Margin" Value="0,0,0,4" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemContainerTransitions>
                    <TransitionCollection />
                </ListView.ItemContainerTransitions>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <UserControl Loaded="TaskItem_Loaded">
                            <Border
                                MinHeight="52"
                                Background="{Binding TaskItemBackground}"
                                BorderBrush="{Binding TaskItemBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Grid RowDefinitions="49,3">
                                    <Border
                                        x:Name="SelectionAccent"
                                        Grid.Row="0"
                                        Width="4"
                                        Height="24"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="2"
                                        Opacity="{Binding SelectionIndicatorOpacity}" />
                                    <Grid
                                        Grid.Row="0"
                                        Padding="0,0,20,0"
                                        ColumnDefinitions="48,2*,0.75*,1*,0.8*,1.1*"
                                        ColumnSpacing="16">
                                        <Grid
                                            Width="40"
                                            Height="40"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            PointerCanceled="TaskIconSelectionBox_PointerExited"
                                            PointerEntered="TaskIconSelectionBox_PointerEntered"
                                            PointerExited="TaskIconSelectionBox_PointerExited">
                                            <FontIcon
                                                x:Name="TaskIcon"
                                                Width="18"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="16"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Glyph="&#xE7C3;"
                                                Opacity="{Binding TaskIconOpacity}" />
                                            <CheckBox
                                                x:Name="SelectionCheckbox"
                                                Width="20"
                                                Height="20"
                                                MinWidth="0"
                                                Padding="0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Checked="TaskCheckBox_Changed"
                                                Content=""
                                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                Opacity="{Binding SelectionCheckboxOpacity}"
                                                Unchecked="TaskCheckBox_Changed" />
                                        </Grid>
                                        <TextBlock 
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Foreground="{Binding NameBrush}"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock 
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Foreground="{Binding StatusBrush}"
                                            Text="{Binding StatusText}"
                                            TextTrimming="CharacterEllipsis" />
                                        <StackPanel
                                            Grid.Column="3"
                                            VerticalAlignment="Center"
                                            Spacing="1">
                                            <TextBlock 
                                                FontWeight="SemiBold"
                                                Foreground="{Binding ProgressBrush}"
                                                Text="{Binding ProgressText}"
                                                TextAlignment="Left" />
                                            <TextBlock 
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Text="{Binding TransferredSizeText}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock 
                                            Grid.Column="4"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding RemainingTimeText}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock 
                                            Grid.Column="5"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding DownloadSpeedText}"
                                            TextTrimming="CharacterEllipsis"
                                            Visibility="{Binding NormalSpeedVisibility}" />
                                        <StackPanel
                                            Grid.Column="5"
                                            VerticalAlignment="Center"
                                            Spacing="2"
                                            Visibility="{Binding PeerSpeedVisibility}">
                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="6">
                                                <FontIcon
                                                    Width="14"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Glyph="&#xE74A;" />
                                                <TextBlock 
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding UploadSpeedText}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="6">
                                                <FontIcon
                                                    Width="14"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Glyph="&#xE74B;" />
                                                <TextBlock 
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding DownloadSpeedText}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                    <ProgressBar
                                        Grid.Row="1"
                                        Height="3"
                                        Margin="0"
                                        VerticalAlignment="Bottom"
                                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                                        Foreground="{Binding ProgressBrush}"
                                        IsIndeterminate="{Binding IsOperationPending}"
                                        Maximum="100"
                                        Value="{Binding Progress}" />

                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CheckboxVisibilityStates">
                                            <VisualState x:Name="HideCheckbox" />
                                            <VisualState x:Name="ShowCheckbox">
                                                <VisualState.Setters>
                                                    <Setter Target="SelectionAccent.Opacity" Value="1" />
                                                    <Setter Target="SelectionCheckbox.Opacity" Value="1" />
                                                    <Setter Target="TaskIcon.Opacity" Value="0" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                </Grid>
                            </Border>
                        </UserControl>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid
                x:Name="_tasksLoadingPanel"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                Visibility="Visible">
                <ProgressRing
                    x:Name="_tasksLoadingRing"
                    Width="36"
                    Height="36"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Loading downloads"
                    IsActive="True"
                    x:Uid="TasksLoadingRing" />
            </Grid>

            </Grid>

        </Grid>
        </Border>


    <controls:TaskDetailsPaneControl
        x:Name="_taskDetailsPane"
        Grid.Column="1"
        Grid.Row="1"
        Margin="0,0,8,0"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Visibility="Collapsed" />
    <Grid
        Grid.Row="2"
        Grid.ColumnSpan="2"
        RowDefinitions="*,Auto">
        <Border
            x:Name="_statusBarPanel"
            Grid.Row="1"
            Background="{ThemeResource RailNavigationViewDefaultPaneBackground}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid RowDefinitions="Auto,Auto">
                <Grid
                MinHeight="40"
                Padding="16,0,8,0"
                ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto"
                ColumnSpacing="12">
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="12">
                    <TextBlock 
                        x:Name="_statusBarItemCountText"
                        VerticalAlignment="Center"
                        Text="{x:Bind ViewModel.StatusBarItemCountText, Mode=OneWay}" />
                    <Rectangle
                        x:Name="_statusBarSelectedCountDivider"
                        Width="1"
                        Height="18"
                        VerticalAlignment="Center"
                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                        Visibility="{x:Bind local:DownloadsPage.BoolToVisibility(ViewModel.IsStatusBarSelectedCountVisible), Mode=OneWay}" />
                    <TextBlock 
                        x:Name="_statusBarSelectedCountText"
                        VerticalAlignment="Center"
                        Text="{x:Bind ViewModel.StatusBarSelectedCountText, Mode=OneWay}"
                        Visibility="{x:Bind local:DownloadsPage.BoolToVisibility(ViewModel.IsStatusBarSelectedCountVisible), Mode=OneWay}" />
                </StackPanel>
                <Rectangle
                    x:Name="_statusBarTaskCountsDivider"
                    Grid.Column="1"
                    Width="1"
                    Height="18"
                    VerticalAlignment="Center"
                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Visibility="{x:Bind local:DownloadsPage.BoolToVisibility(ViewModel.IsStatusBarTaskCountsPanelVisible), Mode=OneWay}" />
                <StackPanel
                    x:Name="_statusBarTaskCountsPanel"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="12"
                    Visibility="{x:Bind local:DownloadsPage.BoolToVisibility(ViewModel.IsStatusBarTaskCountsPanelVisible), Mode=OneWay}">
                    <Grid ColumnDefinitions="16,Auto" ColumnSpacing="4">
                        <FontIcon
                            Width="16"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Glyph="&#xE768;" />
                        <TextBlock 
                            x:Name="_statusBarActiveTasksText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="{x:Bind ViewModel.StatusBarActiveTasksText, Mode=OneWay}" />
                    </Grid>
                    <Grid ColumnDefinitions="16,Auto" ColumnSpacing="4">
                        <FontIcon
                            Width="16"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Glyph="&#xE769;" />
                        <TextBlock 
                            x:Name="_statusBarPausedTasksText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="{x:Bind ViewModel.StatusBarPausedTasksText, Mode=OneWay}" />
                    </Grid>
                    <Grid
                        x:Name="_statusBarIssueTasksPanel"
                        ColumnDefinitions="16,Auto"
                        ColumnSpacing="4"
                        Visibility="{x:Bind local:DownloadsPage.BoolToVisibility(ViewModel.IsStatusBarIssueTasksPanelVisible), Mode=OneWay}">
                        <FontIcon
                            Width="16"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Glyph="&#xE7BA;" />
                        <TextBlock 
                            x:Name="_statusBarIssueTasksText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="{x:Bind ViewModel.StatusBarIssueTasksText, Mode=OneWay}" />
                    </Grid>
                </StackPanel>
                <StackPanel
                    x:Name="_statusBarSpeedPanel"
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="12"
                    Visibility="{x:Bind local:DownloadsPage.BoolToVisibility(ViewModel.IsStatusBarSpeedPanelVisible), Mode=OneWay}">
                    <Rectangle
                        Width="1"
                        Height="18"
                        VerticalAlignment="Center"
                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Button
                        x:Name="_statusBarSpeedButton"
                        Padding="0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Click="StatusBarSpeedButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="0">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                            <Grid ColumnDefinitions="16,Auto,Auto" ColumnSpacing="4">
                                <FontIcon
                                    Width="16"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Glyph="&#xE74A;" />
                                <TextBlock 
                                    x:Name="_statusBarUploadSpeedText"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind ViewModel.StatusBarUploadSpeedText, Mode=OneWay}" />
                                <StackPanel
                                    x:Name="_statusBarUploadLimitPanel"
                                    Grid.Column="2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    Visibility="{x:Bind local:DownloadsPage.BoolToVisibility(ViewModel.IsStatusBarUploadLimitVisible), Mode=OneWay}">
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE72E;" />
                                    <TextBlock 
                                        x:Name="_statusBarUploadLimitText"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ViewModel.StatusBarUploadLimitText, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="16,Auto,Auto" ColumnSpacing="4">
                                <FontIcon
                                    Width="16"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Glyph="&#xE74B;" />
                                <TextBlock 
                                    x:Name="_statusBarDownloadSpeedText"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind ViewModel.StatusBarDownloadSpeedText, Mode=OneWay}" />
                                <StackPanel
                                    x:Name="_statusBarDownloadLimitPanel"
                                    Grid.Column="2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    Visibility="{x:Bind local:DownloadsPage.BoolToVisibility(ViewModel.IsStatusBarDownloadLimitVisible), Mode=OneWay}">
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE72E;" />
                                    <TextBlock 
                                        x:Name="_statusBarDownloadLimitText"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ViewModel.StatusBarDownloadLimitText, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>
                            </StackPanel>
                            <FontIcon
                            x:Name="_statusBarSpeedChevron"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="8"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE70D;"
                            RenderTransformOrigin="0.5,0.5" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Button
                    x:Name="_notificationHistoryButton"
                    Grid.Column="5"
                    Width="32"
                    Height="32"
                    MinWidth="32"
                    Padding="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="NotificationHistoryButton"
                    x:Uid="NotificationHistoryButton">
                    <FontIcon FontSize="14" Glyph="&#xE7F4;" />
                    <Button.Flyout>
                        <Flyout Placement="TopEdgeAlignedRight">
                            <Grid
                                Width="380"
                                MaxHeight="420"
                                RowDefinitions="Auto,*"
                                RowSpacing="8">
                                <TextBlock 
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    x:Uid="NotificationHistoryTitleText"
                                    Text="Notifications" />
                                <ListView
                                    x:Name="_notificationHistoryListView"
                                    Grid.Row="1"
                                    MaxHeight="380"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid
                                                Padding="0,8"
                                                ColumnDefinitions="Auto,*"
                                                ColumnSpacing="10">
                                                <FontIcon
                                                    Width="20"
                                                    VerticalAlignment="Top"
                                                    FontSize="15"
                                                    Foreground="{Binding SeverityBrush}"
                                                    Glyph="{Binding SeverityGlyph}" />
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Spacing="2">
                                                    <TextBlock 
                                                        FontWeight="SemiBold"
                                                        Foreground="{Binding SeverityBrush}"
                                                        Text="{Binding SeverityText}" />
                                                    <TextBlock 
                                                        Text="{Binding Message}"
                                                        TextWrapping="WrapWholeWords" />
                                                    <TextBlock 
                                                        FontSize="12"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{Binding DetailText}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                </Grid>

                <Grid Visibility="Collapsed">
                    <TextBlock x:Name="_debugEngineText" />
                </Grid>
            </Grid>
        </Border>
    </Grid>

    <InfoBar
        x:Name="_statusToastInfoBar"
        Grid.Row="1"
        Grid.ColumnSpan="2"
        AutomationProperties.AutomationId="StatusToastInfoBar"
        Width="420"
        Margin="0,0,16,8"
        HorizontalAlignment="Right"
        VerticalAlignment="Bottom"
        Closed="StatusToastInfoBar_Closed"
        IsOpen="False"
        Severity="Informational"
        Visibility="Collapsed">
        <InfoBar.ActionButton>
            <Button
                x:Name="_statusToastActionButton"
                AutomationProperties.AutomationId="StatusToastActionButton"
                Click="StatusToastActionButton_Click"
                Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon
                        x:Name="_statusToastActionIcon"
                        FontSize="14"
                        Glyph="&#xE8C8;" />
                    <TextBlock 
                        x:Name="_statusToastActionText"
                        x:Uid="StatusToastCopyButtonLabel"
                        Text="Copy" />
                </StackPanel>
            </Button>
        </InfoBar.ActionButton>
    </InfoBar>

    <TeachingTip
        x:Name="_settingsSaveTeachingTip"
        Grid.Row="1"
        Title="保存设置？"
        Subtitle="设置已修改。保存后才会写入配置；取消会恢复原来的值。"
        ActionButtonContent="保存"
        CloseButtonContent="取消"
        ActionButtonClick="SettingsSaveTeachingTip_ActionButtonClick"
        CloseButtonClick="SettingsSaveTeachingTip_CloseButtonClick"
        IsLightDismissEnabled="False"
        PlacementMargin="20"
        PreferredPlacement="Auto" />

    <TeachingTip
        x:Name="_ariaRestartTeachingTip"
        Grid.Row="1"
        Title="重启 aria2？"
        Subtitle="这些设置需要重启 aria2 后生效。取消会恢复到重启前的设置。"
        ActionButtonContent="重启"
        CloseButtonContent="取消"
        ActionButtonClick="AriaRestartTeachingTip_ActionButtonClick"
        CloseButtonClick="AriaRestartTeachingTip_CloseButtonClick"
        IsLightDismissEnabled="False"
        PlacementMargin="20"
        PreferredPlacement="Auto" />
</Grid>
</Page>
