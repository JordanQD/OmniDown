<UserControl
    x:Class="OmniDown.Controls.DownloadSettingsSectionControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OmniDown.Controls">

    <UserControl.Resources>
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>
        <Style
            x:Key="SettingsSectionHeaderTextBlockStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="1,30,0,6" />
        </Style>
    </UserControl.Resources>

    <StackPanel
        x:Name="DownloadSettingsContent"
        Spacing="{StaticResource SettingsCardSpacing}">
        <StackPanel.ChildrenTransitions>
            <RepositionThemeTransition />
        </StackPanel.ChildrenTransitions>

        <TextBlock
            AutomationProperties.HeadingLevel="Level1"
            Style="{StaticResource TitleTextBlockStyle}"
            x:Uid="DownloadSettingsTitle"
            Text="下载" />

        <TextBlock
            Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
            x:Uid="DownloadTaskDefaultsHeader"
            Text="任务默认值" />

        <local:SettingCardControl
            x:Name="DefaultDirectorySettingCard"
            x:Uid="DefaultDirectorySettingCard"
            Description="新建任务的默认保存位置。"
            Header="Default directory"
            IconGlyph="&#xE8B7;">
            <local:SettingCardControl.ActionContent>
                <Grid
                    MinWidth="200"
                    Height="32"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="8">
                    <TextBox
                        x:Name="DownloadDirectoryTextBox"
                        Height="32"
                        VerticalAlignment="Center"
                        PlaceholderText="下载文件夹"
                        TextChanged="DownloadSettingTextBox_TextChanged" />
                    <Button
                        Grid.Column="1"
                        Width="40"
                        Height="32"
                        MinWidth="40"
                        Padding="0"
                        VerticalAlignment="Center"
                        Click="BrowseDownloadDirectoryButton_Click"
                        ToolTipService.ToolTip="选择文件夹">
                        <FontIcon Glyph="&#xE8B7;" />
                    </Button>
                </Grid>
            </local:SettingCardControl.ActionContent>
        </local:SettingCardControl>

        <local:SettingCardControl
            x:Name="MaxConcurrentDownloadsSettingCard"
            Description="同时运行的任务上限。"
            Header="最大同时下载数"
            IconGlyph="&#xE8EF;">
            <local:SettingCardControl.ActionContent>
                <NumberBox
                    x:Name="MaxConcurrentDownloadsNumberBox"
                    MinWidth="140"
                    Height="32"
                    HorizontalAlignment="Stretch"
                    Minimum="1"
                    Maximum="10"
                    SmallChange="1"
                    SpinButtonPlacementMode="Inline"
                    Value="5"
                    ValueChanged="DownloadSettingNumberBox_ValueChanged" />
            </local:SettingCardControl.ActionContent>
        </local:SettingCardControl>

        <local:SettingCardControl
            x:Name="SplitCountSettingCard"
            Description="单个任务的并行分片数。"
            Header="默认分片数"
            IconGlyph="&#xE8FD;">
            <local:SettingCardControl.ActionContent>
                <NumberBox
                    x:Name="SplitCountNumberBox"
                    MinWidth="140"
                    Height="32"
                    HorizontalAlignment="Stretch"
                    Minimum="1"
                    Maximum="256"
                    SmallChange="1"
                    SpinButtonPlacementMode="Inline"
                    Value="64"
                    ValueChanged="DownloadSettingNumberBox_ValueChanged" />
            </local:SettingCardControl.ActionContent>
        </local:SettingCardControl>

        <local:SettingCardControl
            x:Name="MaxConnectionPerServerSettingCard"
            Description="同一服务器的连接上限，范围 1-16。"
            Header="单服务器最大连接数"
            IconGlyph="&#xE839;">
            <local:SettingCardControl.ActionContent>
                <NumberBox
                    x:Name="MaxConnectionPerServerNumberBox"
                    MinWidth="140"
                    Height="32"
                    HorizontalAlignment="Stretch"
                    Minimum="1"
                    Maximum="16"
                    SmallChange="1"
                    SpinButtonPlacementMode="Inline"
                    Value="16"
                    ValueChanged="DownloadSettingNumberBox_ValueChanged" />
            </local:SettingCardControl.ActionContent>
        </local:SettingCardControl>

        <TextBlock
            Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
            x:Uid="DownloadFileRetryHeader"
            Text="文件与重试" />

        <local:SettingCardControl
            x:Name="ContinueDownloadSettingCard"
            Description="继续未完成的可恢复任务。"
            Header="断点续传"
            IconGlyph="&#xE768;">
            <local:SettingCardControl.ActionContent>
                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <TextBlock
                        x:Name="ContinueDownloadStateText"
                        VerticalAlignment="Center"
                        Text="开" />
                    <ToggleSwitch
                        x:Name="ContinueDownloadToggleSwitch"
                        Width="48"
                        MinWidth="0"
                        Padding="0"
                        OffContent=""
                        OnContent=""
                        IsOn="True"
                        Toggled="DownloadSettingToggleSwitch_Toggled" />
                </StackPanel>
            </local:SettingCardControl.ActionContent>
        </local:SettingCardControl>

        <local:SettingCardControl
            x:Name="RemoteTimeSettingCard"
            Description="保存完成时间或服务器时间。"
            Header="文件时间戳"
            IconGlyph="&#xE823;">
            <local:SettingCardControl.ActionContent>
                <ComboBox
                    x:Name="RemoteTimeComboBox"
                    MinWidth="160"
                    HorizontalAlignment="Right"
                    SelectionChanged="DownloadSettingComboBox_SelectionChanged">
                    <ComboBoxItem
                        Content="下载完成时间"
                        Tag="Download" />
                    <ComboBoxItem
                        Content="服务器时间"
                        Tag="Server" />
                </ComboBox>
            </local:SettingCardControl.ActionContent>
        </local:SettingCardControl>

        <local:SettingCardControl
            x:Name="MaxTriesSettingCard"
            Description="0 表示不限次数。"
            Header="最大重试次数"
            IconGlyph="&#xE8BB;">
            <local:SettingCardControl.ActionContent>
                <NumberBox
                    x:Name="MaxTriesNumberBox"
                    MinWidth="140"
                    Height="32"
                    HorizontalAlignment="Stretch"
                    Minimum="0"
                    Maximum="60"
                    SmallChange="1"
                    SpinButtonPlacementMode="Inline"
                    Value="0"
                    ValueChanged="DownloadSettingNumberBox_ValueChanged" />
            </local:SettingCardControl.ActionContent>
        </local:SettingCardControl>

        <local:SettingCardControl
            x:Name="RetryWaitSettingCard"
            Description="失败后再次尝试的间隔。"
            Header="重试等待时间"
            IconGlyph="&#xE916;">
            <local:SettingCardControl.ActionContent>
                <NumberBox
                    x:Name="RetryWaitNumberBox"
                    MinWidth="140"
                    Height="32"
                    HorizontalAlignment="Stretch"
                    Minimum="0"
                    Maximum="600"
                    SmallChange="1"
                    SpinButtonPlacementMode="Inline"
                    Value="10"
                    ValueChanged="DownloadSettingNumberBox_ValueChanged" />
            </local:SettingCardControl.ActionContent>
        </local:SettingCardControl>

        <TextBlock
            Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
            x:Uid="DownloadAutoCleanupHeader"
            Text="自动清理" />

        <local:SettingCardControl
            x:Name="DownloadCleanupSettingCard"
            Description="清理已脱离 aria2 会话的记录。"
            Header="自动移除陈旧记录"
            IconGlyph="&#xE74D;">
            <local:SettingCardControl.ActionContent>
                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <TextBlock
                        x:Name="AutoDeleteStaleRecordsStateText"
                        VerticalAlignment="Center"
                        Text="关" />
                    <ToggleSwitch
                        x:Name="AutoDeleteStaleRecordsToggleSwitch"
                        Width="48"
                        MinWidth="0"
                        Padding="0"
                        OffContent=""
                        OnContent=""
                        Toggled="DownloadSettingToggleSwitch_Toggled" />
                </StackPanel>
            </local:SettingCardControl.ActionContent>
        </local:SettingCardControl>

        <local:SettingCardControl
            x:Name="TorrentCleanupSettingCard"
            Description="仅删除本地种子源文件。"
            Header="完成后删除 .torrent 源文件"
            IconGlyph="&#xE9AC;">
            <local:SettingCardControl.ActionContent>
                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <TextBlock
                        x:Name="DeleteTorrentAfterCompleteStateText"
                        VerticalAlignment="Center"
                        Text="关" />
                    <ToggleSwitch
                        x:Name="DeleteTorrentAfterCompleteToggleSwitch"
                        Width="48"
                        MinWidth="0"
                        Padding="0"
                        OffContent=""
                        OnContent=""
                        Toggled="DownloadSettingToggleSwitch_Toggled" />
                </StackPanel>
            </local:SettingCardControl.ActionContent>
        </local:SettingCardControl>

    </StackPanel>
</UserControl>
