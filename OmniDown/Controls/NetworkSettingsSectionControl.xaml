<UserControl
    x:Class="OmniDown.Controls.NetworkSettingsSectionControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">
    <StackPanel
        x:Name="NetworkSettingsContent"
        Margin="0,24,0,36"
        Spacing="4">
        <TextBlock
            AutomationProperties.HeadingLevel="Level1"
            Style="{StaticResource TitleTextBlockStyle}"
            x:Uid="NetworkSettingsTitle"
            Text="网络" />

        <!--  代理  -->
        <TextBlock
            Margin="1,30,0,6"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            x:Uid="NetworkProxySectionHeader"
            Text="代理" />

        <controls:SettingsExpander
            x:Name="DownloadProxySettingCard"
            x:Uid="DownloadProxySettingCard"
            Description="仅代理下载请求，不代理 BT/ED2K 节点连接。"
            Header="下载代理">
            <controls:SettingsExpander.HeaderIcon>
                <FontIcon Glyph="&#xE8A7;" />
            </controls:SettingsExpander.HeaderIcon>
            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock
                    x:Name="DownloadProxyStateText"
                    VerticalAlignment="Center"
                    Text="关" />
                <ToggleSwitch
                    x:Name="DownloadProxyToggleSwitch"
                    Width="48"
                    MinWidth="0"
                    Padding="0"
                    OffContent=""
                    OnContent=""
                    Toggled="NetworkSettingToggleSwitch_Toggled" />
            </StackPanel>
            <controls:SettingsExpander.Items>
                <controls:SettingsCard
                    x:Uid="ProxyServerSettingCard"
                    Description="仅支持 HTTP/HTTPS 代理，不支持 SOCKS 代理。"
                    Header="代理服务器">
                    <Grid
                        Width="300"
                        HorizontalAlignment="Right"
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="8">
                        <TextBox
                            x:Name="ProxyServerTextBox"
                            x:Uid="ProxyServerTextBox"
                            Height="32"
                            PlaceholderText="http://127.0.0.1:7890"
                            TextChanged="NetworkSettingTextBox_TextChanged"
                            TextWrapping="NoWrap" />
                        <Button
                            x:Name="DetectSystemProxyButton"
                            Grid.Column="1"
                            AutomationProperties.Name="检测系统代理"
                            Width="40"
                            Height="32"
                            MinWidth="40"
                            Padding="0"
                            Click="DetectSystemProxyButton_Click"
                            ToolTipService.ToolTip="检测系统代理">
                            <FontIcon
                                FontSize="16"
                                Glyph="&#xE721;" />
                        </Button>
                    </Grid>
                </controls:SettingsCard>

                <controls:SettingsCard
                    x:Uid="ProxyUsernameSettingCard"
                    Header="代理用户名">
                    <TextBox
                        x:Name="ProxyUsernameTextBox"
                        Width="300"
                        Height="32"
                        HorizontalAlignment="Right"
                        PlaceholderText="可选"
                        TextChanged="NetworkSettingTextBox_TextChanged"
                        TextWrapping="NoWrap" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    x:Uid="ProxyPasswordSettingCard"
                    Header="代理密码">
                    <PasswordBox
                        x:Name="ProxyPasswordBox"
                        Width="300"
                        Height="32"
                        HorizontalAlignment="Right"
                        PlaceholderText="可选"
                        PasswordChanged="NetworkSettingPasswordBox_PasswordChanged" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    x:Uid="ProxyBypassSettingCard"
                    Header="代理排除">
                    <TextBox
                        x:Name="ProxyBypassTextBox"
                        x:Uid="ProxyBypassTextBox"
                        Width="300"
                        Height="96"
                        HorizontalAlignment="Right"
                        PlaceholderText="不使用代理的地址"
                        AcceptsReturn="True"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        TextChanged="NetworkSettingTextBox_TextChanged"
                        TextWrapping="Wrap" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    x:Uid="ProxyScopeSettingCard"
                    Header="代理范围">
                    <Button
                        x:Name="ProxyScopeDropDownButton"
                        Width="300"
                        HorizontalAlignment="Right"
                        HorizontalContentAlignment="Stretch">
                        <Button.Content>
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="6">
                                    <Border
                                        x:Name="ProxyDownloadsToken"
                                        Padding="8,2"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{ThemeResource ControlCornerRadius}">
                                        <TextBlock Text="下载" />
                                    </Border>
                                    <Border
                                        x:Name="ProxyTrackersToken"
                                        Padding="8,2"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{ThemeResource ControlCornerRadius}">
                                        <TextBlock Text="Tracker 更新" />
                                    </Border>
                                    <TextBlock
                                        x:Name="ProxyScopePlaceholderText"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="选择代理范围" />
                                </StackPanel>
                                <FontIcon
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    FontSize="12"
                                    Glyph="&#xE70D;" />
                            </Grid>
                        </Button.Content>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <Border
                                    Width="360"
                                    Padding="12"
                                    CornerRadius="{ThemeResource ControlCornerRadius}">
                                    <StackPanel Spacing="4">
                                        <CheckBox
                                            x:Name="ProxyDownloadsCheckBox"
                                            Content="下载"
                                            Checked="NetworkSettingCheckBox_Changed"
                                            Unchecked="NetworkSettingCheckBox_Changed" />
                                        <CheckBox
                                            x:Name="ProxyTrackersCheckBox"
                                            Content="Tracker 更新"
                                            Checked="NetworkSettingCheckBox_Changed"
                                            Unchecked="NetworkSettingCheckBox_Changed" />
                                    </StackPanel>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </controls:SettingsCard>
            </controls:SettingsExpander.Items>
        </controls:SettingsExpander>

        <!--  端口  -->
        <TextBlock
            Margin="1,30,0,6"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            x:Uid="NetworkPortSectionHeader"
            Text="端口" />

        <controls:SettingsCard
            x:Name="UpnpSettingCard"
            x:Uid="UpnpSettingCard"
            Description="保存端口映射偏好；当前 Windows 版 aria2 启动参数会使用下方端口。"
            Header="UPnP/NAT-PMP">
            <controls:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE839;" />
            </controls:SettingsCard.HeaderIcon>
            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock
                    x:Name="EnableUpnpStateText"
                    VerticalAlignment="Center"
                    Text="关" />
                <ToggleSwitch
                    x:Name="EnableUpnpToggleSwitch"
                    Width="48"
                    MinWidth="0"
                    Padding="0"
                    OffContent=""
                    OnContent=""
                    Toggled="NetworkSettingToggleSwitch_Toggled" />
            </StackPanel>
        </controls:SettingsCard>

        <controls:SettingsCard
            x:Name="BtPortSettingCard"
            x:Uid="BtPortSettingCard"
            Description="用于接收 BitTorrent 对等连接。修改后需重启 aria2 生效。"
            Header="BT 监听端口">
            <controls:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE95A;" />
            </controls:SettingsCard.HeaderIcon>
            <Grid
                ColumnDefinitions="*,Auto"
                ColumnSpacing="8">
                <NumberBox
                    x:Name="BtListenPortNumberBox"
                    Width="120"
                    Height="32"
                    HorizontalAlignment="Right"
                    Minimum="1024"
                    Maximum="65535"
                    SmallChange="1"
                    SpinButtonPlacementMode="Inline"
                    ValueChanged="NetworkSettingNumberBox_ValueChanged" />
                <Button
                    Grid.Column="1"
                    Width="40"
                    Height="32"
                    MinWidth="40"
                    Padding="0"
                    VerticalAlignment="Center"
                    x:Uid="RandomBtPortButton"
                    Click="RandomBtPortButton_Click"
                    ToolTipService.ToolTip="随机端口">
                    <FontIcon Glyph="&#xE8B1;" />
                </Button>
            </Grid>
        </controls:SettingsCard>

        <controls:SettingsCard
            x:Name="DhtPortSettingCard"
            x:Uid="DhtPortSettingCard"
            Description="用于 DHT 节点发现。修改后需重启 aria2 生效。"
            Header="DHT 监听端口">
            <controls:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE968;" />
            </controls:SettingsCard.HeaderIcon>
            <Grid
                ColumnDefinitions="*,Auto"
                ColumnSpacing="8">
                <NumberBox
                    x:Name="DhtListenPortNumberBox"
                    Width="120"
                    Height="32"
                    HorizontalAlignment="Right"
                    Minimum="1024"
                    Maximum="65535"
                    SmallChange="1"
                    SpinButtonPlacementMode="Inline"
                    ValueChanged="NetworkSettingNumberBox_ValueChanged" />
                <Button
                    Grid.Column="1"
                    Width="40"
                    Height="32"
                    MinWidth="40"
                    Padding="0"
                    VerticalAlignment="Center"
                    x:Uid="RandomDhtPortButton"
                    Click="RandomDhtPortButton_Click"
                    ToolTipService.ToolTip="随机端口">
                    <FontIcon Glyph="&#xE8B1;" />
                </Button>
            </Grid>
        </controls:SettingsCard>

        <!--  User-Agent  -->
        <TextBlock
            Margin="1,30,0,6"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            x:Uid="NetworkUserAgentSectionHeader"
            Text="User-Agent" />

        <controls:SettingsCard
            x:Name="UserAgentSettingCard"
            x:Uid="UserAgentSettingCard"
            Description="默认为aria2内置 User-Agent。"
            Header="User-Agent">
            <controls:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE774;" />
            </controls:SettingsCard.HeaderIcon>
            <ComboBox
                x:Name="UserAgentComboBox"
                Width="168"
                HorizontalAlignment="Right"
                HorizontalContentAlignment="Stretch"
                SelectionChanged="UserAgentComboBox_SelectionChanged">
                <ComboBoxItem Content="默认" Tag="Default" />
                <ComboBoxItem Content="Chrome" Tag="Chrome" />
                <ComboBoxItem Content="Edge" Tag="Edge" />
                <ComboBoxItem Content="Safari" Tag="Safari" />
                <ComboBoxItem Content="Firefox" Tag="Firefox" />
                <ComboBoxItem Content="Transmission" Tag="Transmission" />
                <ComboBoxItem Content="自定义" Tag="Custom" />
            </ComboBox>
        </controls:SettingsCard>

        <controls:SettingsCard
            x:Name="UserAgentCustomSettingCard"
            x:Uid="UserAgentCustomSettingCard"
            Header="自定义 User-Agent"
            Visibility="Collapsed">
            <TextBox
                x:Name="UserAgentTextBox"
                x:Uid="UserAgentTextBox"
                Width="300"
                Height="32"
                HorizontalAlignment="Right"
                PlaceholderText="User-Agent"
                TextChanged="NetworkSettingTextBox_TextChanged"
                TextWrapping="NoWrap" />
        </controls:SettingsCard>

        <!--  传输参数  -->
        <TextBlock
            Margin="1,30,0,6"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            x:Uid="NetworkTransferParamsSectionHeader"
            Text="传输参数" />

        <controls:SettingsCard
            x:Name="ConnectTimeoutSettingCard"
            x:Uid="ConnectTimeoutSettingCard"
            Description="建立连接时最多等待的秒数。"
            Header="连接超时">
            <controls:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE916;" />
            </controls:SettingsCard.HeaderIcon>
            <NumberBox
                x:Name="ConnectTimeoutNumberBox"
                Width="168"
                Height="32"
                HorizontalAlignment="Right"
                Minimum="1"
                Maximum="600"
                SmallChange="1"
                SpinButtonPlacementMode="Inline"
                ValueChanged="NetworkSettingNumberBox_ValueChanged" />
        </controls:SettingsCard>

        <controls:SettingsCard
            x:Name="TimeoutSettingCard"
            x:Uid="TimeoutSettingCard"
            Description="传输空闲超过该秒数后视为超时。"
            Header="传输超时">
            <controls:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE823;" />
            </controls:SettingsCard.HeaderIcon>
            <NumberBox
                x:Name="TimeoutNumberBox"
                Width="168"
                Height="32"
                HorizontalAlignment="Right"
                Minimum="1"
                Maximum="600"
                SmallChange="1"
                SpinButtonPlacementMode="Inline"
                ValueChanged="NetworkSettingNumberBox_ValueChanged" />
        </controls:SettingsCard>

        <controls:SettingsCard
            x:Name="FileAllocationSettingCard"
            x:Uid="FileAllocationSettingCard"
            Description="控制下载开始时如何预留磁盘空间。"
            Header="文件预分配">
            <controls:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xEDA2;" />
            </controls:SettingsCard.HeaderIcon>
            <ComboBox
                x:Name="FileAllocationComboBox"
                Width="168"
                Height="32"
                HorizontalAlignment="Right"
                SelectionChanged="NetworkSettingComboBox_SelectionChanged">
                <ComboBoxItem Content="none" Tag="none" />
                <ComboBoxItem Content="prealloc" Tag="prealloc" />
                <ComboBoxItem Content="trunc" Tag="trunc" />
                <ComboBoxItem Content="falloc" Tag="falloc" />
            </ComboBox>
        </controls:SettingsCard>
    </StackPanel>
</UserControl>
