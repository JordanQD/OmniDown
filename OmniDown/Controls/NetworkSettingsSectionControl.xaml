<UserControl
    x:Class="OmniDown.Controls.NetworkSettingsSectionControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">
    <StackPanel
        x:Name="NetworkSettingsContent"
        Margin="0,24,0,36"
        Spacing="4">
        <TextBlock
            AutomationProperties.HeadingLevel="Level1"
            Style="{StaticResource TitleTextBlockStyle}"
            x:Uid="NetworkSettingsTitle"
            Text="网络" />

        <!--  代理  -->
        <TextBlock
            Margin="1,30,0,6"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            x:Uid="NetworkProxySectionHeader"
            Text="代理" />

        <controls:SettingsCard
            x:Name="UseSystemProxySettingCard"
            x:Uid="UseSystemProxySettingCard"
            Description="启动 aria2 时读取 Windows 当前系统代理。"
            Header="系统代理">
            <controls:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE774;" />
            </controls:SettingsCard.HeaderIcon>
            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock
                    x:Name="UseSystemProxyStateText"
                    VerticalAlignment="Center"
                    Text="开" />
                <ToggleSwitch
                    x:Name="UseSystemProxyCheckBox"
                    Width="48"
                    MinWidth="0"
                    Padding="0"
                    OffContent=""
                    OnContent=""
                    IsOn="True"
                    Toggled="NetworkSettingToggleSwitch_Toggled" />
            </StackPanel>
        </controls:SettingsCard>

        <controls:SettingsExpander
            x:Name="CustomProxySettingCard"
            x:Uid="CustomProxySettingCard"
            Description="自定义 HTTP 或 HTTPS 代理会优先于系统代理。"
            Header="自定义代理">
            <controls:SettingsExpander.HeaderIcon>
                <FontIcon Glyph="&#xE8A7;" />
            </controls:SettingsExpander.HeaderIcon>
            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock
                    x:Name="CustomProxyStateText"
                    VerticalAlignment="Center"
                    Text="关" />
                <ToggleSwitch
                    x:Name="CustomProxyToggleSwitch"
                    Width="48"
                    MinWidth="0"
                    Padding="0"
                    OffContent=""
                    OnContent=""
                    Toggled="NetworkSettingToggleSwitch_Toggled" />
            </StackPanel>
            <controls:SettingsExpander.Items>
                <controls:SettingsCard
                    x:Uid="ProxyServerSettingCard"
                    Description="示例：http://127.0.0.1:7890"
                    Header="代理地址">
                    <TextBox
                        x:Name="ProxyServerTextBox"
                        x:Uid="ProxyServerTextBox"
                        Width="420"
                        Height="32"
                        HorizontalAlignment="Right"
                        PlaceholderText="代理地址"
                        TextChanged="NetworkSettingTextBox_TextChanged"
                        TextWrapping="NoWrap" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    x:Uid="DetectSystemProxySettingCard"
                    Description="读取 Windows 当前系统代理并填入代理地址。"
                    Header="检测系统代理">
                    <Button
                        x:Name="DetectSystemProxyButton"
                        Width="40"
                        Height="32"
                        MinWidth="40"
                        Padding="0"
                        HorizontalAlignment="Right"
                        x:Uid="DetectSystemProxyButton"
                        Click="DetectSystemProxyButton_Click"
                        ToolTipService.ToolTip="检测系统代理">
                        <FontIcon Glyph="&#xE721;" />
                    </Button>
                </controls:SettingsCard>

                <controls:SettingsCard
                    x:Uid="ProxyBypassSettingCard"
                    Description="用分号分隔不走代理的主机或网段。"
                    Header="代理绕过">
                    <TextBox
                        x:Name="ProxyBypassTextBox"
                        x:Uid="ProxyBypassTextBox"
                        Width="420"
                        Height="32"
                        HorizontalAlignment="Right"
                        PlaceholderText="不使用代理的地址"
                        TextChanged="NetworkSettingTextBox_TextChanged"
                        TextWrapping="NoWrap" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    x:Uid="ProxyDownloadsSettingCard"
                    Description="下载任务使用上方代理配置。"
                    Header="下载任务">
                    <CheckBox
                        x:Name="ProxyDownloadsCheckBox"
                        HorizontalAlignment="Right"
                        Checked="NetworkSettingCheckBox_Changed"
                        Unchecked="NetworkSettingCheckBox_Changed" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    x:Uid="ProxyTrackersSettingCard"
                    Description="同步 Tracker 列表时使用上方代理配置。"
                    Header="Tracker 同步">
                    <CheckBox
                        x:Name="ProxyTrackersCheckBox"
                        HorizontalAlignment="Right"
                        Checked="NetworkSettingCheckBox_Changed"
                        Unchecked="NetworkSettingCheckBox_Changed" />
                </controls:SettingsCard>
            </controls:SettingsExpander.Items>
        </controls:SettingsExpander>

        <!--  端口  -->
        <TextBlock
            Margin="1,30,0,6"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            x:Uid="NetworkPortSectionHeader"
            Text="端口" />

        <controls:SettingsCard
            x:Name="UpnpSettingCard"
            x:Uid="UpnpSettingCard"
            Description="保存端口映射偏好；当前 Windows 版 aria2 启动参数会使用下方端口。"
            Header="UPnP/NAT-PMP">
            <controls:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE839;" />
            </controls:SettingsCard.HeaderIcon>
            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock
                    x:Name="EnableUpnpStateText"
                    VerticalAlignment="Center"
                    Text="关" />
                <ToggleSwitch
                    x:Name="EnableUpnpToggleSwitch"
                    Width="48"
                    MinWidth="0"
                    Padding="0"
                    OffContent=""
                    OnContent=""
                    Toggled="NetworkSettingToggleSwitch_Toggled" />
            </StackPanel>
        </controls:SettingsCard>

        <controls:SettingsCard
            x:Name="BtPortSettingCard"
            x:Uid="BtPortSettingCard"
            Description="用于接收 BitTorrent 对等连接。修改后需重启 aria2 生效。"
            Header="BT 监听端口">
            <controls:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE95A;" />
            </controls:SettingsCard.HeaderIcon>
            <Grid
                ColumnDefinitions="*,Auto"
                ColumnSpacing="8">
                <NumberBox
                    x:Name="BtListenPortNumberBox"
                    Width="120"
                    Height="32"
                    HorizontalAlignment="Right"
                    Minimum="1024"
                    Maximum="65535"
                    SmallChange="1"
                    SpinButtonPlacementMode="Inline"
                    ValueChanged="NetworkSettingNumberBox_ValueChanged" />
                <Button
                    Grid.Column="1"
                    Width="40"
                    Height="32"
                    MinWidth="40"
                    Padding="0"
                    VerticalAlignment="Center"
                    x:Uid="RandomBtPortButton"
                    Click="RandomBtPortButton_Click"
                    ToolTipService.ToolTip="随机端口">
                    <FontIcon Glyph="&#xE8B1;" />
                </Button>
            </Grid>
        </controls:SettingsCard>

        <controls:SettingsCard
            x:Name="DhtPortSettingCard"
            x:Uid="DhtPortSettingCard"
            Description="用于 DHT 节点发现。修改后需重启 aria2 生效。"
            Header="DHT 监听端口">
            <controls:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE968;" />
            </controls:SettingsCard.HeaderIcon>
            <Grid
                ColumnDefinitions="*,Auto"
                ColumnSpacing="8">
                <NumberBox
                    x:Name="DhtListenPortNumberBox"
                    Width="120"
                    Height="32"
                    HorizontalAlignment="Right"
                    Minimum="1024"
                    Maximum="65535"
                    SmallChange="1"
                    SpinButtonPlacementMode="Inline"
                    ValueChanged="NetworkSettingNumberBox_ValueChanged" />
                <Button
                    Grid.Column="1"
                    Width="40"
                    Height="32"
                    MinWidth="40"
                    Padding="0"
                    VerticalAlignment="Center"
                    x:Uid="RandomDhtPortButton"
                    Click="RandomDhtPortButton_Click"
                    ToolTipService.ToolTip="随机端口">
                    <FontIcon Glyph="&#xE8B1;" />
                </Button>
            </Grid>
        </controls:SettingsCard>

        <!--  User-Agent  -->
        <TextBlock
            Margin="1,30,0,6"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            x:Uid="NetworkUserAgentSectionHeader"
            Text="User-Agent" />

        <controls:SettingsCard
            x:Name="UserAgentSettingCard"
            x:Uid="UserAgentSettingCard"
            Header="User-Agent">
            <controls:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE774;" />
            </controls:SettingsCard.HeaderIcon>
            <TextBox
                x:Name="UserAgentTextBox"
                x:Uid="UserAgentTextBox"
                Width="300"
                Height="32"
                HorizontalAlignment="Stretch"
                PlaceholderText="User-Agent"
                TextChanged="NetworkSettingTextBox_TextChanged"
                TextWrapping="NoWrap" />
            <controls:SettingsCard.Description>
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        Click="UserAgentPresetButton_Click"
                        Content="Chrome"
                        Tag="Chrome" />
                    <Button
                        Click="UserAgentPresetButton_Click"
                        Content="Edge"
                        Tag="Edge" />
                    <Button
                        Click="UserAgentPresetButton_Click"
                        Content="Safari"
                        Tag="Safari" />
                    <Button
                        Click="UserAgentPresetButton_Click"
                        Content="Firefox"
                        Tag="Firefox" />
                    <Button
                        Click="UserAgentPresetButton_Click"
                        Content="Transmission"
                        Tag="Transmission" />
                    <Button
                        Click="UserAgentPresetButton_Click"
                        x:Uid="UserAgentResetButton"
                        Content="重置"
                        Tag="Reset" />
                </StackPanel>
            </controls:SettingsCard.Description>
        </controls:SettingsCard>

        <!--  传输参数  -->
        <TextBlock
            Margin="1,30,0,6"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            x:Uid="NetworkTransferParamsSectionHeader"
            Text="传输参数" />

        <controls:SettingsCard
            x:Name="ConnectTimeoutSettingCard"
            x:Uid="ConnectTimeoutSettingCard"
            Description="建立连接时最多等待的秒数。"
            Header="连接超时">
            <controls:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE916;" />
            </controls:SettingsCard.HeaderIcon>
            <NumberBox
                x:Name="ConnectTimeoutNumberBox"
                Width="168"
                Height="32"
                HorizontalAlignment="Right"
                Minimum="1"
                Maximum="600"
                SmallChange="1"
                SpinButtonPlacementMode="Inline"
                ValueChanged="NetworkSettingNumberBox_ValueChanged" />
        </controls:SettingsCard>

        <controls:SettingsCard
            x:Name="TimeoutSettingCard"
            x:Uid="TimeoutSettingCard"
            Description="传输空闲超过该秒数后视为超时。"
            Header="传输超时">
            <controls:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE823;" />
            </controls:SettingsCard.HeaderIcon>
            <NumberBox
                x:Name="TimeoutNumberBox"
                Width="168"
                Height="32"
                HorizontalAlignment="Right"
                Minimum="1"
                Maximum="600"
                SmallChange="1"
                SpinButtonPlacementMode="Inline"
                ValueChanged="NetworkSettingNumberBox_ValueChanged" />
        </controls:SettingsCard>

        <controls:SettingsCard
            x:Name="FileAllocationSettingCard"
            x:Uid="FileAllocationSettingCard"
            Description="控制下载开始时如何预留磁盘空间。"
            Header="文件预分配">
            <controls:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xEDA2;" />
            </controls:SettingsCard.HeaderIcon>
            <ComboBox
                x:Name="FileAllocationComboBox"
                Width="168"
                Height="32"
                HorizontalAlignment="Right"
                SelectionChanged="NetworkSettingComboBox_SelectionChanged">
                <ComboBoxItem Content="none" Tag="none" />
                <ComboBoxItem Content="prealloc" Tag="prealloc" />
                <ComboBoxItem Content="trunc" Tag="trunc" />
                <ComboBoxItem Content="falloc" Tag="falloc" />
            </ComboBox>
        </controls:SettingsCard>
    </StackPanel>
</UserControl>
