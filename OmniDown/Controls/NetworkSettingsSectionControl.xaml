<UserControl
    x:Class="OmniDown.Controls.NetworkSettingsSectionControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">
    <StackPanel
        x:Name="NetworkSettingsContent"
        Margin="0,24,0,36"
        Spacing="4">
        <StackPanel.ChildrenTransitions>
            <EntranceThemeTransition FromVerticalOffset="50" />
            <RepositionThemeTransition />
        </StackPanel.ChildrenTransitions>
        <TextBlock
            AutomationProperties.HeadingLevel="Level1"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="网络" />

        <!--  代理  -->
        <TextBlock
            Margin="1,30,0,6"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Text="代理" />

        <controls:SettingsCard
            x:Name="UseSystemProxySettingCard"
            Description="启动 aria2 时读取 Windows 当前系统代理。"
            Header="Proxy">
            <controls:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE774;" />
            </controls:SettingsCard.HeaderIcon>
            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock
                    x:Name="UseSystemProxyStateText"
                    VerticalAlignment="Center"
                    Text="开" />
                <ToggleSwitch
                    x:Name="UseSystemProxyCheckBox"
                    Width="48"
                    MinWidth="0"
                    Padding="0"
                    OffContent=""
                    OnContent=""
                    IsOn="True"
                    Toggled="NetworkSettingToggleSwitch_Toggled" />
            </StackPanel>
        </controls:SettingsCard>

        <controls:SettingsCard
            x:Name="CustomProxySettingCard"
            Header="自定义代理">
            <controls:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE8A7;" />
            </controls:SettingsCard.HeaderIcon>
            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock
                    x:Name="CustomProxyStateText"
                    VerticalAlignment="Center"
                    Text="关" />
                <ToggleSwitch
                    x:Name="CustomProxyToggleSwitch"
                    Width="48"
                    MinWidth="0"
                    Padding="0"
                    OffContent=""
                    OnContent=""
                    Toggled="NetworkSettingToggleSwitch_Toggled" />
            </StackPanel>
            <controls:SettingsCard.Description>
                <StackPanel Spacing="12">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="为 aria2 设置 HTTP 或 HTTPS 代理；自定义代理会优先于系统代理。"
                        TextWrapping="WrapWholeWords" />
                    <Grid
                        Width="360"
                        Height="32"
                        HorizontalAlignment="Left"
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="8">
                        <TextBox
                            x:Name="ProxyServerTextBox"
                            Height="32"
                            VerticalAlignment="Center"
                            PlaceholderText="代理地址"
                            TextChanged="NetworkSettingTextBox_TextChanged" />
                        <Button
                            x:Name="DetectSystemProxyButton"
                            Grid.Column="1"
                            Width="40"
                            Height="32"
                            MinWidth="40"
                            Padding="0"
                            VerticalAlignment="Center"
                            Click="DetectSystemProxyButton_Click"
                            ToolTipService.ToolTip="检测系统代理">
                            <FontIcon Glyph="&#xE721;" />
                        </Button>
                    </Grid>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="示例：http://127.0.0.1:7890 或 127.0.0.1:7890。当前 aria2 版本不支持 SOCKS 代理。"
                        TextWrapping="WrapWholeWords" />
                    <TextBox
                        x:Name="ProxyBypassTextBox"
                        Width="360"
                        Height="32"
                        HorizontalAlignment="Left"
                        PlaceholderText="不使用代理的地址"
                        TextChanged="NetworkSettingTextBox_TextChanged"
                        TextWrapping="NoWrap" />
                    <TextBlock
                        FontWeight="SemiBold"
                        Text="代理范围" />
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="16">
                        <CheckBox
                            x:Name="ProxyDownloadsCheckBox"
                            Checked="NetworkSettingCheckBox_Changed"
                            Content="下载任务"
                            Unchecked="NetworkSettingCheckBox_Changed" />
                        <CheckBox
                            x:Name="ProxyTrackersCheckBox"
                            Checked="NetworkSettingCheckBox_Changed"
                            Content="Tracker 同步"
                            Unchecked="NetworkSettingCheckBox_Changed" />
                    </StackPanel>
                </StackPanel>
            </controls:SettingsCard.Description>
        </controls:SettingsCard>

        <!--  端口  -->
        <TextBlock
            Margin="1,30,0,6"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Text="端口" />

        <controls:SettingsCard
            x:Name="UpnpSettingCard"
            Description="保存端口映射偏好；当前 Windows 版 aria2 启动参数会使用下方端口。"
            Header="UPnP/NAT-PMP">
            <controls:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE839;" />
            </controls:SettingsCard.HeaderIcon>
            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock
                    x:Name="EnableUpnpStateText"
                    VerticalAlignment="Center"
                    Text="关" />
                <ToggleSwitch
                    x:Name="EnableUpnpToggleSwitch"
                    Width="48"
                    MinWidth="0"
                    Padding="0"
                    OffContent=""
                    OnContent=""
                    Toggled="NetworkSettingToggleSwitch_Toggled" />
            </StackPanel>
        </controls:SettingsCard>

        <controls:SettingsCard
            x:Name="BtPortSettingCard"
            Description="用于接收 BitTorrent 对等连接。修改后需重启 aria2 生效。"
            Header="BT 监听端口">
            <controls:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE95A;" />
            </controls:SettingsCard.HeaderIcon>
            <Grid
                ColumnDefinitions="*,Auto"
                ColumnSpacing="8">
                <NumberBox
                    x:Name="BtListenPortNumberBox"
                    Width="120"
                    Height="32"
                    HorizontalAlignment="Right"
                    Minimum="1024"
                    Maximum="65535"
                    SmallChange="1"
                    SpinButtonPlacementMode="Inline"
                    ValueChanged="NetworkSettingNumberBox_ValueChanged" />
                <Button
                    Grid.Column="1"
                    Width="40"
                    Height="32"
                    MinWidth="40"
                    Padding="0"
                    VerticalAlignment="Center"
                    Click="RandomBtPortButton_Click"
                    ToolTipService.ToolTip="随机端口">
                    <FontIcon Glyph="&#xE8B1;" />
                </Button>
            </Grid>
        </controls:SettingsCard>

        <controls:SettingsCard
            x:Name="DhtPortSettingCard"
            Description="用于 DHT 节点发现。修改后需重启 aria2 生效。"
            Header="DHT 监听端口">
            <controls:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE968;" />
            </controls:SettingsCard.HeaderIcon>
            <Grid
                ColumnDefinitions="*,Auto"
                ColumnSpacing="8">
                <NumberBox
                    x:Name="DhtListenPortNumberBox"
                    Width="120"
                    Height="32"
                    HorizontalAlignment="Right"
                    Minimum="1024"
                    Maximum="65535"
                    SmallChange="1"
                    SpinButtonPlacementMode="Inline"
                    ValueChanged="NetworkSettingNumberBox_ValueChanged" />
                <Button
                    Grid.Column="1"
                    Width="40"
                    Height="32"
                    MinWidth="40"
                    Padding="0"
                    VerticalAlignment="Center"
                    Click="RandomDhtPortButton_Click"
                    ToolTipService.ToolTip="随机端口">
                    <FontIcon Glyph="&#xE8B1;" />
                </Button>
            </Grid>
        </controls:SettingsCard>

        <!--  User-Agent  -->
        <TextBlock
            Margin="1,30,0,6"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Text="User-Agent" />

        <controls:SettingsCard
            x:Name="UserAgentSettingCard"
            Header="User-Agent">
            <controls:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE774;" />
            </controls:SettingsCard.HeaderIcon>
            <TextBox
                x:Name="UserAgentTextBox"
                Width="300"
                Height="32"
                HorizontalAlignment="Stretch"
                PlaceholderText="User-Agent"
                TextChanged="NetworkSettingTextBox_TextChanged"
                TextWrapping="NoWrap" />
            <controls:SettingsCard.Description>
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        Click="UserAgentPresetButton_Click"
                        Content="Chrome"
                        Tag="Chrome" />
                    <Button
                        Click="UserAgentPresetButton_Click"
                        Content="Edge"
                        Tag="Edge" />
                    <Button
                        Click="UserAgentPresetButton_Click"
                        Content="Safari"
                        Tag="Safari" />
                    <Button
                        Click="UserAgentPresetButton_Click"
                        Content="Firefox"
                        Tag="Firefox" />
                    <Button
                        Click="UserAgentPresetButton_Click"
                        Content="Transmission"
                        Tag="Transmission" />
                    <Button
                        Click="UserAgentPresetButton_Click"
                        Content="重置"
                        Tag="Reset" />
                </StackPanel>
            </controls:SettingsCard.Description>
        </controls:SettingsCard>

        <!--  传输参数  -->
        <TextBlock
            Margin="1,30,0,6"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Text="传输参数" />

        <controls:SettingsCard
            x:Name="ConnectTimeoutSettingCard"
            Description="建立连接时最多等待的秒数。"
            Header="连接超时">
            <controls:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE916;" />
            </controls:SettingsCard.HeaderIcon>
            <NumberBox
                x:Name="ConnectTimeoutNumberBox"
                Width="168"
                Height="32"
                HorizontalAlignment="Right"
                Minimum="1"
                Maximum="600"
                SmallChange="1"
                SpinButtonPlacementMode="Inline"
                ValueChanged="NetworkSettingNumberBox_ValueChanged" />
        </controls:SettingsCard>

        <controls:SettingsCard
            x:Name="TimeoutSettingCard"
            Description="传输空闲超过该秒数后视为超时。"
            Header="传输超时">
            <controls:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE823;" />
            </controls:SettingsCard.HeaderIcon>
            <NumberBox
                x:Name="TimeoutNumberBox"
                Width="168"
                Height="32"
                HorizontalAlignment="Right"
                Minimum="1"
                Maximum="600"
                SmallChange="1"
                SpinButtonPlacementMode="Inline"
                ValueChanged="NetworkSettingNumberBox_ValueChanged" />
        </controls:SettingsCard>

        <controls:SettingsCard
            x:Name="FileAllocationSettingCard"
            Description="控制下载开始时如何预留磁盘空间。"
            Header="文件预分配">
            <controls:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xEDA2;" />
            </controls:SettingsCard.HeaderIcon>
            <ComboBox
                x:Name="FileAllocationComboBox"
                Width="168"
                Height="32"
                HorizontalAlignment="Right"
                SelectionChanged="NetworkSettingComboBox_SelectionChanged">
                <ComboBoxItem Content="none" Tag="none" />
                <ComboBoxItem Content="prealloc" Tag="prealloc" />
                <ComboBoxItem Content="trunc" Tag="trunc" />
                <ComboBoxItem Content="falloc" Tag="falloc" />
            </ComboBox>
        </controls:SettingsCard>
    </StackPanel>
</UserControl>
