<UserControl
    x:Class="OmniDown.Controls.SettingsHomePageControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer
        Padding="0,0,8,0"
        HorizontalContentAlignment="Center"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="820" HorizontalAlignment="Stretch">
            <StackPanel Spacing="24">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="设置" />

                <Grid
                    ColumnSpacing="12"
                    RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Row 0 -->
                    <controls:SettingsCard
                        Grid.Row="0"
                        Grid.Column="0"
                        x:Name="GeneralCard"
                        Click="SettingsCard_Click"
                        Description="启动、外观、通知等"
                        Header="通用"
                        IsClickEnabled="True"
                        Tag="General">
                        <controls:SettingsCard.HeaderIcon>
                            <SymbolIcon Symbol="Setting" />
                        </controls:SettingsCard.HeaderIcon>
                    </controls:SettingsCard>

                    <controls:SettingsCard
                        Grid.Row="0"
                        Grid.Column="1"
                        x:Name="DownloadCard"
                        Click="SettingsCard_Click"
                        Description="下载目录、并发、重试等"
                        Header="下载"
                        IsClickEnabled="True"
                        Tag="Download">
                        <controls:SettingsCard.HeaderIcon>
                            <SymbolIcon Symbol="Download" />
                        </controls:SettingsCard.HeaderIcon>
                    </controls:SettingsCard>

                    <controls:SettingsCard
                        Grid.Row="0"
                        Grid.Column="2"
                        x:Name="BitTorrentCard"
                        Click="SettingsCard_Click"
                        Description="Tracker、做种、加密等"
                        Header="BitTorrent"
                        IsClickEnabled="True"
                        Tag="BitTorrent">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE968;" />
                        </controls:SettingsCard.HeaderIcon>
                    </controls:SettingsCard>

                    <!-- Row 1 -->
                    <controls:SettingsCard
                        Grid.Row="1"
                        Grid.Column="0"
                        x:Name="NetworkCard"
                        Click="SettingsCard_Click"
                        Description="代理、端口、超时等"
                        Header="网络"
                        IsClickEnabled="True"
                        Tag="Network">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE774;" />
                        </controls:SettingsCard.HeaderIcon>
                    </controls:SettingsCard>

                    <controls:SettingsCard
                        Grid.Row="1"
                        Grid.Column="1"
                        x:Name="AdvancedCard"
                        Click="SettingsCard_Click"
                        Description="aria2、RPC、协议等"
                        Header="高级"
                        IsClickEnabled="True"
                        Tag="Advanced">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE713;" />
                        </controls:SettingsCard.HeaderIcon>
                    </controls:SettingsCard>

                    <controls:SettingsCard
                        Grid.Row="1"
                        Grid.Column="2"
                        x:Name="AboutCard"
                        Click="SettingsCard_Click"
                        Description="版本信息、克隆命令"
                        Header="关于"
                        IsClickEnabled="True"
                        Tag="About">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE946;" />
                        </controls:SettingsCard.HeaderIcon>
                    </controls:SettingsCard>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
