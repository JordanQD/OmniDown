<UserControl
    x:Class="OmniDown.Controls.SettingCardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinWidth="148"
    MinHeight="68"
    SizeChanged="SettingCardControl_SizeChanged">
    <Border
        Padding="16"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="{ThemeResource ControlCornerRadius}">
        <Grid
            x:Name="RootGrid"
            RowDefinitions="Auto,Auto"
            ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="16"
            RowSpacing="8">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="AdaptiveStates">
                    <VisualState x:Name="Wide" />
                    <VisualState x:Name="Narrow">
                        <VisualState.Setters>
                            <Setter Target="ActionPresenter.(Grid.Row)" Value="1" />
                            <Setter Target="ActionPresenter.(Grid.Column)" Value="1" />
                            <Setter Target="ActionPresenter.HorizontalAlignment" Value="Stretch" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="NarrowNoIcon">
                        <VisualState.Setters>
                            <Setter Target="HeaderIcon.Visibility" Value="Collapsed" />
                            <Setter Target="ActionPresenter.(Grid.Row)" Value="1" />
                            <Setter Target="ActionPresenter.(Grid.Column)" Value="0" />
                            <Setter Target="ActionPresenter.(Grid.ColumnSpan)" Value="3" />
                            <Setter Target="ActionPresenter.HorizontalAlignment" Value="Stretch" />
                            <Setter Target="HeaderPanel.(Grid.Column)" Value="0" />
                            <Setter Target="HeaderPanel.(Grid.ColumnSpan)" Value="3" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <FontIcon
                x:Name="HeaderIcon"
                Width="24"
                VerticalAlignment="Center"
                Glyph="{x:Bind IconGlyph, Mode=OneWay}" />
            <StackPanel
                x:Name="HeaderPanel"
                Grid.Column="1"
                Spacing="4">
                <TextBlock
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind Header, Mode=OneWay}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind Description, Mode=OneWay}"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>
            <ContentPresenter
                x:Name="ActionPresenter"
                Grid.Column="2"
                MinWidth="120"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Content="{x:Bind ActionContent, Mode=OneWay}" />
        </Grid>
    </Border>
</UserControl>
