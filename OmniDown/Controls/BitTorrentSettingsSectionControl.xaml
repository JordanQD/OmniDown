<UserControl
    x:Class="OmniDown.Controls.BitTorrentSettingsSectionControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:OmniDown.Controls">
    <StackPanel
        x:Name="BitTorrentSettingsContent"
        Margin="0,24,0,36"
        Spacing="4">
        <TextBlock
            AutomationProperties.HeadingLevel="Level1"
            Style="{StaticResource TitleTextBlockStyle}"
            x:Uid="BitTorrentSettingsTitle"
            Text="BitTorrent" />

        <!--  基础选项  -->
        <TextBlock
            Margin="1,30,0,6"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            x:Uid="BitTorrentBasicOptionsHeader"
            Text="基础选项" />

        <controls:SettingsCard
            x:Name="BtAutoDownloadSettingCard"
            x:Uid="BtAutoDownloadSettingCard"
            Description="添加 .torrent、metalink 或磁力链接后自动获取真实文件内容。"
            Header="自动下载种子内容">
            <controls:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE896;" />
            </controls:SettingsCard.HeaderIcon>
            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock
                    x:Name="BtAutoDownloadStateText"
                    VerticalAlignment="Center"
                    Text="开" />
                <ToggleSwitch
                    x:Name="BtAutoDownloadToggleSwitch"
                    Width="48"
                    MinWidth="0"
                    Padding="0"
                    OffContent=""
                    OnContent=""
                    IsOn="True"
                    Toggled="BitTorrentSettingToggleSwitch_Toggled" />
            </StackPanel>
        </controls:SettingsCard>

        <controls:SettingsCard
            x:Name="BtForceEncryptionSettingCard"
            x:Uid="BtForceEncryptionSettingCard"
            Description="要求 BitTorrent 消息负载加密，部分旧 Peer 可能无法连接。"
            Header="强制加密">
            <controls:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE72E;" />
            </controls:SettingsCard.HeaderIcon>
            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock
                    x:Name="BtForceEncryptionStateText"
                    VerticalAlignment="Center"
                    Text="关" />
                <ToggleSwitch
                    x:Name="BtForceEncryptionToggleSwitch"
                    Width="48"
                    MinWidth="0"
                    Padding="0"
                    OffContent=""
                    OnContent=""
                    Toggled="BitTorrentSettingToggleSwitch_Toggled" />
            </StackPanel>
        </controls:SettingsCard>

        <controls:SettingsExpander
            x:Name="BtKeepSeedingSettingCard"
            x:Uid="BtKeepSeedingSettingCard"
            Description="选择持续做种，或按分享率与时间自动停止。"
            Header="做种策略">
            <controls:SettingsExpander.HeaderIcon>
                <FontIcon Glyph="&#xE8EE;" />
            </controls:SettingsExpander.HeaderIcon>
            <controls:SettingsExpander.Items>
                <controls:SettingsCard
                    x:Uid="BtSeedingModeCard"
                    Header="做种方式">
                    <ComboBox
                        x:Name="BtSeedingModeComboBox"
                        Width="168"
                        HorizontalAlignment="Right"
                        SelectionChanged="BitTorrentSettingComboBox_SelectionChanged">
                        <ComboBoxItem
                            x:Uid="BtSeedingModeLimitedItem"
                            Content="按条件停止"
                            Tag="Limited" />
                        <ComboBoxItem
                            x:Uid="BtSeedingModeAlwaysItem"
                            Content="持续做种"
                            Tag="Always" />
                    </ComboBox>
                </controls:SettingsCard>
                <controls:SettingsCard
                    x:Uid="BtSeedRatioCard"
                    Header="分享率">
                    <NumberBox
                        x:Name="BtSeedRatioNumberBox"
                        Width="168"
                        HorizontalAlignment="Right"
                        Minimum="0"
                        Maximum="100"
                        SmallChange="0.1"
                        SpinButtonPlacementMode="Inline"
                        ValueChanged="BitTorrentSettingNumberBox_ValueChanged" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    x:Uid="BtSeedTimeCard"
                    Header="分享时间">
                    <NumberBox
                        x:Name="BtSeedTimeNumberBox"
                        Width="168"
                        HorizontalAlignment="Right"
                        Minimum="0"
                        Maximum="525600"
                        SmallChange="10"
                        SpinButtonPlacementMode="Inline"
                        ValueChanged="BitTorrentSettingNumberBox_ValueChanged" />
                </controls:SettingsCard>
            </controls:SettingsExpander.Items>
        </controls:SettingsExpander>

        <controls:SettingsCard
            x:Name="BtMaxPeersSettingCard"
            x:Uid="BtMaxPeersSettingCard"
            Description="每个种子最多连接的 Peer 数量。"
            Header="最大 Peer 数">
            <controls:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE716;" />
            </controls:SettingsCard.HeaderIcon>
            <NumberBox
                x:Name="BtMaxPeersNumberBox"
                Width="168"
                Height="32"
                HorizontalAlignment="Right"
                Minimum="1"
                Maximum="1000"
                SmallChange="8"
                SpinButtonPlacementMode="Inline"
                ValueChanged="BitTorrentSettingNumberBox_ValueChanged" />
        </controls:SettingsCard>

        <!--  Tracker 服务器  -->
        <TextBlock
            Margin="1,30,0,6"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            x:Uid="BitTorrentTrackerServerHeader"
            Text="Tracker 服务器" />

        <controls:SettingsExpander
            x:Name="BtTrackerSourceSettingCard"
            x:Uid="BtTrackerSourceSettingCard"
            Description="管理用于同步 Tracker 列表的 HTTP/HTTPS 文本来源。"
            Header="Tracker 来源"
            ItemsSource="{x:Bind TrackerSourceEntries, Mode=OneWay}">
            <controls:SettingsExpander.HeaderIcon>
                <FontIcon Glyph="&#xE774;" />
            </controls:SettingsExpander.HeaderIcon>
            <controls:SettingsExpander.ItemTemplate>
                <DataTemplate x:DataType="local:TrackerSourceEntry">
                    <controls:SettingsCard
                        Description="{x:Bind Url}"
                        Header="{x:Bind DisplayName}"
                        IsClickEnabled="False">
                        <StackPanel
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="8">
                            <ToggleSwitch
                                Width="48"
                                MinWidth="0"
                                Padding="0"
                                VerticalAlignment="Center"
                                x:Uid="BtTrackerSourceEnabledToggleSwitch"
                                AutomationProperties.Name="启用 Tracker 来源"
                                IsOn="{x:Bind IsSelected, Mode=OneTime}"
                                OffContent=""
                                OnContent=""
                                Tag="{x:Bind Url}"
                                Toggled="BtTrackerSourceEnabledToggleSwitch_Toggled" />
                            <Button
                                Width="40"
                                Height="32"
                                MinWidth="40"
                                Padding="0"
                                x:Uid="EditBtTrackerSourceButton"
                                AutomationProperties.Name="编辑 Tracker 来源"
                                Click="EditBtTrackerSourceButton_Click"
                                Tag="{x:Bind Url}"
                                ToolTipService.ToolTip="编辑 Tracker 来源"
                                Visibility="{x:Bind ModifyVisibility, Mode=OneTime}">
                                <FontIcon FontSize="14" Glyph="&#xE70F;" />
                            </Button>
                            <Button
                                Width="40"
                                Height="32"
                                MinWidth="40"
                                Padding="0"
                                x:Uid="DeleteBtTrackerSourceButton"
                                AutomationProperties.Name="删除 Tracker 来源"
                                Click="DeleteBtTrackerSourceButton_Click"
                                Tag="{x:Bind Url}"
                                ToolTipService.ToolTip="删除 Tracker 来源"
                                Visibility="{x:Bind ModifyVisibility, Mode=OneTime}">
                                <FontIcon FontSize="14" Glyph="&#xE74D;" />
                            </Button>
                        </StackPanel>
                    </controls:SettingsCard>
                </DataTemplate>
            </controls:SettingsExpander.ItemTemplate>
            <controls:SettingsExpander.ItemsFooter>
                <controls:SettingsCard
                    IsClickEnabled="False"
                    Style="{StaticResource DefaultSettingsExpanderItemStyle}">
                    <StackPanel
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Uid="AddBtTrackerSourceButton"
                            AutomationProperties.Name="添加 Tracker 来源"
                            Click="AddBtTrackerSourceButton_Click"
                            Content="添加来源" />
                        <Button
                            x:Name="BtSyncTrackerButton"
                            Width="40"
                            Height="32"
                            MinWidth="40"
                            Padding="0"
                            x:Uid="BtSyncTrackerButton"
                            AutomationProperties.Name="同步 Tracker"
                            Click="SyncBtTrackerButton_Click"
                            ToolTipService.ToolTip="同步 Tracker">
                            <FontIcon FontSize="14" Glyph="&#xE895;" />
                        </Button>
                    </StackPanel>
                </controls:SettingsCard>
            </controls:SettingsExpander.ItemsFooter>
        </controls:SettingsExpander>

        <controls:SettingsExpander
            x:Name="BtTrackerListSettingCard"
            x:Uid="BtTrackerListSettingCard"
            Description="管理 aria2 使用的 Tracker 地址。"
            Header="Tracker 列表"
            ItemsSource="{x:Bind TrackerEntries, Mode=OneWay}">
            <controls:SettingsExpander.HeaderIcon>
                <FontIcon Glyph="&#xE8A5;" />
            </controls:SettingsExpander.HeaderIcon>
            <controls:SettingsExpander.ItemTemplate>
                <DataTemplate x:DataType="local:TrackerEntry">
                    <controls:SettingsCard
                        Header="{x:Bind Address}"
                        IsClickEnabled="False">
                        <StackPanel
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="8">
                            <ToggleSwitch
                                Width="48"
                                MinWidth="0"
                                Padding="0"
                                VerticalAlignment="Center"
                                x:Uid="BtTrackerEnabledToggleSwitch"
                                AutomationProperties.Name="启用 Tracker"
                                IsOn="{x:Bind IsSelected, Mode=OneTime}"
                                OffContent=""
                                OnContent=""
                                Tag="{x:Bind Address}"
                                Toggled="BtTrackerEnabledToggleSwitch_Toggled" />
                            <Button
                                Width="40"
                                Height="32"
                                MinWidth="40"
                                Padding="0"
                                x:Uid="EditBtTrackerButton"
                                AutomationProperties.Name="编辑 Tracker"
                                Click="EditBtTrackerButton_Click"
                                Tag="{x:Bind Address}"
                                ToolTipService.ToolTip="编辑 Tracker">
                                <FontIcon FontSize="14" Glyph="&#xE70F;" />
                            </Button>
                            <Button
                                Width="40"
                                Height="32"
                                MinWidth="40"
                                Padding="0"
                                x:Uid="DeleteBtTrackerButton"
                                AutomationProperties.Name="删除 Tracker"
                                Click="DeleteBtTrackerButton_Click"
                                Tag="{x:Bind Address}"
                                ToolTipService.ToolTip="删除 Tracker">
                                <FontIcon FontSize="14" Glyph="&#xE74D;" />
                            </Button>
                        </StackPanel>
                    </controls:SettingsCard>
                </DataTemplate>
            </controls:SettingsExpander.ItemTemplate>
            <controls:SettingsExpander.ItemsFooter>
                <controls:SettingsCard
                    IsClickEnabled="False"
                    Style="{StaticResource DefaultSettingsExpanderItemStyle}">
                    <controls:SettingsCard.Header>
                        <TextBlock
                            x:Name="BtTrackerListEmptyText"
                            x:Uid="BtTrackerListEmptyText"
                            Text="尚未添加 Tracker。" />
                    </controls:SettingsCard.Header>
                    <Button
                        x:Uid="AddBtTrackerButton"
                        AutomationProperties.Name="添加 Tracker"
                        Click="AddBtTrackerButton_Click"
                        Content="添加 Tracker" />
                </controls:SettingsCard>
            </controls:SettingsExpander.ItemsFooter>
        </controls:SettingsExpander>

        <controls:SettingsCard
            x:Name="BtAutoSyncTrackerSettingCard"
            x:Uid="BtAutoSyncTrackerSettingCard"
            Header="自动同步 Tracker">
            <controls:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE895;" />
            </controls:SettingsCard.HeaderIcon>
            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock
                    x:Name="BtAutoSyncTrackerStateText"
                    VerticalAlignment="Center"
                    Text="关" />
                <ToggleSwitch
                    x:Name="BtAutoSyncTrackerToggleSwitch"
                    Width="48"
                    MinWidth="0"
                    Padding="0"
                    OffContent=""
                    OnContent=""
                    Toggled="BitTorrentSettingToggleSwitch_Toggled" />
            </StackPanel>
            <controls:SettingsCard.Description>
                <TextBlock
                    x:Name="BtLastTrackerSyncText"
                    x:Uid="BtLastTrackerSyncText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="启动设置页时保留上次同步时间。"
                    TextWrapping="WrapWholeWords" />
            </controls:SettingsCard.Description>
        </controls:SettingsCard>
    </StackPanel>
</UserControl>
