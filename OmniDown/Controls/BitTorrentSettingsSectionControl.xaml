<UserControl
    x:Class="OmniDown.Controls.BitTorrentSettingsSectionControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">
    <StackPanel
        x:Name="BitTorrentSettingsContent"
        Margin="0,24,0,36"
        Spacing="4">
        <TextBlock
            AutomationProperties.HeadingLevel="Level1"
            Style="{StaticResource TitleTextBlockStyle}"
            x:Uid="BitTorrentSettingsTitle"
            Text="BitTorrent" />

        <!--  基础选项  -->
        <TextBlock
            Margin="1,30,0,6"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            x:Uid="BitTorrentBasicOptionsHeader"
            Text="基础选项" />

        <controls:SettingsCard
            x:Name="BtAutoDownloadSettingCard"
            x:Uid="BtAutoDownloadSettingCard"
            Description="添加 .torrent、metalink 或磁力链接后自动获取真实文件内容。"
            Header="自动下载种子内容">
            <controls:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE896;" />
            </controls:SettingsCard.HeaderIcon>
            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock
                    x:Name="BtAutoDownloadStateText"
                    VerticalAlignment="Center"
                    Text="开" />
                <ToggleSwitch
                    x:Name="BtAutoDownloadToggleSwitch"
                    Width="48"
                    MinWidth="0"
                    Padding="0"
                    OffContent=""
                    OnContent=""
                    IsOn="True"
                    Toggled="BitTorrentSettingToggleSwitch_Toggled" />
            </StackPanel>
        </controls:SettingsCard>

        <controls:SettingsCard
            x:Name="BtForceEncryptionSettingCard"
            x:Uid="BtForceEncryptionSettingCard"
            Description="要求 BitTorrent 消息负载加密，部分旧 Peer 可能无法连接。"
            Header="强制加密">
            <controls:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE72E;" />
            </controls:SettingsCard.HeaderIcon>
            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock
                    x:Name="BtForceEncryptionStateText"
                    VerticalAlignment="Center"
                    Text="关" />
                <ToggleSwitch
                    x:Name="BtForceEncryptionToggleSwitch"
                    Width="48"
                    MinWidth="0"
                    Padding="0"
                    OffContent=""
                    OnContent=""
                    Toggled="BitTorrentSettingToggleSwitch_Toggled" />
            </StackPanel>
        </controls:SettingsCard>

        <controls:SettingsExpander
            x:Name="BtKeepSeedingSettingCard"
            x:Uid="BtKeepSeedingSettingCard"
            Description="选择持续做种，或按分享率与时间自动停止。"
            Header="做种策略">
            <controls:SettingsExpander.HeaderIcon>
                <FontIcon Glyph="&#xE8EE;" />
            </controls:SettingsExpander.HeaderIcon>
            <controls:SettingsExpander.Items>
                <controls:SettingsCard
                    x:Uid="BtSeedingModeCard"
                    Header="做种方式">
                    <ComboBox
                        x:Name="BtSeedingModeComboBox"
                        Width="168"
                        HorizontalAlignment="Right"
                        SelectionChanged="BitTorrentSettingComboBox_SelectionChanged">
                        <ComboBoxItem
                            x:Uid="BtSeedingModeLimitedItem"
                            Content="按条件停止"
                            Tag="Limited" />
                        <ComboBoxItem
                            x:Uid="BtSeedingModeAlwaysItem"
                            Content="持续做种"
                            Tag="Always" />
                    </ComboBox>
                </controls:SettingsCard>
                <controls:SettingsCard
                    x:Uid="BtSeedRatioCard"
                    Header="分享率">
                    <NumberBox
                        x:Name="BtSeedRatioNumberBox"
                        Width="168"
                        HorizontalAlignment="Right"
                        Minimum="0"
                        Maximum="100"
                        SmallChange="0.1"
                        SpinButtonPlacementMode="Inline"
                        ValueChanged="BitTorrentSettingNumberBox_ValueChanged" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    x:Uid="BtSeedTimeCard"
                    Header="分享时间">
                    <NumberBox
                        x:Name="BtSeedTimeNumberBox"
                        Width="168"
                        HorizontalAlignment="Right"
                        Minimum="0"
                        Maximum="525600"
                        SmallChange="10"
                        SpinButtonPlacementMode="Inline"
                        ValueChanged="BitTorrentSettingNumberBox_ValueChanged" />
                </controls:SettingsCard>
            </controls:SettingsExpander.Items>
        </controls:SettingsExpander>

        <controls:SettingsCard
            x:Name="BtMaxPeersSettingCard"
            x:Uid="BtMaxPeersSettingCard"
            Description="每个种子最多连接的 Peer 数量。"
            Header="最大 Peer 数">
            <controls:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE716;" />
            </controls:SettingsCard.HeaderIcon>
            <NumberBox
                x:Name="BtMaxPeersNumberBox"
                Width="168"
                Height="32"
                HorizontalAlignment="Right"
                Minimum="1"
                Maximum="1000"
                SmallChange="8"
                SpinButtonPlacementMode="Inline"
                ValueChanged="BitTorrentSettingNumberBox_ValueChanged" />
        </controls:SettingsCard>

        <!--  Tracker 服务器  -->
        <TextBlock
            Margin="1,30,0,6"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            x:Uid="BitTorrentTrackerServerHeader"
            Text="Tracker 服务器" />

        <controls:SettingsCard
            x:Name="BtTrackerSourceSettingCard"
            x:Uid="BtTrackerSourceSettingCard"
            Description="从 HTTP/HTTPS 文本源同步 Tracker 列表。"
            Header="Tracker 源">
            <controls:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE774;" />
            </controls:SettingsCard.HeaderIcon>
            <Button
                x:Name="BtTrackerSourceDropDownButton"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch">
                <Button.Content>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6">
                            <ItemsControl x:Name="BtTrackerSourceTokensItemsControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Padding="8,2"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{ThemeResource ControlCornerRadius}">
                                            <TextBlock
                                                MaxWidth="120"
                                                Text="{Binding}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock
                                x:Name="BtTrackerSourcePlaceholderText"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="选择 Tracker 来源" />
                        </StackPanel>
                        <FontIcon
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            FontSize="12"
                            Glyph="&#xE70D;" />
                    </Grid>
                </Button.Content>
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft">
                        <Border
                            Width="360"
                            Padding="12"
                            CornerRadius="4">
                            <ScrollViewer MaxHeight="360">
                                <StackPanel Spacing="10">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            Margin="4,0,0,2"
                                            FontWeight="SemiBold"
                                            Text="ngosang/trackerslist" />
                                        <CheckBox
                                            x:Name="BtTrackerNgosangBestCheckBox"
                                            Content="trackers_best.txt"
                                            Tag="https://raw.githubusercontent.com/ngosang/trackerslist/master/trackers_best.txt"
                                            Checked="BitTorrentSettingCheckBox_Changed"
                                            Unchecked="BitTorrentSettingCheckBox_Changed" />
                                        <CheckBox
                                            x:Name="BtTrackerNgosangBestIpCheckBox"
                                            Content="trackers_best_ip.txt"
                                            Tag="https://raw.githubusercontent.com/ngosang/trackerslist/master/trackers_best_ip.txt"
                                            Checked="BitTorrentSettingCheckBox_Changed"
                                            Unchecked="BitTorrentSettingCheckBox_Changed" />
                                        <CheckBox
                                            x:Name="BtTrackerNgosangAllCheckBox"
                                            Content="trackers_all.txt"
                                            Tag="https://raw.githubusercontent.com/ngosang/trackerslist/master/trackers_all.txt"
                                            Checked="BitTorrentSettingCheckBox_Changed"
                                            Unchecked="BitTorrentSettingCheckBox_Changed" />
                                        <CheckBox
                                            x:Name="BtTrackerNgosangAllIpCheckBox"
                                            Content="trackers_all_ip.txt"
                                            Tag="https://raw.githubusercontent.com/ngosang/trackerslist/master/trackers_all_ip.txt"
                                            Checked="BitTorrentSettingCheckBox_Changed"
                                            Unchecked="BitTorrentSettingCheckBox_Changed" />
                                        <CheckBox
                                            x:Name="BtTrackerNgosangCdnBestCheckBox"
                                            Tag="https://cdn.jsdelivr.net/gh/ngosang/trackerslist/trackers_best.txt"
                                            Checked="BitTorrentSettingCheckBox_Changed"
                                            Unchecked="BitTorrentSettingCheckBox_Changed">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="trackers_best.txt" />
                                                <Border
                                                    Padding="4,0"
                                                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                    CornerRadius="3">
                                                    <TextBlock
                                                        FontSize="11"
                                                        x:Uid="CdnBadgeText"
                                                        Text="CDN" />
                                                </Border>
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox
                                            x:Name="BtTrackerNgosangCdnBestIpCheckBox"
                                            Tag="https://cdn.jsdelivr.net/gh/ngosang/trackerslist/trackers_best_ip.txt"
                                            Checked="BitTorrentSettingCheckBox_Changed"
                                            Unchecked="BitTorrentSettingCheckBox_Changed">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="trackers_best_ip.txt" />
                                                <Border
                                                    Padding="4,0"
                                                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                    CornerRadius="3">
                                                    <TextBlock
                                                        FontSize="11"
                                                        x:Uid="CdnBadgeText"
                                                        Text="CDN" />
                                                </Border>
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox
                                            x:Name="BtTrackerNgosangCdnAllCheckBox"
                                            Tag="https://cdn.jsdelivr.net/gh/ngosang/trackerslist/trackers_all.txt"
                                            Checked="BitTorrentSettingCheckBox_Changed"
                                            Unchecked="BitTorrentSettingCheckBox_Changed">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="trackers_all.txt" />
                                                <Border
                                                    Padding="4,0"
                                                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                    CornerRadius="3">
                                                    <TextBlock
                                                        FontSize="11"
                                                        x:Uid="CdnBadgeText"
                                                        Text="CDN" />
                                                </Border>
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox
                                            x:Name="BtTrackerNgosangCdnAllIpCheckBox"
                                            Tag="https://cdn.jsdelivr.net/gh/ngosang/trackerslist/trackers_all_ip.txt"
                                            Checked="BitTorrentSettingCheckBox_Changed"
                                            Unchecked="BitTorrentSettingCheckBox_Changed">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="trackers_all_ip.txt" />
                                                <Border
                                                    Padding="4,0"
                                                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                    CornerRadius="3">
                                                    <TextBlock
                                                        FontSize="11"
                                                        x:Uid="CdnBadgeText"
                                                        Text="CDN" />
                                                </Border>
                                            </StackPanel>
                                        </CheckBox>
                                    </StackPanel>

                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            Margin="4,2,0,2"
                                            FontWeight="SemiBold"
                                            Text="XIU2/TrackersListCollection" />
                                        <CheckBox
                                            x:Name="BtTrackerXiu2BestCheckBox"
                                            Content="best.txt"
                                            Tag="https://raw.githubusercontent.com/XIU2/TrackersListCollection/master/best.txt"
                                            Checked="BitTorrentSettingCheckBox_Changed"
                                            Unchecked="BitTorrentSettingCheckBox_Changed" />
                                        <CheckBox
                                            x:Name="BtTrackerXiu2AllCheckBox"
                                            Content="all.txt"
                                            Tag="https://raw.githubusercontent.com/XIU2/TrackersListCollection/master/all.txt"
                                            Checked="BitTorrentSettingCheckBox_Changed"
                                            Unchecked="BitTorrentSettingCheckBox_Changed" />
                                        <CheckBox
                                            x:Name="BtTrackerXiu2HttpCheckBox"
                                            Content="http.txt"
                                            Tag="https://raw.githubusercontent.com/XIU2/TrackersListCollection/master/http.txt"
                                            Checked="BitTorrentSettingCheckBox_Changed"
                                            Unchecked="BitTorrentSettingCheckBox_Changed" />
                                        <CheckBox
                                            x:Name="BtTrackerXiu2CdnBestCheckBox"
                                            Tag="https://cdn.jsdelivr.net/gh/XIU2/TrackersListCollection/best.txt"
                                            Checked="BitTorrentSettingCheckBox_Changed"
                                            Unchecked="BitTorrentSettingCheckBox_Changed">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="best.txt" />
                                                <Border
                                                    Padding="4,0"
                                                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                    CornerRadius="3">
                                                    <TextBlock
                                                        FontSize="11"
                                                        x:Uid="CdnBadgeText"
                                                        Text="CDN" />
                                                </Border>
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox
                                            x:Name="BtTrackerXiu2CdnAllCheckBox"
                                            Tag="https://cdn.jsdelivr.net/gh/XIU2/TrackersListCollection/all.txt"
                                            Checked="BitTorrentSettingCheckBox_Changed"
                                            Unchecked="BitTorrentSettingCheckBox_Changed">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="all.txt" />
                                                <Border
                                                    Padding="4,0"
                                                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                    CornerRadius="3">
                                                    <TextBlock
                                                        FontSize="11"
                                                        x:Uid="CdnBadgeText"
                                                        Text="CDN" />
                                                </Border>
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox
                                            x:Name="BtTrackerXiu2CdnHttpCheckBox"
                                            Tag="https://cdn.jsdelivr.net/gh/XIU2/TrackersListCollection/http.txt"
                                            Checked="BitTorrentSettingCheckBox_Changed"
                                            Unchecked="BitTorrentSettingCheckBox_Changed">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="http.txt" />
                                                <Border
                                                    Padding="4,0"
                                                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                    CornerRadius="3">
                                                    <TextBlock
                                                        FontSize="11"
                                                        x:Uid="CdnBadgeText"
                                                        Text="CDN" />
                                                </Border>
                                            </StackPanel>
                                        </CheckBox>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </controls:SettingsCard>

        <controls:SettingsCard
            x:Name="BtTrackerCustomSourceSettingCard"
            x:Uid="BtTrackerCustomSourceSettingCard"
            Description="添加自己的 Tracker 列表 URL，可多选后一起同步。"
            Header="自定义来源">
            <controls:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE710;" />
            </controls:SettingsCard.HeaderIcon>
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                    <TextBox
                        x:Name="BtCustomTrackerSourceTextBox"
                        x:Uid="BtCustomTrackerSourceTextBox"
                        PlaceholderText="输入自定义 Tracker 列表 URL" />
                    <Button
                        Grid.Column="1"
                        Width="38"
                        Height="32"
                        Click="AddBtCustomTrackerButton_Click">
                        <FontIcon
                            FontSize="14"
                            Glyph="&#xE710;" />
                    </Button>
                    <Button
                        x:Name="BtSyncTrackerButton"
                        Grid.Column="2"
                        Width="38"
                        Height="32"
                        x:Uid="BtSyncTrackerButton"
                        Click="SyncBtTrackerButton_Click"
                        ToolTipService.ToolTip="同步 Tracker">
                        <FontIcon
                            FontSize="14"
                            Glyph="&#xE895;" />
                    </Button>
                </Grid>
                <ListView
                    x:Name="BtCustomTrackerSourceListView"
                    MaxHeight="112"
                    SelectionMode="Multiple"
                    SelectionChanged="BitTorrentSettingListView_SelectionChanged" />
                <TextBox
                    x:Name="BtTrackerSourceTextBox"
                    Visibility="Collapsed"
                    PlaceholderText="https://example.com/trackers.txt"
                    TextChanged="BitTorrentSettingTextBox_TextChanged" />
            </StackPanel>
        </controls:SettingsCard>

        <controls:SettingsExpander
            x:Name="BtTrackerListSettingCard"
            x:Uid="BtTrackerListSettingCard"
            Description="每行一个 Tracker，启动 aria2 时会转为逗号分隔配置。"
            Header="Tracker 列表">
            <controls:SettingsExpander.HeaderIcon>
                <FontIcon Glyph="&#xE8A5;" />
            </controls:SettingsExpander.HeaderIcon>
            <controls:SettingsExpander.Items>
                <controls:SettingsCard>
                    <TextBox
                        x:Name="BtTrackerListTextBox"
                        x:Uid="BtTrackerListTextBox"
                        Height="220"
                        AcceptsReturn="True"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        TextWrapping="Wrap"
                        PlaceholderText="udp://tracker.example:6969/announce"
                        TextChanged="BitTorrentSettingTextBox_TextChanged" />
                </controls:SettingsCard>
            </controls:SettingsExpander.Items>
        </controls:SettingsExpander>

        <controls:SettingsCard
            x:Name="BtAutoSyncTrackerSettingCard"
            x:Uid="BtAutoSyncTrackerSettingCard"
            Header="自动同步 Tracker">
            <controls:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE895;" />
            </controls:SettingsCard.HeaderIcon>
            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock
                    x:Name="BtAutoSyncTrackerStateText"
                    VerticalAlignment="Center"
                    Text="关" />
                <ToggleSwitch
                    x:Name="BtAutoSyncTrackerToggleSwitch"
                    Width="48"
                    MinWidth="0"
                    Padding="0"
                    OffContent=""
                    OnContent=""
                    Toggled="BitTorrentSettingToggleSwitch_Toggled" />
            </StackPanel>
            <controls:SettingsCard.Description>
                <TextBlock
                    x:Name="BtLastTrackerSyncText"
                    x:Uid="BtLastTrackerSyncText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="启动设置页时保留上次同步时间。"
                    TextWrapping="WrapWholeWords" />
            </controls:SettingsCard.Description>
        </controls:SettingsCard>
    </StackPanel>
</UserControl>
