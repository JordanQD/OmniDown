<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="OmniDown.Controls.TaskDetailsPaneControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="TaskDetailsPropertyNameTextBlockStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="TaskDetailsPropertyValueTextBlockStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>
        <Style x:Key="TaskDetailsPropertyRowBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="0,8" />
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
    </UserControl.Resources>

    <Border
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
        BackgroundSizing="InnerBorderEdge"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Grid RowDefinitions="Auto,*">
            <ScrollViewer
                Grid.Row="0"
                Margin="8,0,8,0"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Enabled"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled">
                <SelectorBar
                    x:Name="TaskDetailsSelectorBar"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="TaskDetailsSelectorBar_SelectionChanged">
                    <SelectorBarItem
                        x:Name="TaskDetailsSummaryItem"
                        Text="概要"
                        Tag="Summary" />
                    <SelectorBarItem
                        x:Name="TaskDetailsAriaStatusItem"
                        Text="aria2 状态"
                        Tag="AriaStatus" />
                    <SelectorBarItem
                        x:Name="TaskDetailsFilesItem"
                        Text="文件"
                        Tag="Files" />
                    <SelectorBarItem
                        x:Name="TaskDetailsOptionsItem"
                        Text="选项"
                        Tag="Options" />
                    <SelectorBarItem
                        x:Name="TaskDetailsSourceItem"
                        Text="来源"
                        Tag="Source" />
                    <SelectorBarItem
                        x:Name="TaskDetailsStatusItem"
                        Text="状态"
                        Tag="Status" />
                    <SelectorBarItem
                        x:Name="TaskDetailsPeersItem"
                        Text="节点"
                        Tag="Peers" />
                    <SelectorBarItem
                        x:Name="TaskDetailsTrackersItem"
                        Text="追踪器"
                        Tag="Trackers" />
                </SelectorBar>
            </ScrollViewer>

            <ScrollViewer
                Grid.Row="1"
                Padding="16,10,16,18"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <Grid>
                    <StackPanel
                        x:Name="TaskDetailsOverviewContent"
                        Spacing="0">
                        <StackPanel>
                            <Border Style="{StaticResource TaskDetailsPropertyRowBorderStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource TaskDetailsPropertyNameTextBlockStyle}" Text="{Binding ItemCountLabel}" />
                                    <TextBlock Style="{StaticResource TaskDetailsPropertyValueTextBlockStyle}" Text="{Binding OverviewItemCountText}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TaskDetailsPropertyRowBorderStyle}">
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Style="{StaticResource TaskDetailsPropertyNameTextBlockStyle}" Text="{Binding TransferCountLabel}" />
                                        <TextBlock Style="{StaticResource TaskDetailsPropertyValueTextBlockStyle}" Text="{Binding OverviewActiveCountText}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Style="{StaticResource TaskDetailsPropertyNameTextBlockStyle}" Text="{Binding PausedCountLabel}" />
                                        <TextBlock Style="{StaticResource TaskDetailsPropertyValueTextBlockStyle}" Text="{Binding OverviewPausedCountText}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4">
                                        <TextBlock Style="{StaticResource TaskDetailsPropertyNameTextBlockStyle}" Text="{Binding IssueCountLabel}" />
                                        <TextBlock Style="{StaticResource TaskDetailsPropertyValueTextBlockStyle}" Text="{Binding OverviewIssueCountText}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource TaskDetailsPropertyRowBorderStyle}">
                                <Grid RowDefinitions="Auto,Auto">
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding ToggleSpeedLimitEditorCommand}"
                                        CommandParameter="GlobalUpload"
                                        Padding="0">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <StackPanel Spacing="4">
                                                <TextBlock Style="{StaticResource TaskDetailsPropertyNameTextBlockStyle}" Text="{Binding UploadSpeedLabel}" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Style="{StaticResource TaskDetailsPropertyValueTextBlockStyle}" Text="{Binding OverviewUploadSpeedText}" />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{Binding OverviewUploadLimitText}"
                                                        Visibility="{Binding OverviewUploadLimitVisibility}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <FontIcon
                                                Grid.Column="1"
                                                FontSize="12"
                                                Glyph="{Binding OverviewUploadLimitChevron}" />
                                        </Grid>
                                    </Button>
                                    <StackPanel
                                        Grid.Row="1"
                                        Margin="0,8,0,0"
                                        Spacing="8"
                                        Visibility="{Binding OverviewUploadLimitEditorVisibility}">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock
                                                Style="{StaticResource TaskDetailsPropertyNameTextBlockStyle}"
                                                Text="{Binding SpeedLimitEnabledLabel}" />
                                            <ToggleSwitch
                                                Grid.Column="2"
                                                MinWidth="0"
                                                IsOn="{Binding OverviewUploadLimitEnabled, Mode=TwoWay}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                            <NumberBox
                                                IsEnabled="{Binding IsOverviewUploadLimitInputEnabled}"
                                                Minimum="1"
                                                SpinButtonPlacementMode="Inline"
                                                Value="{Binding OverviewUploadLimitValue, Mode=TwoWay}" />
                                            <ComboBox
                                                Grid.Column="1"
                                                IsEnabled="{Binding IsOverviewUploadLimitInputEnabled}"
                                                SelectedValue="{Binding OverviewUploadLimitUnit, Mode=TwoWay}"
                                                SelectedValuePath="Content">
                                                <ComboBoxItem Content="KB/s" />
                                                <ComboBoxItem Content="MB/s" />
                                            </ComboBox>
                                            <Button
                                                Grid.Column="2"
                                                VerticalAlignment="Stretch"
                                                Command="{Binding ApplySpeedLimitCommand}"
                                                CommandParameter="GlobalUpload"
                                                ToolTipService.ToolTip="{Binding SpeedLimitApplyText}">
                                                <FontIcon FontSize="14" Glyph="&#xE8FB;" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource TaskDetailsPropertyRowBorderStyle}">
                                <Grid RowDefinitions="Auto,Auto">
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding ToggleSpeedLimitEditorCommand}"
                                        CommandParameter="GlobalDownload"
                                        Padding="0">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <StackPanel Spacing="4">
                                                <TextBlock Style="{StaticResource TaskDetailsPropertyNameTextBlockStyle}" Text="{Binding DownloadSpeedLabel}" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Style="{StaticResource TaskDetailsPropertyValueTextBlockStyle}" Text="{Binding OverviewDownloadSpeedText}" />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{Binding OverviewDownloadLimitText}"
                                                        Visibility="{Binding OverviewDownloadLimitVisibility}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <FontIcon
                                                Grid.Column="1"
                                                FontSize="12"
                                                Glyph="{Binding OverviewDownloadLimitChevron}" />
                                        </Grid>
                                    </Button>
                                    <StackPanel
                                        Grid.Row="1"
                                        Margin="0,8,0,0"
                                        Spacing="8"
                                        Visibility="{Binding OverviewDownloadLimitEditorVisibility}">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock
                                                Style="{StaticResource TaskDetailsPropertyNameTextBlockStyle}"
                                                Text="{Binding SpeedLimitEnabledLabel}" />
                                            <ToggleSwitch
                                                Grid.Column="2"
                                                MinWidth="0"
                                                IsOn="{Binding OverviewDownloadLimitEnabled, Mode=TwoWay}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                            <NumberBox
                                                IsEnabled="{Binding IsOverviewDownloadLimitInputEnabled}"
                                                Minimum="1"
                                                SpinButtonPlacementMode="Inline"
                                                Value="{Binding OverviewDownloadLimitValue, Mode=TwoWay}" />
                                            <ComboBox
                                                Grid.Column="1"
                                                IsEnabled="{Binding IsOverviewDownloadLimitInputEnabled}"
                                                SelectedValue="{Binding OverviewDownloadLimitUnit, Mode=TwoWay}"
                                                SelectedValuePath="Content">
                                                <ComboBoxItem Content="KB/s" />
                                                <ComboBoxItem Content="MB/s" />
                                            </ComboBox>
                                            <Button
                                                Grid.Column="2"
                                                VerticalAlignment="Stretch"
                                                Command="{Binding ApplySpeedLimitCommand}"
                                                CommandParameter="GlobalDownload"
                                                ToolTipService.ToolTip="{Binding SpeedLimitApplyText}">
                                                <FontIcon FontSize="14" Glyph="&#xE8FB;" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel
                        x:Name="TaskDetailsAriaStatusContent"
                        Spacing="0"
                        Visibility="Collapsed">
                        <StackPanel>
                            <Border Style="{StaticResource TaskDetailsPropertyRowBorderStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource TaskDetailsPropertyNameTextBlockStyle}" Text="引擎版本" />
                                    <TextBlock x:Name="TaskDetailsAriaVersionText" Style="{StaticResource TaskDetailsPropertyValueTextBlockStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TaskDetailsPropertyRowBorderStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource TaskDetailsPropertyNameTextBlockStyle}" Text="当前状态" />
                                    <TextBlock x:Name="TaskDetailsAriaRunningStateText" Style="{StaticResource TaskDetailsPropertyValueTextBlockStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TaskDetailsPropertyRowBorderStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource TaskDetailsPropertyNameTextBlockStyle}" Text="进程" />
                                    <TextBlock x:Name="TaskDetailsAriaProcessText" Style="{StaticResource TaskDetailsPropertyValueTextBlockStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TaskDetailsPropertyRowBorderStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource TaskDetailsPropertyNameTextBlockStyle}" Text="RPC 端点" />
                                    <TextBlock x:Name="TaskDetailsAriaEndpointText" Style="{StaticResource TaskDetailsPropertyValueTextBlockStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Padding="0,8">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource TaskDetailsPropertyNameTextBlockStyle}" Text="诊断信息" />
                                    <TextBlock x:Name="TaskDetailsAriaDiagnosticText" Style="{StaticResource TaskDetailsPropertyValueTextBlockStyle}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel
                        x:Name="TaskDetailsSummaryContent"
                        Spacing="0"
                        Visibility="Collapsed">
                        <!-- Hero: icon + name/status -->
                        <Grid
                            Margin="0,6,0,10"
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="12">
                            <Border
                                Width="48"
                                Height="48"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <FontIcon
                                    x:Name="TaskDetailsHeroIcon"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="24"
                                    Glyph="&#xE7C3;" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center">
                                <TextBlock
                                    x:Name="TaskDetailsNameText"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    MaxLines="2"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <!-- Property rows -->
                        <StackPanel>
                            <Border Style="{StaticResource TaskDetailsPropertyRowBorderStyle}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="4">
                                        <TextBlock Style="{StaticResource TaskDetailsPropertyNameTextBlockStyle}" Text="GID" />
                                        <TextBlock x:Name="TaskDetailsGidText" Style="{StaticResource TaskDetailsPropertyValueTextBlockStyle}" />
                                    </StackPanel>
                                    <Button
                                        x:Name="TaskDetailsCopyGidButton"
                                        Grid.Column="1"
                                        Width="32"
                                        Height="32"
                                        Padding="0"
                                        VerticalAlignment="Bottom"
                                        Click="TaskDetailsCopyGidButton_Click"
                                        ToolTipService.ToolTip="复制 GID">
                                        <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                                    </Button>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource TaskDetailsPropertyRowBorderStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource TaskDetailsPropertyNameTextBlockStyle}" Text="大小" />
                                    <TextBlock x:Name="TaskDetailsSizeText" Style="{StaticResource TaskDetailsPropertyValueTextBlockStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TaskDetailsPropertyRowBorderStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource TaskDetailsPropertyNameTextBlockStyle}" Text="添加时间" />
                                    <TextBlock x:Name="TaskDetailsCreatedAtText" Style="{StaticResource TaskDetailsPropertyValueTextBlockStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TaskDetailsPropertyRowBorderStyle}">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                                    <StackPanel Spacing="4">
                                        <TextBlock Style="{StaticResource TaskDetailsPropertyNameTextBlockStyle}" Text="下载路径" />
                                        <TextBlock x:Name="TaskDetailsDownloadPathText" Style="{StaticResource TaskDetailsPropertyValueTextBlockStyle}" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button
                                        x:Name="TaskDetailsOpenDownloadFileButton"
                                        Grid.Column="1"
                                        Width="32"
                                        Height="32"
                                        Padding="0"
                                        VerticalAlignment="Bottom"
                                        Click="TaskDetailsOpenDownloadFileButton_Click"
                                        ToolTipService.ToolTip="打开文件">
                                        <FontIcon FontSize="14" Glyph="&#xE8E5;" />
                                    </Button>
                                    <Button
                                        x:Name="TaskDetailsOpenDownloadFolderButton"
                                        Grid.Column="2"
                                        Width="32"
                                        Height="32"
                                        Padding="0"
                                        VerticalAlignment="Bottom"
                                        Click="TaskDetailsOpenDownloadFolderButton_Click"
                                        ToolTipService.ToolTip="打开文件夹">
                                        <FontIcon FontSize="14" Glyph="&#xE838;" />
                                    </Button>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource TaskDetailsPropertyRowBorderStyle}">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                                    <StackPanel Spacing="4">
                                        <TextBlock Style="{StaticResource TaskDetailsPropertyNameTextBlockStyle}" Text="来源" />
                                        <TextBlock x:Name="TaskDetailsSourceText" Style="{StaticResource TaskDetailsPropertyValueTextBlockStyle}" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button
                                        x:Name="TaskDetailsOpenSourceFileButton"
                                        Grid.Column="1"
                                        Width="32"
                                        Height="32"
                                        Padding="0"
                                        VerticalAlignment="Bottom"
                                        Click="TaskDetailsOpenSourceFileButton_Click"
                                        ToolTipService.ToolTip="打开文件">
                                        <FontIcon FontSize="14" Glyph="&#xE8E5;" />
                                    </Button>
                                    <Button
                                        x:Name="TaskDetailsOpenSourceFolderButton"
                                        Grid.Column="2"
                                        Width="32"
                                        Height="32"
                                        Padding="0"
                                        VerticalAlignment="Bottom"
                                        Click="TaskDetailsOpenSourceFolderButton_Click"
                                        ToolTipService.ToolTip="打开文件夹">
                                        <FontIcon FontSize="14" Glyph="&#xE838;" />
                                    </Button>
                                </Grid>
                            </Border>
                            <Border Padding="0,8">
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock
                                        Style="{StaticResource TaskDetailsPropertyNameTextBlockStyle}"
                                        Text="状态" />
                                    <TextBlock
                                        x:Name="TaskDetailsStatusDetailText"
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource TaskDetailsPropertyValueTextBlockStyle}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                        <!-- Progress section (merged from Activity) -->
                        <ProgressBar
                            x:Name="TaskDetailsProgressBar"
                            Height="8"
                            Margin="0,12,0,0"
                            Maximum="100" />
                        <Border
                            Padding="0,6,0,8"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                    x:Name="TaskDetailsProgressPercentText"
                                    Style="{StaticResource TaskDetailsPropertyValueTextBlockStyle}" />
                                <TextBlock
                                    x:Name="TaskDetailsCompletedText"
                                    Grid.Column="1"
                                    Style="{StaticResource TaskDetailsPropertyValueTextBlockStyle}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource TaskDetailsPropertyRowBorderStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource TaskDetailsPropertyNameTextBlockStyle}" Text="剩余时间" />
                                <TextBlock x:Name="TaskDetailsRemainingText" Style="{StaticResource TaskDetailsPropertyValueTextBlockStyle}" />
                            </StackPanel>
                        </Border>
                        <Border
                            Style="{StaticResource TaskDetailsPropertyRowBorderStyle}"
                            Visibility="{Binding TaskUploadSectionVisibility}">
                            <Grid RowDefinitions="Auto,Auto">
                                <Button
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding ToggleSpeedLimitEditorCommand}"
                                    CommandParameter="TaskUpload"
                                    Padding="0">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <StackPanel Spacing="4">
                                            <TextBlock Style="{StaticResource TaskDetailsPropertyNameTextBlockStyle}" Text="{Binding UploadSpeedLabel}" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Style="{StaticResource TaskDetailsPropertyValueTextBlockStyle}" Text="{Binding TaskUploadSpeedText}" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding TaskUploadLimitText}"
                                                    Visibility="{Binding TaskUploadLimitVisibility}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <FontIcon
                                            Grid.Column="1"
                                            FontSize="12"
                                            Glyph="{Binding TaskUploadLimitChevron}" />
                                    </Grid>
                                </Button>
                                <StackPanel
                                    Grid.Row="1"
                                    Margin="0,8,0,0"
                                    Spacing="8"
                                    Visibility="{Binding TaskUploadLimitEditorVisibility}">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock
                                            Style="{StaticResource TaskDetailsPropertyNameTextBlockStyle}"
                                            Text="{Binding SpeedLimitEnabledLabel}" />
                                        <ToggleSwitch
                                            Grid.Column="2"
                                            MinWidth="0"
                                            IsOn="{Binding TaskUploadLimitEnabled, Mode=TwoWay}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <NumberBox
                                            IsEnabled="{Binding IsTaskUploadLimitInputEnabled}"
                                            Minimum="1"
                                            SpinButtonPlacementMode="Inline"
                                            Value="{Binding TaskUploadLimitValue, Mode=TwoWay}" />
                                        <ComboBox
                                            Grid.Column="1"
                                            IsEnabled="{Binding IsTaskUploadLimitInputEnabled}"
                                            SelectedValue="{Binding TaskUploadLimitUnit, Mode=TwoWay}"
                                            SelectedValuePath="Content">
                                            <ComboBoxItem Content="KB/s" />
                                            <ComboBoxItem Content="MB/s" />
                                        </ComboBox>
                                        <Button
                                            Grid.Column="2"
                                            VerticalAlignment="Stretch"
                                            Command="{Binding ApplySpeedLimitCommand}"
                                            CommandParameter="TaskUpload"
                                            ToolTipService.ToolTip="{Binding SpeedLimitApplyText}">
                                            <FontIcon FontSize="14" Glyph="&#xE8FB;" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Padding="0,8">
                            <Grid RowDefinitions="Auto,Auto">
                                <Button
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding ToggleSpeedLimitEditorCommand}"
                                    CommandParameter="TaskDownload"
                                    Padding="0">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <StackPanel Spacing="4">
                                            <TextBlock Style="{StaticResource TaskDetailsPropertyNameTextBlockStyle}" Text="{Binding DownloadSpeedLabel}" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Style="{StaticResource TaskDetailsPropertyValueTextBlockStyle}" Text="{Binding TaskDownloadSpeedText}" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding TaskDownloadLimitText}"
                                                    Visibility="{Binding TaskDownloadLimitVisibility}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <FontIcon
                                            Grid.Column="1"
                                            FontSize="12"
                                            Glyph="{Binding TaskDownloadLimitChevron}" />
                                    </Grid>
                                </Button>
                                <StackPanel
                                    Grid.Row="1"
                                    Margin="0,8,0,0"
                                    Spacing="8"
                                    Visibility="{Binding TaskDownloadLimitEditorVisibility}">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock
                                            Style="{StaticResource TaskDetailsPropertyNameTextBlockStyle}"
                                            Text="{Binding SpeedLimitEnabledLabel}" />
                                        <ToggleSwitch
                                            Grid.Column="2"
                                            MinWidth="0"
                                            IsOn="{Binding TaskDownloadLimitEnabled, Mode=TwoWay}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <NumberBox
                                            IsEnabled="{Binding IsTaskDownloadLimitInputEnabled}"
                                            Minimum="1"
                                            SpinButtonPlacementMode="Inline"
                                            Value="{Binding TaskDownloadLimitValue, Mode=TwoWay}" />
                                        <ComboBox
                                            Grid.Column="1"
                                            IsEnabled="{Binding IsTaskDownloadLimitInputEnabled}"
                                            SelectedValue="{Binding TaskDownloadLimitUnit, Mode=TwoWay}"
                                            SelectedValuePath="Content">
                                            <ComboBoxItem Content="KB/s" />
                                            <ComboBoxItem Content="MB/s" />
                                        </ComboBox>
                                        <Button
                                            Grid.Column="2"
                                            VerticalAlignment="Stretch"
                                            Command="{Binding ApplySpeedLimitCommand}"
                                            CommandParameter="TaskDownload"
                                            ToolTipService.ToolTip="{Binding SpeedLimitApplyText}">
                                            <FontIcon FontSize="14" Glyph="&#xE8FB;" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel
                        x:Name="TaskDetailsFilesContent"
                        Spacing="0"
                        Visibility="Collapsed">
                        <StackPanel>
                            <Border Style="{StaticResource TaskDetailsPropertyRowBorderStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource TaskDetailsPropertyNameTextBlockStyle}" Text="文件名" />
                                    <TextBlock x:Name="TaskDetailsFileNameText" Style="{StaticResource TaskDetailsPropertyValueTextBlockStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TaskDetailsPropertyRowBorderStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource TaskDetailsPropertyNameTextBlockStyle}" Text="完整路径" />
                                    <TextBlock x:Name="TaskDetailsFilePathText" Style="{StaticResource TaskDetailsPropertyValueTextBlockStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TaskDetailsPropertyRowBorderStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource TaskDetailsPropertyNameTextBlockStyle}" Text="保存目录" />
                                    <TextBlock x:Name="TaskDetailsSaveDirectoryText" Style="{StaticResource TaskDetailsPropertyValueTextBlockStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Padding="0,8">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource TaskDetailsPropertyNameTextBlockStyle}" Text="本地状态" />
                                    <TextBlock x:Name="TaskDetailsLocalStateText" Style="{StaticResource TaskDetailsPropertyValueTextBlockStyle}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel
                        x:Name="TaskDetailsOptionsContent"
                        Spacing="0"
                        Visibility="Collapsed">
                        <StackPanel>
                            <Border Style="{StaticResource TaskDetailsPropertyRowBorderStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource TaskDetailsPropertyNameTextBlockStyle}" Text="任务类型" />
                                    <TextBlock x:Name="TaskDetailsTaskTypeText" Style="{StaticResource TaskDetailsPropertyValueTextBlockStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TaskDetailsPropertyRowBorderStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource TaskDetailsPropertyNameTextBlockStyle}" Text="aria2 会话" />
                                    <TextBlock x:Name="TaskDetailsSessionText" Style="{StaticResource TaskDetailsPropertyValueTextBlockStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TaskDetailsPropertyRowBorderStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource TaskDetailsPropertyNameTextBlockStyle}" Text="来源协议" />
                                    <TextBlock x:Name="TaskDetailsProtocolText" Style="{StaticResource TaskDetailsPropertyValueTextBlockStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Padding="0,8">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource TaskDetailsPropertyNameTextBlockStyle}" Text="任务级选项" />
                                    <TextBlock x:Name="TaskDetailsTaskOptionsText" Style="{StaticResource TaskDetailsPropertyValueTextBlockStyle}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel
                        x:Name="TaskDetailsPeersContent"
                        Spacing="0"
                        Visibility="Collapsed">
                        <StackPanel>
                            <Border Style="{StaticResource TaskDetailsPropertyRowBorderStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource TaskDetailsPropertyNameTextBlockStyle}" Text="传输模式" />
                                    <TextBlock x:Name="TaskDetailsPeerModeText" Style="{StaticResource TaskDetailsPropertyValueTextBlockStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TaskDetailsPropertyRowBorderStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource TaskDetailsPropertyNameTextBlockStyle}" Text="上行速度" />
                                    <TextBlock x:Name="TaskDetailsPeerUploadText" Style="{StaticResource TaskDetailsPropertyValueTextBlockStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TaskDetailsPropertyRowBorderStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource TaskDetailsPropertyNameTextBlockStyle}" Text="下行速度" />
                                    <TextBlock x:Name="TaskDetailsPeerDownloadText" Style="{StaticResource TaskDetailsPropertyValueTextBlockStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Padding="0,8">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource TaskDetailsPropertyNameTextBlockStyle}" Text="节点明细" />
                                    <TextBlock x:Name="TaskDetailsPeerDetailText" Style="{StaticResource TaskDetailsPropertyValueTextBlockStyle}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel
                        x:Name="TaskDetailsSourceContent"
                        Spacing="0"
                        Visibility="Collapsed">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="来源明细尚未接入。"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>

                    <StackPanel
                        x:Name="TaskDetailsStatusContent"
                        Spacing="0"
                        Visibility="Collapsed">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="BT 状态明细尚未接入。"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>

                    <StackPanel
                        x:Name="TaskDetailsTrackersContent"
                        Spacing="0"
                        Visibility="Collapsed">
                        <StackPanel>
                            <Border Style="{StaticResource TaskDetailsPropertyRowBorderStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource TaskDetailsPropertyNameTextBlockStyle}" Text="适用性" />
                                    <TextBlock x:Name="TaskDetailsTrackerApplicabilityText" Style="{StaticResource TaskDetailsPropertyValueTextBlockStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TaskDetailsPropertyRowBorderStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource TaskDetailsPropertyNameTextBlockStyle}" Text="来源" />
                                    <TextBlock x:Name="TaskDetailsTrackerSourceText" Style="{StaticResource TaskDetailsPropertyValueTextBlockStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Padding="0,8">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource TaskDetailsPropertyNameTextBlockStyle}" Text="Tracker 明细" />
                                    <TextBlock x:Name="TaskDetailsTrackerDetailText" Style="{StaticResource TaskDetailsPropertyValueTextBlockStyle}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
