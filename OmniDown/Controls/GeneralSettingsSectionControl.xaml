<UserControl
    x:Class="OmniDown.Controls.GeneralSettingsSectionControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OmniDown.Controls">
                                    <StackPanel
                                        x:Name="GeneralSettingsContent"
                                        Spacing="0">
                                        <TextBlock
                                            Margin="4,0,4,20"
                                            Style="{StaticResource TitleTextBlockStyle}"
                                            Text="通用" />
                                        <TextBlock
                                            Margin="4,0,4,8"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="启动" />
                                        <local:SettingCardControl
                                            x:Name="StartupSettingCard"
                                            Description="开机登录后打开 OmniDown。"
                                            Header="登录时自动启动"
                                            IconGlyph="&#xE7C3;">
                                            <local:SettingCardControl.ActionContent>
                                                <StackPanel
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="8">
                                                    <TextBlock
                                                        x:Name="AutoStartStateText"
                                                        VerticalAlignment="Center"
                                                        Text="开" />
                                                    <ToggleSwitch
                                                        x:Name="AutoStartToggleSwitch"
                                                        Width="48"
                                                        MinWidth="0"
                                                        Padding="0"
                                                        OffContent=""
                                                        OnContent=""
                                                        AutomationProperties.AutomationId="AutoStartToggleSwitch"
                                                        Toggled="SettingToggleSwitch_Toggled" />
                                                </StackPanel>
                                            </local:SettingCardControl.ActionContent>
                                        </local:SettingCardControl>

                                        <local:SettingCardControl
                                            x:Name="RestoreWindowSettingCard"
                                            Margin="0,8,0,0"
                                            Description="记住上次大小和位置。"
                                            Header="恢复窗口位置"
                                            IconGlyph="&#xE740;">
                                            <local:SettingCardControl.ActionContent>
                                                <StackPanel
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="8">
                                                    <TextBlock
                                                        x:Name="RestoreWindowPlacementStateText"
                                                        VerticalAlignment="Center"
                                                        Text="关" />
                                                    <ToggleSwitch
                                                        x:Name="RestoreWindowPlacementToggleSwitch"
                                                        Width="48"
                                                        MinWidth="0"
                                                        Padding="0"
                                                        OffContent=""
                                                        OnContent=""
                                                        AutomationProperties.AutomationId="RestoreWindowPlacementToggleSwitch"
                                                        Toggled="SettingToggleSwitch_Toggled" />
                                                </StackPanel>
                                            </local:SettingCardControl.ActionContent>
                                        </local:SettingCardControl>

                                        <local:SettingCardControl
                                            x:Name="ResumeOnLaunchSettingCard"
                                            Margin="0,8,0,0"
                                            Description="继续上次暂停的未完成任务。"
                                            Header="启动时恢复下载任务"
                                            IconGlyph="&#xE768;">
                                            <local:SettingCardControl.ActionContent>
                                                <StackPanel
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="8">
                                                    <TextBlock
                                                        x:Name="ResumeDownloadsOnLaunchStateText"
                                                        VerticalAlignment="Center"
                                                        Text="关" />
                                                    <ToggleSwitch
                                                        x:Name="ResumeDownloadsOnLaunchToggleSwitch"
                                                        Width="48"
                                                        MinWidth="0"
                                                        Padding="0"
                                                        OffContent=""
                                                        OnContent=""
                                                        AutomationProperties.AutomationId="ResumeDownloadsOnLaunchToggleSwitch"
                                                        Toggled="SettingToggleSwitch_Toggled" />
                                                </StackPanel>
                                            </local:SettingCardControl.ActionContent>
                                        </local:SettingCardControl>

                                        <local:SettingCardControl
                                            x:Name="ExitCleanupSettingCard"
                                            Margin="0,8,0,0"
                                            Description="仅清除记录，不删除文件。"
                                            Header="退出时清理已完成"
                                            IconGlyph="&#xE74D;">
                                            <local:SettingCardControl.ActionContent>
                                                <StackPanel
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="8">
                                                    <TextBlock
                                                        x:Name="AutoClearCompletedOnExitStateText"
                                                        VerticalAlignment="Center"
                                                        Text="关" />
                                                    <ToggleSwitch
                                                        x:Name="AutoClearCompletedOnExitToggleSwitch"
                                                        Width="48"
                                                        MinWidth="0"
                                                        Padding="0"
                                                        OffContent=""
                                                        OnContent=""
                                                        AutomationProperties.AutomationId="AutoClearCompletedOnExitToggleSwitch"
                                                        Toggled="SettingToggleSwitch_Toggled" />
                                                </StackPanel>
                                            </local:SettingCardControl.ActionContent>
                                        </local:SettingCardControl>

                                        <local:SettingCardControl
                                            x:Name="PauseActiveOnExitSettingCard"
                                            Margin="0,8,0,0"
                                            Description="退出前暂停正在传输的任务。"
                                            Header="退出时暂停下载"
                                            IconGlyph="&#xE769;">
                                            <local:SettingCardControl.ActionContent>
                                                <StackPanel
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="8">
                                                    <TextBlock
                                                        x:Name="PauseActiveOnExitStateText"
                                                        VerticalAlignment="Center"
                                                        Text="开" />
                                                    <ToggleSwitch
                                                        x:Name="PauseActiveOnExitToggleSwitch"
                                                        Width="48"
                                                        MinWidth="0"
                                                        Padding="0"
                                                        OffContent=""
                                                        OnContent=""
                                                        IsOn="True"
                                                        AutomationProperties.AutomationId="PauseActiveOnExitToggleSwitch"
                                                        Toggled="SettingToggleSwitch_Toggled" />
                                                </StackPanel>
                                            </local:SettingCardControl.ActionContent>
                                        </local:SettingCardControl>

                                        <local:SettingCardControl
                                            x:Name="CloseBehaviorSettingCard"
                                            Margin="0,8,0,0"
                                            Description="关闭窗口后继续后台运行。"
                                            Header="关闭到托盘"
                                            IconGlyph="&#xE7E8;">
                                            <local:SettingCardControl.ActionContent>
                                                <StackPanel
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="8">
                                                    <TextBlock
                                                        x:Name="CloseToTrayStateText"
                                                        VerticalAlignment="Center"
                                                        Text="关" />
                                                    <ToggleSwitch
                                                        x:Name="CloseToTrayToggleSwitch"
                                                        Width="48"
                                                        MinWidth="0"
                                                        Padding="0"
                                                        OffContent=""
                                                        OnContent=""
                                                        AutomationProperties.AutomationId="CloseToTrayToggleSwitch"
                                                        Toggled="SettingToggleSwitch_Toggled" />
                                                </StackPanel>
                                            </local:SettingCardControl.ActionContent>
                                        </local:SettingCardControl>

                                        <local:SettingCardControl
                                            x:Name="TaskbarProgressSettingCard"
                                            Margin="0,8,0,0"
                                            Description="显示整体下载进度。"
                                            Header="任务栏进度"
                                            IconGlyph="&#xE9D9;">
                                            <local:SettingCardControl.ActionContent>
                                                <StackPanel
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="8">
                                                    <TextBlock
                                                        x:Name="ShowTaskbarProgressStateText"
                                                        VerticalAlignment="Center"
                                                        Text="开" />
                                                    <ToggleSwitch
                                                        x:Name="ShowTaskbarProgressToggleSwitch"
                                                        Width="48"
                                                        MinWidth="0"
                                                        Padding="0"
                                                        OffContent=""
                                                        OnContent=""
                                                        IsOn="True"
                                                        AutomationProperties.AutomationId="ShowTaskbarProgressToggleSwitch"
                                                        Toggled="SettingToggleSwitch_Toggled" />
                                                </StackPanel>
                                            </local:SettingCardControl.ActionContent>
                                        </local:SettingCardControl>

                                        <TextBlock
                                            Margin="4,32,4,8"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="外观" />
                                        <local:SettingCardControl
                                            x:Name="ThemeSettingCard"
                                            Description="跟随 Windows 主题，或固定为浅色/深色。"
                                            Header="外观主题"
                                            IconGlyph="&#xE771;">
                                            <local:SettingCardControl.ActionContent>
                                                <ComboBox
                                                    x:Name="ThemeComboBox"
                                                    Width="160"
                                                    HorizontalAlignment="Right"
                                                    AutomationProperties.AutomationId="ThemeComboBox"
                                                    SelectionChanged="ThemeComboBox_SelectionChanged">
                                                    <ComboBoxItem Content="跟随系统" Tag="Default" />
                                                    <ComboBoxItem Content="浅色" Tag="Light" />
                                                    <ComboBoxItem Content="深色" Tag="Dark" />
                                                </ComboBox>
                                            </local:SettingCardControl.ActionContent>
                                        </local:SettingCardControl>

                                        <TextBlock
                                            Margin="4,32,4,8"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="通知" />
                                        <local:SettingCardControl
                                            x:Name="NotificationsSettingCard"
                                            Description="允许 OmniDown 通过 Windows 通知显示下载事件。"
                                            Header="启用系统通知"
                                            IconGlyph="&#xE7F4;">
                                            <local:SettingCardControl.ActionContent>
                                                <StackPanel
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="8">
                                                    <TextBlock
                                                        x:Name="SystemNotificationsStateText"
                                                        VerticalAlignment="Center"
                                                        Text="开" />
                                                    <ToggleSwitch
                                                        x:Name="SystemNotificationsToggleSwitch"
                                                        Width="48"
                                                        MinWidth="0"
                                                        Padding="0"
                                                        OffContent=""
                                                        OnContent=""
                                                        IsOn="True"
                                                        AutomationProperties.AutomationId="SystemNotificationsToggleSwitch"
                                                        Toggled="SettingToggleSwitch_Toggled" />
                                                </StackPanel>
                                            </local:SettingCardControl.ActionContent>
                                        </local:SettingCardControl>
                                        <local:SettingCardControl
                                            x:Name="DownloadStartNotificationSettingCard"
                                            Margin="0,8,0,0"
                                            Description="添加任务并开始交给 aria2 处理时显示通知。"
                                            Header="下载开始时通知"
                                            IconGlyph="&#xE768;">
                                            <local:SettingCardControl.ActionContent>
                                                <StackPanel
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="8">
                                                    <TextBlock
                                                        x:Name="DownloadStartNotificationsStateText"
                                                        VerticalAlignment="Center"
                                                        Text="关" />
                                                    <ToggleSwitch
                                                        x:Name="DownloadStartNotificationsToggleSwitch"
                                                        Width="48"
                                                        MinWidth="0"
                                                        Padding="0"
                                                        OffContent=""
                                                        OnContent=""
                                                        AutomationProperties.AutomationId="DownloadStartNotificationsToggleSwitch"
                                                        Toggled="SettingToggleSwitch_Toggled" />
                                                </StackPanel>
                                            </local:SettingCardControl.ActionContent>
                                        </local:SettingCardControl>
                                        <local:SettingCardControl
                                            x:Name="DownloadCompleteNotificationSettingCard"
                                            Margin="0,8,0,0"
                                            Description="任务完成或失败时显示通知。"
                                            Header="下载完成时通知"
                                            IconGlyph="&#xE930;">
                                            <local:SettingCardControl.ActionContent>
                                                <StackPanel
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="8">
                                                    <TextBlock
                                                        x:Name="DownloadCompleteNotificationsStateText"
                                                        VerticalAlignment="Center"
                                                        Text="开" />
                                                    <ToggleSwitch
                                                        x:Name="DownloadCompleteNotificationsToggleSwitch"
                                                        Width="48"
                                                        MinWidth="0"
                                                        Padding="0"
                                                        OffContent=""
                                                        OnContent=""
                                                        IsOn="True"
                                                        AutomationProperties.AutomationId="DownloadCompleteNotificationsToggleSwitch"
                                                        Toggled="SettingToggleSwitch_Toggled" />
                                                </StackPanel>
                                            </local:SettingCardControl.ActionContent>
                                        </local:SettingCardControl>

                                        <TextBlock
                                            Margin="4,32,4,8"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="下载" />
                                        <local:SettingCardControl
                                            x:Name="AutoShutdownSettingCard"
                                            Description="当前传输全部完成后执行 Windows 关机。"
                                            Header="所有下载完成后自动关机"
                                            IconGlyph="&#xE7E8;">
                                            <local:SettingCardControl.ActionContent>
                                                <StackPanel
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="8">
                                                    <TextBlock
                                                        x:Name="AutoShutdownWhenCompleteStateText"
                                                        VerticalAlignment="Center"
                                                        Text="关" />
                                                    <ToggleSwitch
                                                        x:Name="AutoShutdownWhenCompleteToggleSwitch"
                                                        Width="48"
                                                        MinWidth="0"
                                                        Padding="0"
                                                        OffContent=""
                                                        OnContent=""
                                                        AutomationProperties.AutomationId="AutoShutdownWhenCompleteToggleSwitch"
                                                        Toggled="SettingToggleSwitch_Toggled" />
                                                </StackPanel>
                                            </local:SettingCardControl.ActionContent>
                                        </local:SettingCardControl>
                                        <local:SettingCardControl
                                            x:Name="PreventSleepSettingCard"
                                            Margin="0,8,0,0"
                                            Description="有任务正在下载时保持系统唤醒，下载结束后自动恢复。"
                                            Header="下载时阻止系统休眠"
                                            IconGlyph="&#xE708;">
                                            <local:SettingCardControl.ActionContent>
                                                <StackPanel
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="8">
                                                    <TextBlock
                                                        x:Name="PreventSleepWhileDownloadingStateText"
                                                        VerticalAlignment="Center"
                                                        Text="关" />
                                                    <ToggleSwitch
                                                        x:Name="PreventSleepWhileDownloadingToggleSwitch"
                                                        Width="48"
                                                        MinWidth="0"
                                                        Padding="0"
                                                        OffContent=""
                                                        OnContent=""
                                                        AutomationProperties.AutomationId="PreventSleepWhileDownloadingToggleSwitch"
                                                        Toggled="SettingToggleSwitch_Toggled" />
                                                </StackPanel>
                                            </local:SettingCardControl.ActionContent>
                                        </local:SettingCardControl>
                                    </StackPanel>
</UserControl>
