<UserControl
    x:Class="OmniDown.Controls.SettingsPageControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OmniDown.Controls">
                    <Grid
                        x:Name="SettingsPageRoot"
                        RowDefinitions="*">
                        <Grid
                            ColumnDefinitions="220,*"
                            ColumnSpacing="24">
                            <ListView
                                x:Name="SettingsSectionListView"
                                Padding="0"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                SelectionChanged="SettingsSectionListView_SelectionChanged"
                                SelectionMode="Single">
                                <ListViewItem Tag="General">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <SymbolIcon Symbol="Setting" />
                                        <TextBlock Text="通用" />
                                    </StackPanel>
                                </ListViewItem>
                                <ListViewItem Tag="Download">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <SymbolIcon Symbol="Download" />
                                        <TextBlock Text="下载" />
                                    </StackPanel>
                                </ListViewItem>
                                <ListViewItem Tag="BitTorrent">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <FontIcon Glyph="&#xE968;" />
                                        <TextBlock Text="BitTorrent" />
                                    </StackPanel>
                                </ListViewItem>
                                <ListViewItem Tag="Network">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <FontIcon Glyph="&#xE774;" />
                                        <TextBlock Text="网络" />
                                    </StackPanel>
                                </ListViewItem>
                                <ListViewItem Tag="Advanced">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <FontIcon Glyph="&#xE713;" />
                                        <TextBlock Text="高级" />
                                    </StackPanel>
                                </ListViewItem>
                                <ListViewItem Tag="About">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <FontIcon Glyph="&#xE946;" />
                                        <TextBlock
                                            Text="About"
                                            x:Uid="AboutSettingsNavText" />
                                    </StackPanel>
                                </ListViewItem>
                            </ListView>

                            <ScrollViewer
                                x:Name="SettingsContentScrollViewer"
                                Grid.Column="1"
                                IsTabStop="True"
                                Padding="0,0,8,0"
                                HorizontalContentAlignment="Center"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <Grid
                                    Width="820"
                                    HorizontalAlignment="Center">
                                    <local:GeneralSettingsSectionControl x:Name="GeneralSettingsContent" />

                                    <StackPanel
                                        x:Name="DownloadSettingsContent"
                                        Spacing="0"
                                        Visibility="Collapsed">
                                        <TextBlock
                                            Margin="4,0,4,20"
                                            FontSize="28"
                                            FontWeight="SemiBold"
                                            Text="下载" />
                                        <TextBlock
                                            Margin="4,0,4,8"
                                            FontWeight="SemiBold"
                                            Text="任务默认值" />
                                        <Border
                                            x:Name="DefaultDirectorySettingCard"
                                            Padding="16"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8,8,0,0">
                                            <Grid ColumnDefinitions="Auto,*,300" ColumnSpacing="14">
                                                <FontIcon
                                                    Width="24"
                                                    VerticalAlignment="Center"
                                                    Glyph="&#xE8B7;" />
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Spacing="3">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        x:Uid="DefaultDirectoryLabel"
                                                        Text="Default directory" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="新建任务的默认保存位置。"
                                                        TextWrapping="WrapWholeWords" />
                                                </StackPanel>
                                                <Grid
                                                    Grid.Column="2"
                                                    Width="300"
                                                    Height="32"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    ColumnDefinitions="*,Auto"
                                                    ColumnSpacing="8">
                                                    <TextBox
                                                        x:Name="DownloadDirectoryTextBox"
                                                        Height="32"
                                                        VerticalAlignment="Center"
                                                        PlaceholderText="下载文件夹"
                                                        TextChanged="DownloadSettingTextBox_TextChanged" />
                                                    <Button
                                                        Grid.Column="1"
                                                        Width="40"
                                                        Height="32"
                                                        MinWidth="40"
                                                        Padding="0"
                                                        VerticalAlignment="Center"
                                                        Click="BrowseDownloadDirectoryButton_Click"
                                                        ToolTipService.ToolTip="选择文件夹">
                                                        <FontIcon Glyph="&#xE8B7;" />
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <Border
                                            x:Name="MaxConcurrentDownloadsSettingCard"
                                            Margin="0,-1,0,0"
                                            Padding="16"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                            <Grid ColumnDefinitions="Auto,*,220" ColumnSpacing="14">
                                                <FontIcon
                                                    Width="24"
                                                    VerticalAlignment="Center"
                                                    Glyph="&#xE8EF;" />
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Spacing="3">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Text="最大同时下载数" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="同时运行的任务上限。"
                                                        TextWrapping="WrapWholeWords" />
                                                </StackPanel>
                                                <NumberBox
                                                    x:Name="MaxConcurrentDownloadsNumberBox"
                                                    Grid.Column="2"
                                                    Width="180"
                                                    Height="32"
                                                    HorizontalAlignment="Right"
                                                    Minimum="1"
                                                    Maximum="10"
                                                    SmallChange="1"
                                                    SpinButtonPlacementMode="Inline"
                                                    Value="5"
                                                    ValueChanged="DownloadSettingNumberBox_ValueChanged" />
                                            </Grid>
                                        </Border>

                                        <Border
                                            x:Name="SplitCountSettingCard"
                                            Margin="0,-1,0,0"
                                            Padding="16"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="0">
                                            <Grid ColumnDefinitions="Auto,*,220" ColumnSpacing="14">
                                                <FontIcon
                                                    Width="24"
                                                    VerticalAlignment="Center"
                                                    Glyph="&#xE8FD;" />
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Spacing="3">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Text="默认分片数" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="单个任务的并行分片数。"
                                                        TextWrapping="WrapWholeWords" />
                                                </StackPanel>
                                                <NumberBox
                                                    x:Name="SplitCountNumberBox"
                                                    Grid.Column="2"
                                                    Width="180"
                                                    Height="32"
                                                    HorizontalAlignment="Right"
                                                    Minimum="1"
                                                    Maximum="256"
                                                    SmallChange="1"
                                                    SpinButtonPlacementMode="Inline"
                                                    Value="64"
                                                    ValueChanged="DownloadSettingNumberBox_ValueChanged" />
                                            </Grid>
                                        </Border>

                                        <Border
                                            x:Name="MaxConnectionPerServerSettingCard"
                                            Margin="0,-1,0,0"
                                            Padding="16"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="0,0,8,8">
                                            <Grid ColumnDefinitions="Auto,*,220" ColumnSpacing="14">
                                                <FontIcon
                                                    Width="24"
                                                    VerticalAlignment="Center"
                                                    Glyph="&#xE839;" />
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Spacing="3">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Text="单服务器最大连接数" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="同一服务器的连接上限，范围 1-16。"
                                                        TextWrapping="WrapWholeWords" />
                                                </StackPanel>
                                                <NumberBox
                                                    x:Name="MaxConnectionPerServerNumberBox"
                                                    Grid.Column="2"
                                                    Width="180"
                                                    Height="32"
                                                    HorizontalAlignment="Right"
                                                    Minimum="1"
                                                    Maximum="16"
                                                    SmallChange="1"
                                                    SpinButtonPlacementMode="Inline"
                                                    Value="16"
                                                    ValueChanged="DownloadSettingNumberBox_ValueChanged" />
                                            </Grid>
                                        </Border>

                                        <TextBlock
                                            Margin="4,32,4,8"
                                            FontWeight="SemiBold"
                                            Text="文件与重试" />
                                        <Border
                                            x:Name="ContinueDownloadSettingCard"
                                            Padding="16"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8,8,0,0">
                                            <Grid ColumnDefinitions="Auto,*,220" ColumnSpacing="14">
                                                <FontIcon
                                                    Width="24"
                                                    VerticalAlignment="Center"
                                                    Glyph="&#xE768;" />
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Spacing="3">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Text="断点续传" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="继续未完成的可恢复任务。"
                                                        TextWrapping="WrapWholeWords" />
                                                </StackPanel>
                                                <StackPanel
                                                    Grid.Column="2"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="8">
                                                    <TextBlock
                                                        x:Name="ContinueDownloadStateText"
                                                        VerticalAlignment="Center"
                                                        Text="开" />
                                                    <ToggleSwitch
                                                        x:Name="ContinueDownloadToggleSwitch"
                                                        Width="48"
                                                        MinWidth="0"
                                                        Padding="0"
                                                        OffContent=""
                                                        OnContent=""
                                                        IsOn="True"
                                                        Toggled="DownloadSettingToggleSwitch_Toggled" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border
                                            x:Name="RemoteTimeSettingCard"
                                            Margin="0,-1,0,0"
                                            Padding="16"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                            <Grid ColumnDefinitions="Auto,*,220" ColumnSpacing="14">
                                                <FontIcon
                                                    Width="24"
                                                    VerticalAlignment="Center"
                                                    Glyph="&#xE823;" />
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Spacing="3">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Text="文件时间戳" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="保存完成时间或服务器时间。"
                                                        TextWrapping="WrapWholeWords" />
                                                </StackPanel>
                                                <ComboBox
                                                    x:Name="RemoteTimeComboBox"
                                                    Grid.Column="2"
                                                    Width="180"
                                                    HorizontalAlignment="Right"
                                                    SelectionChanged="DownloadSettingComboBox_SelectionChanged">
                                                    <ComboBoxItem
                                                        Content="下载完成时间"
                                                        Tag="Download" />
                                                    <ComboBoxItem
                                                        Content="服务器时间"
                                                        Tag="Server" />
                                                </ComboBox>
                                            </Grid>
                                        </Border>

                                        <Border
                                            x:Name="MaxTriesSettingCard"
                                            Margin="0,-1,0,0"
                                            Padding="16"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                            <Grid ColumnDefinitions="Auto,*,220" ColumnSpacing="14">
                                                <FontIcon
                                                    Width="24"
                                                    VerticalAlignment="Center"
                                                    Glyph="&#xE8BB;" />
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Spacing="3">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Text="最大重试次数" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="0 表示不限次数。"
                                                        TextWrapping="WrapWholeWords" />
                                                </StackPanel>
                                                <NumberBox
                                                    x:Name="MaxTriesNumberBox"
                                                    Grid.Column="2"
                                                    Width="180"
                                                    Height="32"
                                                    HorizontalAlignment="Right"
                                                    Minimum="0"
                                                    Maximum="60"
                                                    SmallChange="1"
                                                    SpinButtonPlacementMode="Inline"
                                                    Value="0"
                                                    ValueChanged="DownloadSettingNumberBox_ValueChanged" />
                                            </Grid>
                                        </Border>

                                        <Border
                                            x:Name="RetryWaitSettingCard"
                                            Margin="0,-1,0,0"
                                            Padding="16"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="0,0,8,8">
                                            <Grid ColumnDefinitions="Auto,*,220" ColumnSpacing="14">
                                                <FontIcon
                                                    Width="24"
                                                    VerticalAlignment="Center"
                                                    Glyph="&#xE916;" />
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Spacing="3">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Text="重试等待时间" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="失败后再次尝试的间隔。"
                                                        TextWrapping="WrapWholeWords" />
                                                </StackPanel>
                                                <NumberBox
                                                    x:Name="RetryWaitNumberBox"
                                                    Grid.Column="2"
                                                    Width="180"
                                                    Height="32"
                                                    HorizontalAlignment="Right"
                                                    Minimum="0"
                                                    Maximum="600"
                                                    SmallChange="1"
                                                    SpinButtonPlacementMode="Inline"
                                                    Value="10"
                                                    ValueChanged="DownloadSettingNumberBox_ValueChanged" />
                                            </Grid>
                                        </Border>

                                        <TextBlock
                                            Margin="4,32,4,8"
                                            FontWeight="SemiBold"
                                            Text="自动清理" />
                                        <Border
                                            x:Name="DownloadCleanupSettingCard"
                                            Padding="16"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8,8,0,0">
                                            <Grid ColumnDefinitions="Auto,*,220" ColumnSpacing="14">
                                                <FontIcon
                                                    Width="24"
                                                    VerticalAlignment="Center"
                                                    Glyph="&#xE74D;" />
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Spacing="3">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Text="自动移除陈旧记录" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="清理已脱离 aria2 会话的记录。"
                                                        TextWrapping="WrapWholeWords" />
                                                </StackPanel>
                                                <StackPanel
                                                    Grid.Column="2"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="8">
                                                    <TextBlock
                                                        x:Name="AutoDeleteStaleRecordsStateText"
                                                        VerticalAlignment="Center"
                                                        Text="关" />
                                                    <ToggleSwitch
                                                        x:Name="AutoDeleteStaleRecordsToggleSwitch"
                                                        Width="48"
                                                        MinWidth="0"
                                                        Padding="0"
                                                        OffContent=""
                                                        OnContent=""
                                                        Toggled="DownloadSettingToggleSwitch_Toggled" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border
                                            x:Name="TorrentCleanupSettingCard"
                                            Margin="0,-1,0,0"
                                            Padding="16"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="0,0,8,8">
                                            <Grid ColumnDefinitions="Auto,*,220" ColumnSpacing="14">
                                                <FontIcon
                                                    Width="24"
                                                    VerticalAlignment="Center"
                                                    Glyph="&#xE9AC;" />
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Spacing="3">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Text="完成后删除 .torrent 源文件" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="仅删除本地种子源文件。"
                                                        TextWrapping="WrapWholeWords" />
                                                </StackPanel>
                                                <StackPanel
                                                    Grid.Column="2"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="8">
                                                    <TextBlock
                                                        x:Name="DeleteTorrentAfterCompleteStateText"
                                                        VerticalAlignment="Center"
                                                        Text="关" />
                                                    <ToggleSwitch
                                                        x:Name="DeleteTorrentAfterCompleteToggleSwitch"
                                                        Width="48"
                                                        MinWidth="0"
                                                        Padding="0"
                                                        OffContent=""
                                                        OnContent=""
                                                        Toggled="DownloadSettingToggleSwitch_Toggled" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel
                                        x:Name="BitTorrentSettingsContent"
                                        Spacing="0"
                                        Visibility="Collapsed">
                                        <TextBlock
                                            Margin="4,0,4,20"
                                            FontSize="28"
                                            FontWeight="SemiBold"
                                            Text="BitTorrent" />
                                        <TextBlock
                                            Margin="4,0,4,8"
                                            FontWeight="SemiBold"
                                            Text="基础选项" />
                                        <Border
                                            x:Name="BtAutoDownloadSettingCard"
                                            Padding="16"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8,8,0,0">
                                            <Grid ColumnDefinitions="Auto,*,220" ColumnSpacing="14">
                                                <FontIcon
                                                    Width="24"
                                                    VerticalAlignment="Center"
                                                    Glyph="&#xE896;" />
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Spacing="3">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Text="自动下载种子内容" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="添加 .torrent、metalink 或磁力链接后自动获取真实文件内容。"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="NoWrap" />
                                                </StackPanel>
                                                <StackPanel
                                                    Grid.Column="2"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="8">
                                                    <TextBlock
                                                        x:Name="BtAutoDownloadStateText"
                                                        VerticalAlignment="Center"
                                                        Text="开" />
                                                    <ToggleSwitch
                                                        x:Name="BtAutoDownloadToggleSwitch"
                                                        Width="48"
                                                        MinWidth="0"
                                                        Padding="0"
                                                        OffContent=""
                                                        OnContent=""
                                                        IsOn="True"
                                                        Toggled="BitTorrentSettingToggleSwitch_Toggled" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border
                                            x:Name="BtForceEncryptionSettingCard"
                                            Margin="0,-1,0,0"
                                            Padding="16"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="0">
                                            <Grid ColumnDefinitions="Auto,*,220" ColumnSpacing="14">
                                                <FontIcon
                                                    Width="24"
                                                    VerticalAlignment="Center"
                                                    Glyph="&#xE72E;" />
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Spacing="3">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Text="强制加密" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="要求 BitTorrent 消息负载加密，部分旧 Peer 可能无法连接。"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="NoWrap" />
                                                </StackPanel>
                                                <StackPanel
                                                    Grid.Column="2"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="8">
                                                    <TextBlock
                                                        x:Name="BtForceEncryptionStateText"
                                                        VerticalAlignment="Center"
                                                        Text="关" />
                                                    <ToggleSwitch
                                                        x:Name="BtForceEncryptionToggleSwitch"
                                                        Width="48"
                                                        MinWidth="0"
                                                        Padding="0"
                                                        OffContent=""
                                                        OnContent=""
                                                        Toggled="BitTorrentSettingToggleSwitch_Toggled" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border
                                            x:Name="BtKeepSeedingSettingCard"
                                            Margin="0,-1,0,0"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                            <StackPanel>
                                                <Button
                                                    Padding="0"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="ToggleBtSeedSettingsButton_Click">
                                                    <Grid
                                                        Padding="16"
                                                        ColumnDefinitions="Auto,*,Auto"
                                                        ColumnSpacing="14">
                                                        <FontIcon
                                                            Width="24"
                                                            VerticalAlignment="Center"
                                                            Glyph="&#xE8EE;" />
                                                        <StackPanel
                                                            Grid.Column="1"
                                                            Spacing="3">
                                                            <TextBlock
                                                                FontWeight="SemiBold"
                                                                Text="做种策略" />
                                                            <TextBlock
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Text="选择持续做种，或按分享率与时间自动停止。"
                                                                TextWrapping="WrapWholeWords" />
                                                        </StackPanel>
                                                        <FontIcon
                                                            x:Name="BtSeedChevronIcon"
                                                            Grid.Column="2"
                                                            Width="16"
                                                            VerticalAlignment="Center"
                                                            FontSize="12"
                                                            Glyph="&#xE70D;" />
                                                    </Grid>
                                                </Button>
                                                <Border
                                                    x:Name="BtSeedLimitsBox"
                                                    Padding="16,8,16,16"
                                                    Background="Transparent"
                                                    Opacity="0"
                                                    Visibility="Collapsed">
                                                    <Grid
                                                        ColumnDefinitions="24,*,260"
                                                        RowDefinitions="Auto,Auto,Auto"
                                                        ColumnSpacing="14"
                                                        RowSpacing="10">
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Text="做种方式" />
                                                        <TextBlock
                                                            Grid.Row="1"
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Text="分享率" />
                                                        <TextBlock
                                                            Grid.Row="2"
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Text="分享时间" />
                                                        <ComboBox
                                                            x:Name="BtSeedingModeComboBox"
                                                            Grid.Column="2"
                                                            Width="168"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            SelectionChanged="BitTorrentSettingComboBox_SelectionChanged">
                                                            <ComboBoxItem
                                                                Content="按条件停止"
                                                                Tag="Limited" />
                                                            <ComboBoxItem
                                                                Content="持续做种"
                                                                Tag="Always" />
                                                        </ComboBox>
                                                        <NumberBox
                                                            x:Name="BtSeedRatioNumberBox"
                                                            Grid.Row="1"
                                                            Grid.Column="2"
                                                            Width="168"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            Minimum="0"
                                                            Maximum="100"
                                                            SmallChange="0.1"
                                                            SpinButtonPlacementMode="Inline"
                                                            ValueChanged="BitTorrentSettingNumberBox_ValueChanged" />
                                                        <NumberBox
                                                            x:Name="BtSeedTimeNumberBox"
                                                            Grid.Row="2"
                                                            Grid.Column="2"
                                                            Width="168"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            Minimum="0"
                                                            Maximum="525600"
                                                            SmallChange="10"
                                                            SpinButtonPlacementMode="Inline"
                                                            ValueChanged="BitTorrentSettingNumberBox_ValueChanged" />
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>

