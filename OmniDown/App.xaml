<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="OmniDown.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OmniDown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <x:String x:Key="AppTitleName">OmniDown</x:String>
            <Style x:Key="DefaultContentDialogStyle" TargetType="ContentDialog" />
            <!-- Override InfoBar informational severity to be opaque (default is too transparent) -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="InfoBarInformationalSeverityBackgroundBrush" Color="#E6EFF7" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="InfoBarInformationalSeverityBackgroundBrush" Color="#1A2B3D" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
